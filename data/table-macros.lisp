(in-package #:aitools.data)

(defmacro define-data-table (name kind value &optional documentation)
  (labels ((proper-list-p (object)
             (loop for tail = object then (cdr tail)
                   while (consp tail)
                   finally (return (null tail))))
           (unique-p (sequence &key (test #'equal))
             (= (length sequence) (length (remove-duplicates sequence :test test))))
           (nonempty-string-p (item)
             (and (stringp item) (plusp (length item))))
           (unique-alphabet-p (item)
             (and (nonempty-string-p item)
                  (= (length item) (length (remove-duplicates item :test #'char=)))))
           (valid-table-p ()
             (case kind
               (:strings
                (and (proper-list-p value)
                     (every #'nonempty-string-p value)
                     (unique-p value :test #'string=)))
               (:alphabet
                (unique-alphabet-p value))
               (:string-pairs
                (and (proper-list-p value)
                     (every (lambda (entry)
                              (and (consp entry)
                                   (nonempty-string-p (car entry))
                                   (unique-alphabet-p (cdr entry))))
                            value)
                     (unique-p (mapcar #'car value) :test #'string=)))
               (:calc-functions
                (and (proper-list-p value)
                     (every (lambda (entry)
                              (and (proper-list-p entry)
                                   (= (length entry) 3)
                                   (nonempty-string-p (first entry))
                                   (or (eq (second entry) :variadic)
                                       (and (integerp (second entry))
                                            (plusp (second entry))))
                                   (or (and (symbolp (third entry))
                                            (eq (symbol-package (third entry)) (find-package :cl))
                                            (not (macro-function (third entry)))
                                            (not (special-operator-p (third entry)))
                                            (fboundp (third entry)))
                                       (eq (third entry) :round-half-away-from-zero))))
                            value)
                     (unique-p (mapcar #'first value) :test #'string=)))
               (otherwise nil))))
    (unless (and (symbolp name) (not (constantp name)))
      (error "Data table name must be a non-constant symbol: ~S." name))
    (unless (and (member kind '(:strings :alphabet :string-pairs :calc-functions))
                 (valid-table-p))
      (error "Invalid ~S data table ~S." kind name))
    (unless (or (null documentation) (stringp documentation))
      (error "Data table documentation must be a string: ~S." name))
    (if documentation
        `(defparameter ,name ',value ,documentation)
        `(defparameter ,name ',value))))

