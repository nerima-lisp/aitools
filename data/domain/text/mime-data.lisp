;;;; data/domain/text/mime-data.lisp
;;;;
;;;; MIME detection tables (the MIME magic-byte table as data). Magic
;;;; signatures are consulted first, in order; the extension table only
;;;; refines content that did not match any signature.
(in-package #:aitools.data)

(defparameter *text-mime-magic*
  '(("image/png" (0 #x89 #x50 #x4E #x47 #x0D #x0A #x1A #x0A))
    ("image/jpeg" (0 #xFF #xD8 #xFF))
    ("image/gif" (0 #x47 #x49 #x46 #x38 #x37 #x61))
    ("image/gif" (0 #x47 #x49 #x46 #x38 #x39 #x61))
    ("image/webp" (0 #x52 #x49 #x46 #x46) (8 #x57 #x45 #x42 #x50))
    ("audio/wav" (0 #x52 #x49 #x46 #x46) (8 #x57 #x41 #x56 #x45))
    ("image/bmp" (0 #x42 #x4D))
    ("image/x-icon" (0 #x00 #x00 #x01 #x00))
    ("image/tiff" (0 #x49 #x49 #x2A #x00))
    ("image/tiff" (0 #x4D #x4D #x00 #x2A))
    ("application/pdf" (0 #x25 #x50 #x44 #x46 #x2D))
    ("application/zip" (0 #x50 #x4B #x03 #x04))
    ("application/zip" (0 #x50 #x4B #x05 #x06))
    ("application/gzip" (0 #x1F #x8B))
    ("application/x-bzip2" (0 #x42 #x5A #x68))
    ("application/x-xz" (0 #xFD #x37 #x7A #x58 #x5A #x00))
    ("application/zstd" (0 #x28 #xB5 #x2F #xFD))
    ("application/x-7z-compressed" (0 #x37 #x7A #xBC #xAF #x27 #x1C))
    ("application/x-tar" (257 #x75 #x73 #x74 #x61 #x72))
    ("application/x-elf" (0 #x7F #x45 #x4C #x46))
    ("application/x-mach-binary" (0 #xCF #xFA #xED #xFE))
    ("application/x-mach-binary" (0 #xCE #xFA #xED #xFE))
    ("application/wasm" (0 #x00 #x61 #x73 #x6D))
    ("application/vnd.sqlite3" (0 #x53 #x51 #x4C #x69 #x74 #x65 #x20 #x66 #x6F #x72 #x6D #x61 #x74 #x20 #x33 #x00))
    ("audio/mpeg" (0 #x49 #x44 #x33))
    ("audio/ogg" (0 #x4F #x67 #x67 #x53))
    ("audio/flac" (0 #x66 #x4C #x61 #x43))
    ("video/mp4" (4 #x66 #x74 #x79 #x70))
    ("font/woff" (0 #x77 #x4F #x46 #x46))
    ("font/woff2" (0 #x77 #x4F #x46 #x32)))
  "Each element is (MIME-TYPE (OFFSET . OCTETS)...): every clause must match
for the signature to apply. The first matching signature wins.")

(defparameter *text-mime-extensions*
  '(("json" . "application/json")
    ("jsonl" . "application/jsonl")
    ("xml" . "application/xml")
    ("svg" . "image/svg+xml")
    ("html" . "text/html")
    ("htm" . "text/html")
    ("css" . "text/css")
    ("js" . "text/javascript")
    ("mjs" . "text/javascript")
    ("cjs" . "text/javascript")
    ("ts" . "text/x-typescript")
    ("tsx" . "text/x-typescript")
    ("md" . "text/markdown")
    ("markdown" . "text/markdown")
    ("csv" . "text/csv")
    ("tsv" . "text/tab-separated-values")
    ("yaml" . "application/yaml")
    ("yml" . "application/yaml")
    ("toml" . "application/toml")
    ("lisp" . "text/x-lisp")
    ("lsp" . "text/x-lisp")
    ("asd" . "text/x-lisp")
    ("el" . "text/x-emacs-lisp")
    ("scm" . "text/x-scheme")
    ("clj" . "text/x-clojure")
    ("py" . "text/x-python")
    ("rs" . "text/x-rust")
    ("go" . "text/x-go")
    ("nix" . "text/x-nix")
    ("sh" . "text/x-shellscript")
    ("bash" . "text/x-shellscript")
    ("c" . "text/x-c")
    ("h" . "text/x-c")
    ("txt" . "text/plain"))
  "File extension (lowercase, without the dot) to MIME type, applied only
to content that is not binary and matched no magic signature.")

(export '(*text-mime-magic* *text-mime-extensions*))
