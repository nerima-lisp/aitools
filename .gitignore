# nerima-lisp standard .gitignore
# Everything above the marker must stay identical across repos so that "is
# this artifact ignored?" has the same answer everywhere.

# --- Common Lisp build output ---
*.fasl
*.fas
*.lib
*.dfsl
*.ufsl
*.fsl

# --- Nix ---
/result
/result-*
/.direnv/

# --- Test and coverage output ---
/coverage/
/coverage-report/
/*-coverage-report/
*.coverage
coverage.dat
/__snapshots__/
/*-snapshots/

# --- Local caches and scratch space ---
/.cache/
/.deps/
/tmp/
/.worktrees/
/.paredit.cleanup/

# --- Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
/secrets/

# --- Editor and OS noise ---
.DS_Store
*~
\#*\#
.\#*

# --- Repository-specific entries below this line ---

# The built binary program-op produces at the repo root (aitools.asd's
# "aitools/cli" :build-pathname). Named, not just "/aitools*", so a future
# aitools.d/ or similarly-named source directory is never shadowed by this
# entry.
/aitools

# Serena's project state and memories. Ignored globally on the maintainer's
# machine, which is why it has never been committed; spelled out here so the
# same holds for a contributor without that global config, and for any
# `git add -A` in CI. The memories accumulate absolute paths.
/.serena/
