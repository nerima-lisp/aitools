(in-package #:aitools.kernel.domain)

(defvar *flow-signatures* (make-hash-table :test #'eq))

(defun %flow-variable-name-starts-with-on-p (variable)
  (and (symbolp variable)
       (let ((name (symbol-name variable)))
         (and (> (length name) 3)
              (string-equal "ON-" name :end2 3)))))

(defun %flow-parameter-variable (parameter)
  (if (symbolp parameter)
      parameter
      (when (consp parameter) (first parameter))))

(defun %flow-key-parameter (parameter)
  (let* ((key-and-variable (if (consp parameter) (first parameter) parameter))
         (variable (if (consp key-and-variable)
                       (second key-and-variable)
                       key-and-variable))
         (key (if (consp key-and-variable)
                  (first key-and-variable)
                  (when (symbolp variable)
                    (intern (symbol-name variable) :keyword)))))
    (values key variable)))

(defun %flow-continuations (lambda-list)
  (let ((section :required)
        (continuations '())
        (continuation-defaults '()))
    (dolist (parameter lambda-list)
      (cond
        ((eq parameter '&optional) (setf section :optional))
        ((eq parameter '&rest) (setf section :rest))
        ((eq parameter '&key) (setf section :key))
        ((eq parameter '&allow-other-keys)
         (unless (eq section :key)
           (error "&ALLOW-OTHER-KEYS requires &KEY in a flow lambda list.")))
        ((eq parameter '&aux) (setf section :aux))
        ((and (symbolp parameter)
              (> (length (symbol-name parameter)) 0)
              (char= (char (symbol-name parameter) 0) #\&))
         (error "Unsupported lambda-list keyword ~S in a flow." parameter))
        ((eq section :key)
         (multiple-value-bind (key variable) (%flow-key-parameter parameter)
           (let ((key-is-continuation (%flow-variable-name-starts-with-on-p key))
                 (variable-is-continuation (%flow-variable-name-starts-with-on-p variable)))
             (when (or key-is-continuation variable-is-continuation)
               (unless (and (keywordp key) key-is-continuation (symbolp variable))
                 (error "Flow continuations must use matching :ON-* keyword parameters: ~S."
                        parameter))
               (when (assoc key continuations :test #'eq)
                 (error "Duplicate flow continuation ~S." key))
               (push (cons key variable) continuations)
               (when (and (consp parameter) (consp (cdr parameter)))
                 (push (cons variable (second parameter)) continuation-defaults))))))
        ((member section '(:required :optional :rest :aux))
         (let ((variable (%flow-parameter-variable parameter)))
           (when (%flow-variable-name-starts-with-on-p variable)
             (error "Flow continuation ~S must be declared under &KEY." variable))
           (when (eq section :rest) (setf section :required))))
        (t nil)))
    (values (nreverse continuations) (nreverse continuation-defaults))))

(defun %register-flow-signature (name keys)
  (setf (gethash name *flow-signatures*) (copy-list keys)))

(defun %check-flow-continuations (continuations)
  (dolist (continuation continuations)
    (unless (functionp (cdr continuation))
      (error 'type-error :datum (cdr continuation) :expected-type 'function))))

(defmacro flow-continue (&rest arguments)
  (declare (ignore arguments))
  (error "FLOW-CONTINUE is valid only inside DEFINE-FLOW."))

(defmacro define-flow (lambda-list &body body)
  (unless (and (consp lambda-list) (symbolp (first lambda-list)))
    (error "DEFINE-FLOW requires a function name and lambda list: ~S." lambda-list))
  (let* ((name (first lambda-list))
         (function-lambda-list (rest lambda-list)))
    (multiple-value-bind (continuations continuation-defaults)
        (%flow-continuations function-lambda-list)
      (let* ((continuation-keys (mapcar #'car continuations))
             (docstring (when (stringp (first body)) (pop body)))
             (declarations (loop while (and (consp body)
                                            (consp (first body))
                                            (eq (caar body) 'declare))
                                 collect (pop body))))
        (%register-flow-signature name continuation-keys)
        `(progn
           (eval-when (:compile-toplevel :load-toplevel :execute)
             (%register-flow-signature ',name ',continuation-keys))
           (defun ,name ,function-lambda-list
             ,@(when docstring (list docstring))
             ,@declarations
             (let ,(mapcar (lambda (default)
                             `(,(car default) (or ,(car default) ,(cdr default))))
                           continuation-defaults)
               (%check-flow-continuations
                (list ,@(mapcar (lambda (continuation)
                                  `(cons ',(car continuation) ,(cdr continuation)))
                                continuations)))
               (macrolet
                   ((flow-continue (key &rest arguments)
                      (let ((variable (cdr (assoc key ',continuations :test #'eq))))
                        (unless variable
                          (error "Undeclared flow continuation ~S." key))
                        `(funcall ,variable ,@arguments))))
                 ,@body))))))))

(defmacro flow-call (call &body clauses)
  "Compile each callee with DEFINE-FLOW before compiling its caller with FLOW-CALL.
Forward references and mutual recursion are unsupported."
  (unless (and (consp call) (symbolp (first call)))
    (error "FLOW-CALL requires a statically named flow call: ~S." call))
  (let ((target (first call))
        (call-keys '()))
    (multiple-value-bind (target-keys found-p) (gethash (first call) *flow-signatures*)
      (unless found-p
        (error "FLOW-CALL target ~S has no known DEFINE-FLOW signature." (first call)))
      (dolist (clause clauses)
        (unless (and (consp clause) (keywordp (first clause))
                     (consp (rest clause)) (listp (second clause)))
          (error "Malformed FLOW-CALL continuation clause ~S." clause))
        (let ((key (first clause)))
          (when (member key call-keys :test #'eq)
            (error "Duplicate FLOW-CALL continuation clause ~S." key))
          (push key call-keys)))
      (setf call-keys (nreverse call-keys))
      (unless (and (= (length target-keys) (length call-keys))
                   (every (lambda (key) (member key call-keys :test #'eq)) target-keys))
        (error "FLOW-CALL keys ~S do not match ~S continuations ~S."
               call-keys target target-keys))
      `(,target ,@(rest call)
        ,@(loop for (key lambda-list . body) in clauses
                append (list key `(lambda ,lambda-list ,@body)))))))
