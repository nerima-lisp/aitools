(in-package #:aitools.org.infrastructure)

(defun %org-priority-edit (engine options delete-p)
  (multiple-value-bind (heading at context failure) (%org-selected-heading engine options)
    (declare (ignore at context))
    (when failure (return-from %org-priority-edit (values nil nil failure)))
    (handler-case
        (values (org-kit:set-heading-priority engine heading
                                             (unless delete-p (getf options :priority)))
                nil nil)
      (org-kit:org-edit-error (condition)
        (values nil nil (%org-edit-condition-failure condition)))
      (org-kit:org-resource-limit-error ()
        (values nil nil (%failure :too-large "priority edit exceeded a resource limit")))
      (org-kit:org-kit-error ()
        (values nil nil (%failure :internal "priority edit failed"))))))

(defun %org-checkbox-edit (engine options)
  (multiple-value-bind (heading at context failure) (%org-selected-heading engine options)
    (declare (ignore at context))
    (when failure (return-from %org-checkbox-edit (values nil nil failure)))
    (let ((items nil))
      (labels ((visit (node)
                 (unless (eq (org-kit:node-type node) :headline)
                   (when (and (eq (org-kit:node-type node) :item)
                              (member (org-kit:node-property node :checkbox) '(:on :off :trans)))
                     (push node items))
                   (dolist (child (org-kit:node-children node)) (visit child))))
               (child-boxes (node)
                 (labels ((visit-child (child)
                            (if (eq (org-kit:node-type child) :item)
                                (let ((box (org-kit:node-property child :checkbox)))
                                  (when (member box '(:on :off :trans)) (list box)))
                                (mapcan #'visit-child (org-kit:node-children child)))))
                   (mapcan #'visit-child (org-kit:node-children node))))
               (find-node (document type position)
                 (let ((found nil))
                   (org-kit:map-nodes
                    (lambda (node)
                      (when (and (eq (org-kit:node-type node) type)
                                 (= (org-kit:node-begin node) position))
                        (setf found node)))
                    (org-kit:document-root document))
                   found))
               (set-box (document node box)
                 (org-kit:set-checkbox-state document node
                                             (ecase box
                                               (:on :checked)
                                               (:off :unchecked)
                                               (:trans :partial)))))
        (dolist (child (org-kit:node-children heading)) (visit child))
        (let ((item (nth (1- (getf options :item)) (nreverse items))))
          (unless item
            (return-from %org-checkbox-edit
              (values nil nil (%org-selection-failure :selection-no-match "checkbox number is out of range"))))
          (handler-case
              (let* ((heading-position (org-kit:node-begin heading))
                     (positions
                       (cons (org-kit:node-begin item)
                             (loop for node = (org-kit:node-parent item) then (org-kit:node-parent node)
                                   while (and node (not (eq node heading)))
                                   when (eq (org-kit:node-type node) :item)
                                     collect (org-kit:node-begin node))))
                     (state (if (eq (org-kit:node-property item :checkbox) :on) :off :on))
                     (updated (set-box engine item state)))
                (dolist (position positions)
                  (let* ((parent (find-node updated :item position))
                         (current (org-kit:node-property parent :checkbox))
                         (boxes (child-boxes parent))
                         (next (cond ((member :trans boxes) :trans)
                                     ((and (member :on boxes) (member :off boxes)) :trans)
                                     ((member :on boxes) :on)
                                     ((member :off boxes) :off))))
                    (when (and next (member current '(:on :off :trans))
                               (not (eq current next)))
                      (setf updated (set-box updated parent next)))))
                (values (org-kit:edit-result-updated-document
                         (org-kit:update-statistics-cookies
                          updated (find-node updated :headline heading-position)))
                        (list (cons "item" (getf options :item))) nil))
            (org-kit:org-edit-error (condition)
              (values nil nil (%org-edit-condition-failure condition)))
            (org-kit:org-resource-limit-error ()
              (values nil nil (%failure :too-large "checkbox edit exceeded a resource limit")))
            (org-kit:org-kit-error ()
              (values nil nil (%failure :internal "checkbox edit failed")))))))))

(defun %org-title-edit (engine options)
  (multiple-value-bind (heading at context failure) (%org-selected-heading engine options)
    (declare (ignore at context))
    (when failure (return-from %org-title-edit (values nil nil failure)))
    (labels ((cookies (node)
               (let ((found nil))
                 (dolist (segment (org-kit:node-property node :title))
                   (when (org-kit:node-p segment)
                     (org-kit:map-nodes
                      (lambda (child)
                        (when (eq (org-kit:node-type child) :statistics-cookie)
                          (push (org-kit:node-property child :value) found)))
                      segment)))
                 (nreverse found)))
             (heading-at (document position)
               (let ((found nil))
                 (org-kit:map-nodes
                  (lambda (node)
                    (when (and (eq (org-kit:node-type node) :headline)
                               (= (org-kit:node-begin node) position))
                      (setf found node)))
                  (org-kit:document-root document))
                 found)))
      (handler-case
          (let* ((title (getf options :title))
                 (old-cookies (cookies heading))
                 (updated (org-kit:replace-heading-title engine heading title))
                 (new-heading (heading-at updated (org-kit:node-begin heading))))
            (values (if (and old-cookies (null (cookies new-heading)))
                        (org-kit:replace-heading-title
                         engine heading (format nil "~A~{ ~A~}" title old-cookies))
                        updated)
                    nil nil))
        (org-kit:org-edit-error (condition)
          (values nil nil (%org-edit-condition-failure condition)))
        (org-kit:org-resource-limit-error ()
          (values nil nil (%failure :too-large "title edit exceeded a resource limit")))
        (org-kit:org-kit-error ()
          (values nil nil (%failure :internal "title edit failed")))))))

(defun %org-tags-edit (engine options operation)
  (multiple-value-bind (heading at context failure) (%org-selected-heading engine options)
    (declare (ignore at context))
    (when failure (return-from %org-tags-edit (values nil nil failure)))
    (let ((tags (getf options :tags)))
      (setf tags (if (string= tags "") nil (uiop:split-string tags :separator '(#\,))))
      (handler-case
          (values (ecase operation
                    (:tags-add (org-kit:add-heading-tags engine heading tags))
                    (:tags-remove (org-kit:remove-heading-tags engine heading tags))
                    (:tags-replace (org-kit:replace-heading-tags engine heading tags)))
                  nil nil)
        (org-kit:org-edit-error (condition)
          (values nil nil (%org-edit-condition-failure condition)))
        (org-kit:org-resource-limit-error ()
          (values nil nil (%failure :too-large "tag edit exceeded a resource limit")))
        (org-kit:org-kit-error ()
          (values nil nil (%failure :internal "tag edit failed")))))))
