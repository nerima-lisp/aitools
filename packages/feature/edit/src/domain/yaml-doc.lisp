;;;; YAML write validation for JSON values and number representability.
(in-package #:aitools.edit.domain)

(defun edit-json-number (value)
  (let ((text (json-num-text value)))
    (labels ((mantissa-nonzero-p ()
               (loop for character across text
                     until (find character "eE")
                     thereis (find character "123456789"))))
      (handler-case
          (let ((*read-eval* nil)
                (*read-default-float-format* 'double-float))
            (multiple-value-bind (number end)
                (read-from-string text nil nil)
              (unless (and (numberp number) (= end (length text)))
                (refuse "argument.invalid" "JSON number cannot be represented."))
              (when (and (floatp number)
                         (zerop number)
                         (mantissa-nonzero-p))
                (refuse "argument.invalid" "JSON number cannot be represented."))
              (when (and (floatp number)
                         (or (sb-ext:float-infinity-p number)
                             (sb-ext:float-nan-p number)))
                (refuse "argument.invalid" "JSON number cannot be represented."))
              number))
        (reader-error ()
          (refuse "argument.invalid" "JSON number cannot be represented."))
        (arithmetic-error ()
          (refuse "argument.invalid" "JSON number cannot be represented."))))))

(defun validate-yaml-write-value (value)
  (labels ((validate (item)
             (cond
               ((json-num-p item) (edit-json-number item))
               ((json-obj-p item)
                (dolist (member (json-obj-members item))
                  (validate (cdr member))))
               ((and (vectorp item) (not (stringp item)))
                (loop for child across item do (validate child))))))
    (validate value))
  value)
