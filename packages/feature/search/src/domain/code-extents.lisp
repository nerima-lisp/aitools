(in-package #:aitools.search.domain)

(defun %skip-quoted-literal (octets start quote escapes-p newline-ends-p
                             &optional line-comment block-comment language)
  (let ((i (1+ start)) (length (length octets)))
    (loop while (< i length)
          do (let ((byte (aref octets i)))
               (cond
                 ((and escapes-p (= byte 92)) (incf i 2))
                 ((and (= quote 96) line-comment block-comment language
                       (= byte 36) (< (1+ i) length)
                       (= (aref octets (1+ i)) 123))
                  (setf i (1+ (%brace-end octets (1+ i) line-comment
                                         block-comment language))))
                 ((= byte quote) (return-from %skip-quoted-literal i))
                 ((and newline-ends-p (= byte 10))
                  (return-from %skip-quoted-literal i))
                 (t (incf i)))))
    (max start (1- length))))

(defun %rust-unicode-escape-end (octets position)
  (let* ((length (length octets))
         (brace (1+ position)))
    (when (and (< brace length) (= (aref octets brace) 123))
      (let ((close (position 125 octets :start (1+ brace))))
        (and close (1+ close))))))

(defun %rust-raw-string-end (octets start)
  (let* ((length (length octets))
         (prefix start))
    (when (and (= (aref octets start) 98)
               (< (1+ start) length)
               (= (aref octets (1+ start)) 114))
      (incf prefix))
    (unless (and (< prefix length) (= (aref octets prefix) 114))
      (return-from %rust-raw-string-end nil))
    (incf prefix)
    (let ((hashes 0))
      (loop while (and (< prefix length) (= (aref octets prefix) 35))
            do (incf hashes)
               (incf prefix))
      (unless (and (< prefix length) (= (aref octets prefix) 34))
        (return-from %rust-raw-string-end nil))
      (loop for quote from (1+ prefix) below length
            when (= (aref octets quote) 34)
              do (let ((after (1+ quote)))
                   (loop repeat hashes
                         while (and (< after length) (= (aref octets after) 35))
                         do (incf after))
                   (when (= (- after (1+ quote)) hashes)
                     (return-from %rust-raw-string-end (1- after))))
            finally (return (1- length))))))

(defun %rust-char-escape-end (octets position)
  (let ((length (length octets)))
    (cond
      ((>= position length) position)
      ((= (aref octets position) 117)
       (or (%rust-unicode-escape-end octets position) position))
      ((= (aref octets position) 120) (+ position 3))
      (t (1+ position)))))

(defun %rust-char-literal-end (octets start)
  (let ((i (1+ start)) (length (length octets)))
    (when (< i length)
      (cond
        ((= (aref octets i) 92)
         (setf i (%rust-char-escape-end octets (1+ i))))
        ((= (aref octets i) 10)
         (return-from %rust-char-literal-end nil))
        (t (setf i (next-char-boundary octets i))))
    (and (< i length) (= (aref octets i) 39) i))))

(defun %brace-end (octets start line-comment block-comment language)
  "Offset ending a brace-delimited definition that starts at START: its
closing brace, or a semicolon or line end before any opening brace."
  (let* ((length (length octets))
         (javascript-p (or (string-equal language "javascript")
                           (string-equal language "typescript")))
         (go-p (string-equal language "go"))
         (rust-p (string-equal language "rust"))
         (shell-p (string-equal language "shell"))
         (nix-p (string-equal language "nix"))
         (depth 0) (brackets 0) (opened nil) (i start))
    (labels ((nix-indented-string-end (position)
               (let ((i (+ position 2)))
                 (block nix-indented-string-end
                   (loop while (< i length)
                         do (cond
                              ((%starts-with-p octets i "'''") (incf i 3))
                              ((and (%starts-with-p octets i "''$")
                                    (< (+ i 3) length)
                                    (= (aref octets (+ i 3)) 123))
                               (incf i 4))
                              ((and (%starts-with-p octets i "''")
                                    (< (+ i 2) length)
                                    (= (aref octets (+ i 2)) 92))
                               (incf i 3))
                              ((%starts-with-p octets i "''")
                               (return-from nix-indented-string-end (1+ i)))
                              (t (incf i))))
                   (1- length)))))
      (loop while (< i length)
            do (let* ((byte (aref octets i))
                    (raw-end (and rust-p (member byte '(98 114))
                                  (%rust-raw-string-end octets i)))
                    (char-end (and rust-p (= byte 39)
                                   (%rust-char-literal-end octets i))))
                 (cond
                   ((= byte 34)
                    (setf i (%skip-quoted-literal octets i 34 t t)))
                   ((and javascript-p (= byte 39))
                    (setf i (%skip-quoted-literal octets i 39 t t)))
                   ((and javascript-p (= byte 96))
                    (setf i (%skip-quoted-literal octets i 96 t nil
                                           line-comment block-comment language)))
                   ((and shell-p (= byte 39))
                    (setf i (%skip-quoted-literal octets i 39 nil nil)))
                   ((and nix-p (= byte 39) (%starts-with-p octets i "''"))
                    (setf i (nix-indented-string-end i)))
                   (raw-end (setf i raw-end))
                   (char-end (setf i char-end))
                   ((and go-p (= byte 39))
                    (setf i (%skip-quoted-literal octets i 39 t t)))
                   ((and go-p (= byte 96))
                    (setf i (%skip-quoted-literal octets i 96 nil nil)))
                   ((%starts-with-p octets i line-comment)
                    (setf i (1- (next-line-start octets i))))
                   ((%starts-with-p octets i (first block-comment))
                    (setf i (%block-comment-end octets i block-comment rust-p)))
                   ((= byte 123) (setf opened t) (incf depth))
                   ((= byte 125)
                    (decf depth)
                    (when (and opened (<= depth 0)) (return-from %brace-end i)))
                   ((member byte '(40 91)) (incf brackets))
                   ((member byte '(41 93)) (decf brackets))
                   ((and (not opened) (= byte 59) (<= brackets 0))
                    (return-from %brace-end i))
                   ((and (not opened) (= byte 10) (<= brackets 0))
                    (let ((next (loop for pos = (1+ i) then (next-line-start octets pos)
                                      while (< pos length)
                                      unless (%blank-line-p octets pos (line-content-end octets pos))
                                        return (%first-content-byte octets pos (line-content-end octets pos)))))
                      (unless (eql next 123) (return-from %brace-end (max start (1- i))))))))
              (incf i))
      (max start (1- length)))))

(defun %indentation (octets start end)
  (loop for i from start below end
        while (member (aref octets i) '(32 9))
        count t))

(defun %indent-end-line (octets line line-start)
  "The last non-blank line of the block that LINE (starting at LINE-START)
opens: lines after it until one indented no deeper than LINE."
  (let ((indent (%indentation octets line-start (line-content-end octets line-start)))
        (last line) (number line) (pos (next-line-start octets line-start)) (length (length octets)))
    (loop while (< pos length)
          do (incf number)
             (let ((end (line-content-end octets pos)))
               (unless (%blank-line-p octets pos end)
                 (when (<= (%indentation octets pos end) indent) (return))
                 (setf last number))
               (setf pos (next-line-start octets pos))))
    last))

(defun %fence-lines (octets)
  "Line numbers inside Markdown fenced code blocks (``` or ~~~), fences
included: headings there are not headings."
  (let* ((lines (make-hash-table))
         (opening nil)
         (number 0)
         (pos 0)
         (length (length octets)))
    (loop while (< pos length)
          do (incf number)
             (let* ((end (line-content-end octets pos))
                    (indent (loop for i from pos below end while (= (aref octets i) 32) count t))
                    (content (+ pos indent))
                    (marker (and (< content end) (aref octets content)))
                    (marker-p (member marker '(96 126)))
                    (run (and marker-p
                              (loop for i from content below end
                                    while (= (aref octets i) marker)
                                    count t)))
                    (fence-p (and run (>= run 3) (<= indent 3)
                                  (or (/= marker 96)
                                      (loop for i from (+ content run) below end
                                            never (= (aref octets i) 96)))))
                    (closing-p
                      (and opening fence-p
                           (= marker (car opening))
                           (>= run (cdr opening))
                           (loop for i from (+ content run) below end
                                 always (member (aref octets i) '(32 9))))))
               (when (or opening fence-p)
                 (setf (gethash number lines) t))
               (cond
                 (opening (when closing-p (setf opening nil)))
                 (fence-p (setf opening (cons marker run))))
               (setf pos (next-line-start octets pos))))
    lines))
