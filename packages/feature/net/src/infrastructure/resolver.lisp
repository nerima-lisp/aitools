(in-package #:aitools.net.infrastructure)
#+sbcl
(eval-when (:compile-toplevel :load-toplevel :execute)
  (require :sb-bsd-sockets))
(defparameter +default-resolver-timeout-seconds+ 30d0)
(defun %monotonic-seconds ()
  (/ (get-internal-real-time) internal-time-units-per-second))
(defun %finite-real-p (value)
  (and (realp value)
       (handler-case
           (and (> value most-negative-double-float)
                (< value most-positive-double-float))
         (floating-point-invalid-operation () nil))))
(defun %ascii-digit-p (character)
  (let ((code (char-code character)))
    (<= 48 code 57)))
(defun %ascii-letter-p (character)
  (let ((code (char-code character)))
    (or (<= 65 code 90)
        (<= 97 code 122))))
(defun %valid-ipv4-part-p (part)
  (and (plusp (length part))
       (or (= (length part) 1)
           (/= (char-code (char part 0)) 48))
       (every #'%ascii-digit-p part)
       (<= 0 (parse-integer part) 255)))
(defun %valid-ipv4-host-p (host)
  (let ((start 0)
        (parts nil)
        (host-length (length host)))
    (loop for dot = (position (code-char 46) host :start start)
          for end = (or dot host-length)
          do (push (subseq host start end) parts)
          (if dot
              (setf start (1+ dot))
            (return)))
    (and (= (length parts) 4)
         (every #'%valid-ipv4-part-p (nreverse parts)))))
(defun %valid-dns-label-p (label)
  (and (<= 1 (length label) 63)
       (/= (char-code (char label 0)) 45)
       (/= (char-code (char label (1- (length label)))) 45)
       (every (lambda (character)
                (or (%ascii-letter-p character)
                    (%ascii-digit-p character)
                    (= (char-code character) 45)))
              label)))
(defun %valid-dns-host-p (host)
  (let* ((host-length (length host))
         (name-length (if (= (char-code (char host (1- host-length))) 46)
                          (1- host-length)
                        host-length)))
    (and (<= name-length 253)
         (plusp name-length)
         (loop with start = 0
               for dot = (position (code-char 46) host :start start :end name-length)
               for end = (or dot name-length)
               always (%valid-dns-label-p (subseq host start end))
               while dot
               do (setf start (1+ dot))))))
(defun %valid-ipv6-host-p (host)
  (and (find (code-char 58) host)
       (every (lambda (character)
                (let ((code (char-code character)))
                  (or (%ascii-digit-p character)
                      (<= 65 code 70)
                      (<= 97 code 102)
                      (= code 58)
                      (= code 46))))
              host)
       (handler-case
           (progn (sb-bsd-sockets:make-inet6-address host) t)
         (error () nil))))
(defun %valid-host-p (host)
  (and (stringp host)
       (<= 1 (length host) 253)
       (if (find (code-char 58) host)
           (%valid-ipv6-host-p host)
         (if (every (lambda (character)
                      (or (%ascii-digit-p character)
                          (= (char-code character) 46)))
                    host)
             (%valid-ipv4-host-p host)
           (%valid-dns-host-p host)))))
(defun %resolver-deadline (timeout deadline clock-function)
  (unless (and (or (null timeout)
                   (and (%finite-real-p timeout) (> timeout 0)))
               (or (null deadline) (%finite-real-p deadline)))
    (%raise-net-error "argument.invalid" "Resolver time values must be finite and positive."))
  (let ((now (funcall clock-function)))
    (unless (%finite-real-p now)
      (%raise-net-error "environment.io" "The monotonic clock is unavailable."))
    (or deadline
        (+ now (or timeout +default-resolver-timeout-seconds+)))))
(defun %default-os-lookup (host)
  (loop for host-ent in (multiple-value-list
                         (sb-bsd-sockets:get-host-by-name host))
        for family in '(:inet :inet6)
        when host-ent
        append (mapcar (lambda (octets) (cons family octets))
                       (sb-bsd-sockets:host-ent-addresses host-ent))))
(defun %lookup-result (lookup-function host)
  (handler-case
      (funcall lookup-function host)
    (sb-bsd-sockets:name-service-error (condition)
                                       (if (typep condition 'sb-bsd-sockets::host-not-found-error)
                                           nil
                                         (%raise-net-error "environment.io" "The operating system resolver failed.")))
    (net-error (condition)
               (error condition))
    (error ()
           (%raise-net-error "environment.io" "The operating system resolver failed."))))
#+sb-thread
(progn
  ;; A timed-out getaddrinfo call cannot be interrupted, so cap abandoned workers.
  (defparameter *resolver-worker-semaphore*
    (sb-thread:make-semaphore :count 1))
  (defun %timed-lookup (lookup-function host deadline clock-function thread-function)
    (let ((remaining (- deadline (funcall clock-function))))
      (when (<= remaining 0)
        (%raise-net-error "environment.timeout" "Name resolution exceeded its deadline."))
      (unless (sb-thread:wait-on-semaphore *resolver-worker-semaphore* :timeout remaining)
        (%raise-net-error "environment.timeout" "Name resolution exceeded its deadline."))
      (let ((thread nil)
            (worker-started-p nil))
        (unwind-protect
             (progn
               (when (<= (- deadline (funcall clock-function)) 0)
                 (%raise-net-error "environment.timeout" "Name resolution exceeded its deadline."))
               (setf thread
                     (handler-case
                         (funcall thread-function
                                  (lambda ()
                                    (unwind-protect
                                         (handler-case
                                             (list :ok (%lookup-result lookup-function host))
                                           (error (condition) (list :error condition)))
                                      (sb-thread:signal-semaphore *resolver-worker-semaphore*)))
                                  :name "aitools OS resolver")
                       (error ()
                         (%raise-net-error "environment.unavailable" "A resolver worker thread is unavailable."))))
               (setf worker-started-p t))
          (unless worker-started-p
            (sb-thread:signal-semaphore *resolver-worker-semaphore*)))
        (let ((remaining-after-start (- deadline (funcall clock-function))))
          (when (<= remaining-after-start 0)
            (%raise-net-error "environment.timeout" "Name resolution exceeded its deadline."))
          (let ((outcome
                  (sb-thread:join-thread thread
                                         :timeout remaining-after-start
                                         :default :timed-out)))
            (when (eq outcome :timed-out)
              (%raise-net-error "environment.timeout" "Name resolution exceeded its deadline."))
            (when (>= (funcall clock-function) deadline)
              (%raise-net-error "environment.timeout" "Name resolution exceeded its deadline."))
            (if (eq (first outcome) :ok)
                (second outcome)
                (error (second outcome)))))))))
#-sb-thread
  (defun %timed-lookup (lookup-function host deadline clock-function thread-function)
    (declare (ignore lookup-function host deadline clock-function thread-function))
    (%raise-net-error "environment.unavailable" "Resolver worker threads are unavailable."))
(defun %address-type-and-size (family)
  (case family
    (:inet (values "A" 4))
    (:inet6 (values "AAAA" 16))
    (otherwise
     (%raise-net-error "environment.io" "The resolver returned an unsupported address family."))))
(defun %format-address (family octets)
  (case family
    (:inet
     (format nil "~D.~D.~D.~D"
             (aref octets 0) (aref octets 1)
             (aref octets 2) (aref octets 3)))
    (:inet6
     (format nil "~(~{~X~^:~}~)"
             (loop for index from 0 below 16 by 2
                   collect (+ (ash (aref octets index) 8)
                              (aref octets (1+ index))))))))
(defun %net-address (family octets)
  (multiple-value-bind (type expected-size)
      (%address-type-and-size family)
    (unless (and (vectorp octets)
                 (= (length octets) expected-size)
                 (every (lambda (octet)
                          (and (integerp octet) (<= 0 octet 255)))
                        octets))
      (%raise-net-error "environment.io" "The resolver returned an invalid address."))
    (let ((copy (copy-seq octets)))
      (make-net-address :type type
                        :value (%format-address family copy)
                        :family family
                        :octets copy))))
(defun %same-net-address-p (left right)
  (and (eq (aitools.net.domain:net-address-family left)
           (aitools.net.domain:net-address-family right))
       (equalp (aitools.net.domain:net-address-octets left)
               (aitools.net.domain:net-address-octets right))))
(defun %net-addresses (entries)
  (unless (listp entries)
    (%raise-net-error "environment.io" "The resolver returned an invalid address list."))
  (remove-duplicates
   (mapcar (lambda (entry)
             (unless (consp entry)
               (%raise-net-error "environment.io" "The resolver returned an invalid address."))
             (%net-address (car entry) (cdr entry)))
           entries)
   :test (function %same-net-address-p)
   :from-end t))
(defun make-os-resolver (&key lookup-function clock-function #+sb-thread thread-function)
  (let* ((lookup-function (or lookup-function (function %default-os-lookup)))
         (clock-function (or clock-function (function %monotonic-seconds)))
         #+sb-thread
         (thread-function (or thread-function (function sb-thread:make-thread))))
    (unless (and (functionp lookup-function)
                 (functionp clock-function)
                 #+sb-thread (functionp thread-function))
      (%raise-net-error "argument.invalid" "Resolver dependencies must be functions."))
    (lambda (host &key timeout deadline)
      (unless (%valid-host-p host)
        (%raise-net-error "argument.invalid" "The host must be a valid DNS name or numeric address."))
      (let ((deadline (%resolver-deadline timeout deadline clock-function)))
        (%net-addresses
         (%timed-lookup lookup-function host deadline clock-function
                        #+sb-thread thread-function #-sb-thread nil))))))