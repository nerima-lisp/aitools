(in-package #:aitools/test)

(defun %registered-test-contexts ()
  (loop for name in (uiop:symbol-call :asdf-user :%registered-aitools-test-systems)
        unless (string= name "aitools/test/base")
          collect (intern (string-upcase (subseq name (length "aitools/test/"))) :keyword)))

(defun %test-system-owner (system)
  (let ((context-prefix "aitools/test/"))
    (intern (string-upcase
             (subseq system (if (uiop:string-prefix-p context-prefix system)
                                (length context-prefix)
                              (length "aitools/"))))
            :keyword)))

(defun %registered-test-source-index ()
  (let ((root (merge-pathnames "t/" (asdf:system-source-directory "aitools/test/base"))))
    (%make-test-context-source-index
     (loop for (path . system) in (%test-file-registrations)
           collect (cons (%test-system-owner system)
                         (namestring (truename (merge-pathnames path root))))))))

(defun %selected-test-system-owners (context)
  (let ((owners nil))
    (labels ((visit (system)
               (let ((owner (%test-system-owner system)))
                 (unless (member owner owners)
                   (push owner owners)
                   (dolist (dependency (asdf:system-depends-on (asdf:find-system system)))
                     (when (and (stringp dependency)
                                (or (uiop:string-prefix-p "aitools/test/" dependency)
                                    (uiop:string-prefix-p "aitools/test-support/" dependency)))
                       (visit dependency)))))))
      (visit (format nil "aitools/test/~A" context)))
    owners))

(defun %snapshot-specs ()
  (let ((root (cl-weave::snapshot-suite cl-weave::*root-suite*)))
    (labels ((walk (suite)
               (loop for child in (cl-weave::suite-children suite)
                     if (cl-weave::suite-p child) append (walk child)
                     else if (cl-weave::test-case-p child)
                       collect (cons (getf (cl-weave::test-case-location child) :file)
                                     (cl-weave::test-path suite child)))))
      (when root (walk root)))))

(defun %host-policy-acceptable-p (events)
  (and (plusp (length events))
       (every (lambda (event)
                (let ((status (%event-field event "status")))
                  (or (string= status "pass")
                      (and (string= status "skip")
                           (eq :host (seventh (%allowed-unrun-p event)))))))
              events)))

(defun %spec-key (file path)
  (and (stringp file) (%test-source-path-key file)
       (consp path) (every #'stringp path)
       (cons (%test-source-path-key file) path)))

(defun %event-spec-key (event)
  (let ((location (%event-field event "location"))
        (path (%event-field event "path")))
    (%spec-key (and (hash-table-p location) (%event-field location "file"))
               (and (vectorp path) (coerce path 'list)))))

(defun %policy-problems (events snapshot &optional context source-index)
  (let* ((pending (make-hash-table :test (function equal)))
         (files (make-hash-table :test (function equal)))
         (counts (make-hash-table :test (function equal)))
         (index (or source-index (%registered-test-source-index)))
         (selected (and context (%selected-test-system-owners context)))
         (problems nil)
         (executed 0))
    (labels ((in-scope-p (file)
               (let ((owner (and (stringp file) (%test-context-from-source-file file index))))
                 (or (null selected) (null owner) (member owner selected)))))
      (setf snapshot (remove-if-not (lambda (entry) (in-scope-p (car entry))) snapshot)
            events (remove-if-not
                    (lambda (event)
                      (let ((location (%event-field event "location")))
                        (in-scope-p (and (hash-table-p location)
                                         (%event-field location "file")))))
                    events)))
    (dolist (entry snapshot)
      (when (car entry)
        (let* ((file (car entry))
               (key (%spec-key file (cdr entry)))
               (owner (and (stringp file) (%test-context-from-source-file file index))))
          (if (and key owner)
              (progn (incf (gethash key pending 0))
                     (push key (gethash (car key) files)))
            (push (format nil "registered spec ~S has no matching test source file ~S"
                          (cdr entry) file) problems)))))
    (unless snapshot (push "No registered specs were found" problems))
    (dolist (event events)
      (let* ((status (%event-field event "status"))
             (location (%event-field event "location"))
             (file (and (hash-table-p location) (%event-field location "file")))
             (key (%event-spec-key event))
             (available (and key (gethash key pending 0))))
        (when (member status (list "skip" "todo") :test (function string=))
          (unless (%allowed-unrun-p event)
            (push (format nil "~A was not run (~A: ~A) and is not in *ALLOWED-UNRUN-SPECS*"
                          (%event-field event "pathString") status
                          (%event-field event "reason")) problems)))
        (cond ((not (member status (list "pass" "fail" "error" "skip" "todo") :test (function string=)))
               (push (format nil "spec event ~A has invalid status ~S"
                             (%event-field event "pathString") status) problems))
              ((null file) nil)
              ((or (null available) (zerop available))
               (push (format nil "spec event ~A has no matching registration"
                             (%event-field event "pathString")) problems))
              (t
               (decf (gethash key pending))
               (when (member status (list "pass" "fail" "error") :test (function string=))
                 (incf executed)
                 (incf (gethash (car key) counts 0)))))))
    (maphash
     (lambda (file keys)
       (when (zerop (gethash file counts 0))
         (unless (every (lambda (key) (zerop (gethash key pending 0))) keys)
           (push (format nil "test file ~A has no executed spec or allowed skip for every spec"
                         file) problems))))
     files)
    (let ((context-counts
            (unless context
              (loop for owner in (%registered-test-contexts)
                    collect (cons owner 0)))))
      (when context-counts
        (dolist (event events)
          (when (member (%event-field event "status") (list "pass" "fail" "error") :test (function string=))
            (let* ((location (%event-field event "location"))
                   (file (and (hash-table-p location) (%event-field location "file")))
                   (owner (and (stringp file) (%test-context-from-source-file file index)))
                   (entry (assoc owner context-counts)))
              (when entry (incf (cdr entry)))))))
      (values (nreverse problems) executed context-counts))))
