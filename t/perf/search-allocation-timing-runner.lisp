(let* ((spawn-start nil)
       (startup-seconds nil)
       (measurement-seconds nil)
       (spawn-count 0)
       (ready-count 0)
       (communicate-count 0)
       (spawn-symbol 'process-kit:spawn)
       (wait-symbol (find-symbol "%WAIT-FOR-ALLOCATION-CHILD-READY"
                                 :aitools.search.test))
       (original-spawn (symbol-function spawn-symbol))
       (original-wait (symbol-function wait-symbol))
       (original-communicate (symbol-function 'process-kit:communicate)))
  (setf (symbol-function spawn-symbol)
        (lambda (&rest arguments)
          (incf spawn-count)
          (setf spawn-start (get-internal-real-time))
          (apply original-spawn arguments)))
  (setf (symbol-function wait-symbol)
        (lambda (&rest arguments)
          (multiple-value-prog1
              (apply original-wait arguments)
            (unless (numberp spawn-start)
              (error "READY was reached without a recorded child spawn."))
            (incf ready-count)
            (setf startup-seconds
                  (/ (- (get-internal-real-time) spawn-start)
                     (float internal-time-units-per-second 1d0))))))
  (setf (symbol-function 'process-kit:communicate)
        (lambda (&rest arguments)
          (let ((started (get-internal-real-time)))
            (multiple-value-prog1
                (apply original-communicate arguments)
              (incf communicate-count)
              (setf measurement-seconds
                    (/ (- (get-internal-real-time) started)
                       (float internal-time-units-per-second 1d0)))))))
  (let* ((filter "allocation for non-matching lines")
         (json (make-string-output-stream))
         (events
           (uiop:symbol-call :cl-weave :run nil
                             :name-filter filter :reporter :json :stream json))
         (report
           (uiop:symbol-call :json-kit :parse (get-output-stream-string json)))
         (reported-events (gethash "events" report))
         (passed (gethash "passed" report))
         (skipped (gethash "skipped" report))
         (todos (gethash "todos" report))
         (failed (gethash "failed" report))
         (errored (gethash "errored" report)))
    (format t "SOURCE=workspace~%")
    (format t "CACHE_STATE=~A~%" (uiop:getenv "AITOOLS_ALLOCATION_CACHE_STATE"))
    (format t "FILTER=~A~%" filter)
    (format t "SELECTED=~D REPORTED=~D PASSED=~D SKIPPED=~D TODOS=~D FAILED=~D ERRORED=~D~%"
            (length events) (length reported-events) passed skipped todos failed errored)
    (format t "CHILD_SPAWNS=~D READY_PHASES=~D MEASUREMENT_PHASES=~D~%"
            spawn-count ready-count communicate-count)
    (format t "STARTUP_SECONDS=~S~%" startup-seconds)
    (format t "MEASUREMENT_SECONDS=~S~%" measurement-seconds)
    (unless (and (= (length events) 7)
                 (= (length reported-events) 7)
                 (= passed 7)
                 (zerop skipped) (zerop todos) (zerop failed) (zerop errored)
                 (= spawn-count 1) (= ready-count 1) (= communicate-count 1)
                 (numberp startup-seconds) (numberp measurement-seconds)
                 (uiop:symbol-call :cl-weave :results-status events))
      (uiop:quit 1))))
