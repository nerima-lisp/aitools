;;;; YAML write command flows and warning fields.
(in-package #:aitools.edit.test)

(defun expect-yaml-comment-warning (fields count)
  (let ((warnings (field fields "warnings")))
    (expect (vectorp warnings) :to-be t)
    (expect (length warnings) :to-be (if (plusp count) 1 0))
    (when (plusp count)
      (let ((warning (aref warnings 0)))
        (expect (json-field warning "code") :to-equal "format.comments-dropped")
        (expect (json-field warning "message") :to-equal
                "Comments were dropped when the document was rewritten.")
        (expect (json-field warning "count") :to-be count)))))

(describe "aitools.edit YAML write flows"
  (it "applies all five JSON operations, supports stdin sets, and always returns warnings"
    (with-edit-workspace ()
      (put "doc.yaml" (format nil "# input~%a: 1~%b: 2~%"))
      (multiple-value-bind (status fields)
          (run "yaml.set" (list "doc.yaml" "/a" "3"))
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 1))
      (multiple-value-bind (status fields)
          (run "yaml.delete" (list "doc.yaml" "/b"))
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 0))
      (multiple-value-bind (status fields)
          (run "yaml.merge" (list "doc.yaml") :stdin-data "{\"c\":4}")
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 0))
      (multiple-value-bind (status fields)
          (run "yaml.patch" (list "doc.yaml")
               :stdin-data "[{\"op\":\"replace\",\"path\":\"/c\",\"value\":5}]")
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 0))
      (put "fmt.yaml" (format nil "# keep count~%x: 1~%"))
      (multiple-value-bind (status fields)
          (run "yaml.fmt" (list "fmt.yaml") :dry-run t)
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 1)
        (expect (text "fmt.yaml") :to-equal (format nil "# keep count~%x: 1~%")))
      (multiple-value-bind (status fields)
          (run "yaml.fmt" (list "fmt.yaml"))
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 1))
      (multiple-value-bind (status fields)
          (run "yaml.fmt" (list "fmt.yaml"))
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 0)
        (expect (changes fields) :to-equal (list)))
      (put "nested.yaml" (format nil "key: old~%"))
      (multiple-value-bind (status fields)
          (run "yaml.set" (list "nested.yaml")
               :stdin-data "{\"pointer\":\"/profile\",\"value\":{\"label\":\"text\",\"enabled\":false,\"missing\":null,\"items\":[1,true]}}"
               :expect-hash (list (hash "nested.yaml")))
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 0))
      (let* ((value (aitools.inspect.domain:parse-yaml-document (text "nested.yaml")))
             (profile (aitools.inspect.domain:json-object-get value "profile"))
             (items (aitools.inspect.domain:json-object-get profile "items")))
        (expect (aitools.inspect.domain:json-object-get profile "label") :to-equal "text")
        (expect (aitools.inspect.domain:json-false-value-p
                 (aitools.inspect.domain:json-object-get profile "enabled"))
                :to-be t)
        (expect (aitools.inspect.domain:json-null-value-p
                 (aitools.inspect.domain:json-object-get profile "missing"))
                :to-be t)
        (expect (length items) :to-be 2)
        (expect (aref items 0) :to-be 1)
        (expect (aref items 1) :to-be t))))
  (it "rejects nonzero mantissa underflow and accepts exponent-form zero"
    (with-edit-workspace ()
      (put "doc.yaml" (format nil "a: 1~%"))
      (multiple-value-bind (status fields)
          (run "yaml.set" '("doc.yaml" "/a" "0e-9999"))
        (expect status :to-be :ok)
        (expect-yaml-comment-warning fields 0))
      (multiple-value-bind (status code message keys)
          (run "yaml.set" '("doc.yaml" "/a" "1e-9999"))
        (declare (ignore message keys))
        (expect status :to-be :error)
        (expect code :to-equal "argument.invalid"))))
  (it "adds a final LF when serialization omits it"
    (let ((document
            (aitools.edit.application::%format-document
             "yaml" nil nil 0
             (lambda (format value)
               (declare (ignore format value))
               "document"))))
      (expect (doc-string document) :to-equal (format nil "document~%"))))
  (it "rejects unsupported serializer formats"
    (signals error
      (aitools.edit.infrastructure::serialize-document "other" nil)))

  (it "rejects invalid source documents and carries format repairs"
    (with-edit-workspace ()
      (put "bad-tag.yaml" (format nil "keep: !custom value~%target: 2~%"))
      (multiple-value-bind (status code message keys)
          (run "yaml.delete" (list "bad-tag.yaml" "/target"))
        (declare (ignore message))
        (expect status :to-be :error)
        (expect code :to-equal "input.unsupported-value")
        (expect (plusp (length (getf keys :repairs))) :to-be t))
      (put "bad-format.yaml" (format nil "value: [~%"))
      (multiple-value-bind (status code message keys)
          (run "yaml.fmt" (list "bad-format.yaml"))
        (declare (ignore message))
        (expect status :to-be :error)
        (expect code :to-equal "input.syntax-error")
        (expect (plusp (length (getf keys :repairs))) :to-be t))
      (put "missing-member.yaml" (format nil "present: true~%"))
      (multiple-value-bind (status code message keys)
          (run "yaml.delete" (list "missing-member.yaml" "/missing"))
        (declare (ignore message))
        (expect status :to-be :error)
        (expect code :to-equal "input.not-found")
        (expect (plusp (length (getf keys :repairs))) :to-be t))
      (put "failed-patch.yaml" (format nil "value: 1~%"))
      (multiple-value-bind (status code message keys)
          (run "yaml.patch" (list "failed-patch.yaml")
               :stdin-data "[{\"op\":\"test\",\"path\":\"/value\",\"value\":2}]")
        (declare (ignore message))
        (expect status :to-be :error)
        (expect code :to-equal "selection.no-match")
        (expect (plusp (length (getf keys :repairs))) :to-be t))
      (multiple-value-bind (status code message keys)
          (run "yaml.fmt" (list "absent.yaml"))
        (declare (ignore message keys))
        (expect status :to-be :error)
        (expect code :to-equal "input.not-found")))))

(describe "aitools.edit YAML write argument errors"
  (it "rejects invalid arguments before reading or changing a file"
    (with-edit-workspace ()
      (put "doc.yaml" (format nil "keep: 1~%"))
      (let ((reads 0)
            (before (snapshot))
            (read-file
              (symbol-function 'aitools.store.application:view-read-file)))
        (cl-weave:with-mocked-functions
            (((symbol-function 'aitools.store.application:view-read-file)
              (lambda (view path &rest arguments)
                (when (string= path "doc.yaml")
                  (incf reads))
                (apply read-file view path arguments))))
          (labels ((expect-error (expected-code command positionals &rest options)
                     (multiple-value-bind (status code message keys)
                         (apply (function run) command positionals options)
                       (declare (ignore message keys))
                       (expect status :to-be :error)
                       (expect code :to-equal expected-code))))
            (expect-error "argument.invalid" "yaml.set" nil)
            (expect-error "argument.invalid" "yaml.set" (list "doc.yaml" "/x")
                          :stdin-data "{\"pointer\":\"/x\",\"value\":1}")
            (expect-error "argument.invalid" "yaml.set" (list "doc.yaml")
                          :stdin-data "{\"pointer\":\"/x\"}")
            (expect-error "argument.invalid" "yaml.set" (list "doc.yaml")
                          :stdin-data "{\"pointer\":1,\"value\":1}")
            (expect-error "argument.invalid" "yaml.set" (list "doc.yaml" "/x"))
            (expect-error "argument.invalid" "yaml.set" (list "doc.yaml" "/x~2" "1"))
            (expect-error "argument.invalid" "yaml.set" (list "doc.yaml" "/x" "bare"))
            (expect-error "argument.invalid" "yaml.delete" (list "doc.yaml"))
            (expect-error "argument.invalid" "yaml.delete" (list "doc.yaml" "/x~2"))
            (expect-error "argument.invalid" "yaml.merge" (list "doc.yaml"))
            (expect-error "input.syntax-error" "yaml.merge" (list "doc.yaml") :stdin-data "{")
            (expect-error "argument.invalid" "yaml.patch" (list "doc.yaml" "extra")
                          :stdin-data "[]")
            (expect-error "argument.invalid" "yaml.patch" (list "doc.yaml"))
            (expect-error "argument.invalid" "yaml.fmt" nil)
            (expect reads :to-be 0)
            (expect (snapshot) :to-equal before)))))))
(describe "aitools.edit YAML write input limits"
  (it "accepts a document at the byte limit and rejects one byte over"
    (with-edit-workspace ()
      (let* ((limit aitools.edit.application::+max-format-document-bytes+)
             (tail (format nil "keep: 1~%")))
        (labels ((document-of (size)
                   (concatenate 'string
                                "#"
                                (make-string (- size 2 (length tail))
                                             :initial-element #\x)
                                (format nil "~%")
                                tail)))
          (put "at-limit.yaml" (document-of limit))
          (expect (length (octets-of "at-limit.yaml")) :to-be limit)
          (multiple-value-bind (status fields)
              (run "yaml.fmt" (list "at-limit.yaml") :dry-run t)
            (declare (ignore fields))
            (expect status :to-be :ok))
          (put "over-limit.yaml" (document-of (1+ limit)))
          (expect (length (octets-of "over-limit.yaml")) :to-be (1+ limit))
          (multiple-value-bind (status code message keys)
              (run "yaml.fmt" (list "over-limit.yaml") :dry-run t)
            (declare (ignore message keys))
            (expect status :to-be :error)
            (expect code :to-equal "refusal.too-large"))))))
  (it "accepts the nesting limit and rejects one extra collection"
    (with-edit-workspace ()
      (let ((limit aitools.edit.application::+max-format-document-depth+))
        (labels ((document-of (depth)
                   (concatenate 'string
                                (make-string depth :initial-element #\[)
                                "0"
                                (make-string depth :initial-element #\])
                                (format nil "~%"))))
          (put "at-depth.yaml" (document-of limit))
          (multiple-value-bind (status fields)
              (run "yaml.fmt" (list "at-depth.yaml") :dry-run t)
            (declare (ignore fields))
            (expect status :to-be :ok))
          (put "over-depth.yaml" (document-of (1+ limit)))
          (multiple-value-bind (status code message keys)
              (run "yaml.fmt" (list "over-depth.yaml") :dry-run t)
            (declare (ignore message keys))
            (expect status :to-be :error)
            (expect code :to-equal "input.syntax-error")))))))
(describe "aitools.edit YAML write byte-limit errors"
  (it "does not infer byte-limit errors from their wording"
    (with-edit-workspace ()
      (put "doc.yaml" (format nil "keep: 1~%"))
      (let ((read-file
              (symbol-function 'aitools.store.application:view-read-file)))
        (cl-weave:with-mocked-functions
            (((symbol-function 'aitools.store.application:view-read-file)
              (lambda (view path &rest arguments)
                (if (string= path "doc.yaml")
                    (error 'aitools.store.application:store-io-error
                           :operation "read"
                           :path path
                           :detail "file exceeds byte limit")
                    (apply read-file view path arguments)))))
          (multiple-value-bind (status code message keys)
              (run "yaml.fmt" (list "doc.yaml") :dry-run t)
            (declare (ignore message keys))
            (expect status :to-be :error)
            (expect code :to-equal "environment.io")))))))
