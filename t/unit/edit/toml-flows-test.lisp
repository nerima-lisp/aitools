;;;; TOML write command flows, validation, and warning fields.
(in-package #:aitools.edit.test)

(defun expect-toml-comment-warning (fields count)
  (let ((warnings (field fields "warnings")))
    (expect (vectorp warnings) :to-be t)
    (expect (length warnings) :to-be (if (plusp count) 1 0))
    (when (plusp count)
      (let ((warning (aref warnings 0)))
        (expect (json-field warning "code") :to-equal "format.comments-dropped")
        (expect (json-field warning "message") :to-equal
                "Comments were dropped when the document was rewritten.")
        (expect (json-field warning "count") :to-be count)))))

(describe "aitools.edit TOML write flows"
  (it "applies all five JSON operations, supports stdin sets, and always returns warnings"
    (with-edit-workspace ()
      (put "doc.toml" (format nil "# input~%a = 1~%b = 2~%"))
      (multiple-value-bind (status fields)
          (run "toml.set" (list "doc.toml" "/a" "3"))
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 1))
      (multiple-value-bind (status fields)
          (run "toml.delete" (list "doc.toml" "/b"))
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0))
      (multiple-value-bind (status fields)
          (run "toml.merge" (list "doc.toml") :stdin-data "{\"c\":4}")
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0))
      (multiple-value-bind (status fields)
          (run "toml.patch" (list "doc.toml")
               :stdin-data "[{\"op\":\"replace\",\"path\":\"/c\",\"value\":5}]")
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0))
      (put "fmt.toml" (format nil "# keep count~%x = 1~%"))
      (multiple-value-bind (status fields)
          (run "toml.fmt" (list "fmt.toml") :dry-run t)
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 1)
        (expect (text "fmt.toml") :to-equal (format nil "# keep count~%x = 1~%")))
      (multiple-value-bind (status fields)
          (run "toml.fmt" (list "fmt.toml"))
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 1))
      (multiple-value-bind (status fields)
          (run "toml.fmt" (list "fmt.toml"))
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0)
        (expect (changes fields) :to-equal (list)))
      (put "nested.toml" (format nil "key = \"old\"~%"))
      (multiple-value-bind (status fields)
          (run "toml.set" (list "nested.toml")
               :stdin-data "{\"pointer\":\"/profile\",\"value\":{\"label\":\"text\",\"enabled\":false,\"items\":[1,true]}}"
               :expect-hash (list (hash "nested.toml")))
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0))
      (let* ((value (aitools.inspect.domain:parse-toml-document (text "nested.toml")))
             (profile (aitools.inspect.domain:json-object-get value "profile"))
             (items (aitools.inspect.domain:json-object-get profile "items")))
        (expect (aitools.inspect.domain:json-object-get profile "label") :to-equal "text")
        (expect (aitools.inspect.domain:json-false-value-p
                 (aitools.inspect.domain:json-object-get profile "enabled"))
                :to-be t)
        (expect (length items) :to-be 2)
        (expect (aref items 0) :to-be 1)
        (expect (aref items 1) :to-be t))))
  (it "rejects nonzero mantissa underflow and accepts exponent-form zero"
    (with-edit-workspace ()
      (put "doc.toml" (format nil "a = 1~%"))
      (multiple-value-bind (status fields)
          (run "toml.set" '("doc.toml" "/a" "0e-9999"))
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0))
      (multiple-value-bind (status code message keys)
          (run "toml.set" '("doc.toml" "/a" "1e-9999"))
        (declare (ignore message keys))
        (expect status :to-be :error)
        (expect code :to-equal "argument.invalid"))))
  (it "formats an empty TOML document with a final LF"
    (with-edit-workspace ()
      (put "empty.toml" "")
      (multiple-value-bind (status fields)
          (run "toml.fmt" (list "empty.toml"))
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0)
        (expect (text "empty.toml") :to-equal (format nil "~%")))
      (multiple-value-bind (status fields)
          (run "toml.fmt" (list "empty.toml"))
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0)
        (expect (changes fields) :to-equal (list)))))

  (it "allows null merge deletion and rejects invalid source documents"
    (with-edit-workspace ()
      (put "doc.toml" (format nil "a = 1~%b = 2~%"))
      (multiple-value-bind (status fields)
          (run "toml.merge" (list "doc.toml") :stdin-data "{\"a\":null}")
        (expect status :to-be :ok)
        (expect-toml-comment-warning fields 0))
      (multiple-value-bind (status code message keys)
          (run "toml.set" (list "doc.toml" "/b" "null"))
        (declare (ignore message keys))
        (expect status :to-be :error)
        (expect code :to-equal "input.unsupported-value"))
      (multiple-value-bind (status code message keys)
          (run "toml.set" (list "doc.toml" "/b" "9223372036854775808"))
        (declare (ignore message keys))
        (expect status :to-be :error)
        (expect code :to-equal "argument.invalid"))
      (put "bad-format.toml" (format nil "value = [~%"))
      (multiple-value-bind (status code message keys)
          (run "toml.fmt" (list "bad-format.toml"))
        (declare (ignore message))
        (expect status :to-be :error)
        (expect code :to-equal "input.syntax-error")
        (expect (plusp (length (getf keys :repairs))) :to-be t))
      (put "missing-member.toml" (format nil "present = true~%"))
      (multiple-value-bind (status code message keys)
          (run "toml.delete" (list "missing-member.toml" "/missing"))
        (declare (ignore message))
        (expect status :to-be :error)
        (expect code :to-equal "input.not-found")
        (expect (plusp (length (getf keys :repairs))) :to-be t))
      (put "failed-patch.toml" (format nil "value = 1~%"))
      (multiple-value-bind (status code message keys)
          (run "toml.patch" (list "failed-patch.toml")
               :stdin-data "[{\"op\":\"test\",\"path\":\"/value\",\"value\":2}]")
        (declare (ignore message))
        (expect status :to-be :error)
        (expect code :to-equal "selection.no-match")
        (expect (plusp (length (getf keys :repairs))) :to-be t))
      (multiple-value-bind (status code message keys)
          (run "toml.fmt" (list "absent.toml"))
        (declare (ignore message keys))
        (expect status :to-be :error)
        (expect code :to-equal "input.not-found")))))

(describe "aitools.edit TOML write argument errors"
  (it "rejects invalid arguments before reading or changing a file"
    (with-edit-workspace ()
      (put "doc.toml" (format nil "keep = 1~%"))
      (let ((reads 0)
            (before (snapshot))
            (read-file
              (symbol-function 'aitools.store.application:view-read-file)))
        (cl-weave:with-mocked-functions
            (((symbol-function 'aitools.store.application:view-read-file)
              (lambda (view path &rest arguments)
                (when (string= path "doc.toml")
                  (incf reads))
                (apply read-file view path arguments))))
          (labels ((expect-error (expected-code command positionals &rest options)
                     (multiple-value-bind (status code message keys)
                         (apply (function run) command positionals options)
                       (declare (ignore message keys))
                       (expect status :to-be :error)
                       (expect code :to-equal expected-code))))
            (expect-error "argument.invalid" "toml.set" nil)
            (expect-error "argument.invalid" "toml.set" (list "doc.toml" "/x")
                          :stdin-data "{\"pointer\":\"/x\",\"value\":1}")
            (expect-error "argument.invalid" "toml.set" (list "doc.toml")
                          :stdin-data "{\"pointer\":\"/x\"}")
            (expect-error "argument.invalid" "toml.set" (list "doc.toml")
                          :stdin-data "{\"pointer\":1,\"value\":1}")
            (expect-error "argument.invalid" "toml.set" (list "doc.toml" "/x"))
            (expect-error "argument.invalid" "toml.set" (list "doc.toml" "/x~2" "1"))
            (expect-error "argument.invalid" "toml.set" (list "doc.toml" "/x" "bare"))
            (expect-error "argument.invalid" "toml.delete" (list "doc.toml"))
            (expect-error "argument.invalid" "toml.delete" (list "doc.toml" "/x~2"))
            (expect-error "argument.invalid" "toml.merge" (list "doc.toml"))
            (expect-error "input.syntax-error" "toml.merge" (list "doc.toml") :stdin-data "{")
            (expect-error "argument.invalid" "toml.patch" (list "doc.toml" "extra")
                          :stdin-data "[]")
            (expect-error "argument.invalid" "toml.patch" (list "doc.toml"))
            (expect-error "argument.invalid" "toml.fmt" nil)
            (expect reads :to-be 0)
            (expect (snapshot) :to-equal before)))))))
(describe "aitools.edit TOML write input limits"
  (it "accepts a document at the byte limit and rejects one byte over"
    (with-edit-workspace ()
      (let* ((limit aitools.edit.application::+max-format-document-bytes+)
             (tail (format nil "keep = 1~%")))
        (labels ((document-of (size)
                   (concatenate 'string
                                "#"
                                (make-string (- size 2 (length tail))
                                             :initial-element #\x)
                                (format nil "~%")
                                tail)))
          (put "at-limit.toml" (document-of limit))
          (expect (length (octets-of "at-limit.toml")) :to-be limit)
          (multiple-value-bind (status fields)
              (run "toml.fmt" (list "at-limit.toml") :dry-run t)
            (declare (ignore fields))
            (expect status :to-be :ok))
          (put "over-limit.toml" (document-of (1+ limit)))
          (expect (length (octets-of "over-limit.toml")) :to-be (1+ limit))
          (multiple-value-bind (status code message keys)
              (run "toml.fmt" (list "over-limit.toml") :dry-run t)
            (declare (ignore message keys))
            (expect status :to-be :error)
            (expect code :to-equal "refusal.too-large"))))))
  (it "accepts the nesting limit and rejects one extra collection"
    (with-edit-workspace ()
      (let ((limit aitools.edit.application::+max-format-document-depth+))
        (labels ((document-of (depth)
                   (concatenate 'string
                                "items = "
                                (make-string depth :initial-element #\[)
                                "0"
                                (make-string depth :initial-element #\])
                                (format nil "~%"))))
          (put "at-depth.toml" (document-of (1- limit)))
          (multiple-value-bind (status fields)
              (run "toml.fmt" (list "at-depth.toml") :dry-run t)
            (declare (ignore fields))
            (expect status :to-be :ok))
          (put "over-depth.toml" (document-of limit))
          (multiple-value-bind (status code message keys)
              (run "toml.fmt" (list "over-depth.toml") :dry-run t)
            (declare (ignore message keys))
            (expect status :to-be :error)
            (expect code :to-equal "input.syntax-error")))))))
