(in-package #:aitools.protocol.test)

(describe "aitools.protocol.domain error-catalog"
  (it-each (("argument.invalid" 1)
            ("input.not-found" 1)
            ("input.not-utf8" 1)
            ("input.unsupported-format" 1)
            ("input.unsupported-language" 1)
            ("input.syntax-error" 1)
            ("input.unsupported-value" 1)
            ("selection.no-match" 2)
            ("selection.ambiguous" 2)
            ("selection.count-mismatch" 2)
            ("refusal.target-changed" 2)
            ("refusal.redacted-input" 1)
            ("refusal.outside-workspace" 1)
            ("refusal.exists" 1)
            ("refusal.not-a-file" 1)
            ("refusal.too-large" 1)
            ("environment.io" 1)
            ("environment.busy" 1)
            ("environment.timeout" 1)
            ("environment.unavailable" 1)
            ("internal.unexpected" 1))
    "maps ~S to exit code ~D"
    (code exit-code)
    (let ((entry (find code *protocol-error-codes*
                       :key (lambda (item) (getf item :code))
                       :test #'string=)))
      (expect (getf entry :exit-code) :to-be exit-code)
      (expect (error-code-exit-code code) :to-be exit-code)))

  (it "keeps the complete catalog exact and signals for an unknown code"
    (expect (mapcar (lambda (entry)
                      (cons (getf entry :code) (getf entry :exit-code)))
                    *protocol-error-codes*)
            :to-equal
            (list (cons "argument.invalid" 1)
                  (cons "input.not-found" 1)
                  (cons "input.not-utf8" 1)
                  (cons "input.unsupported-format" 1)
                  (cons "input.unsupported-language" 1)
                  (cons "input.syntax-error" 1)
                  (cons "input.unsupported-value" 1)
                  (cons "selection.no-match" 2)
                  (cons "selection.ambiguous" 2)
                  (cons "selection.count-mismatch" 2)
                  (cons "refusal.target-changed" 2)
                  (cons "refusal.redacted-input" 1)
                  (cons "refusal.outside-workspace" 1)
                  (cons "refusal.exists" 1)
                  (cons "refusal.not-a-file" 1)
                  (cons "refusal.too-large" 1)
                  (cons "environment.io" 1)
                  (cons "environment.busy" 1)
                  (cons "environment.timeout" 1)
                  (cons "environment.unavailable" 1)
                  (cons "internal.unexpected" 1)))
    (signals error (error-code-exit-code "not.a.real.code"))))
