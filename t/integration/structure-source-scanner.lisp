(in-package #:aitools.integration.structure-test)

(defun %read-suppressed-form-at (text position)
  "Read one form without evaluating it or interning its symbols."
  (handler-case
      (with-standard-io-syntax
        (let ((*read-eval* nil)
              (*read-suppress* t)
              (*package* *reader-package*))
          (read-from-string text t nil :start position)))
    (error () (values :unreadable nil))))

(declaim (ftype function %scan-handwritten-text %handwritten-results)
         (special *handwritten-stub-allowances*))

;;; ------------------------------------------------------- text scanning

(defun %strip-prose (text)
  "TEXT with every `;` line comment, `#|...|#` block comment (nested), string
literal and the character of every `#\\x` character literal replaced by
spaces, newlines kept so line numbers stay valid. Handles `\\\"` and `\\\\`
inside strings."
  (let ((out (copy-seq text)) (n (length text)) (i 0))
    (flet ((blank (index)
             (unless (char= (char text index) #\Newline)
               (setf (char out index) #\Space))))
      (loop while (< i n)
            do (let ((c (char text i)))
                 (cond
                   ((and (char= c #\#) (< (1+ i) n) (char= (char text (1+ i)) #\\))
                    (incf i 2)
                    (when (< i n) (blank i) (incf i)))
                   ((and (char= c #\#) (< (1+ i) n) (char= (char text (1+ i)) #\|))
                    (let ((depth 0))
                      (loop while (< i n)
                            do (cond
                                 ((and (char= (char text i) #\#) (< (1+ i) n) (char= (char text (1+ i)) #\|))
                                  (incf depth) (blank i) (blank (1+ i)) (incf i 2))
                                 ((and (char= (char text i) #\|) (< (1+ i) n) (char= (char text (1+ i)) #\#))
                                  (decf depth) (blank i) (blank (1+ i)) (incf i 2)
                                  (when (zerop depth) (return)))
                                 (t (blank i) (incf i))))))
                   ((char= c #\")
                    (blank i) (incf i)
                    (loop while (< i n)
                          do (let ((d (char text i)))
                               (blank i) (incf i)
                               (cond ((char= d #\\) (when (< i n) (blank i) (incf i)))
                                     ((char= d #\") (return))))))
                   ((char= c #\;)
                    (loop while (and (< i n) (not (char= (char text i) #\Newline)))
                          do (blank i) (incf i)))
                   (t (incf i))))))
    out))
(defun %symbol-constituent-p (char)
  (or (alphanumericp char) (find char ".+-*/<>=!?_%&$")))
(defun %line-at (text position)
  (1+ (count #\Newline text :end position)))
(defun %qualified-references (text)
  "Every package-qualified symbol as (PACKAGE NAME INTERNAL-P LINE START NAME-START END)."
  (let ((length (length text))
        (references nil))
    (labels ((token-start-p (char)
               (or (%symbol-constituent-p char)
                   (char= char #\|)
                   (char= char #\\)))
             (token-end (start)
               (let ((position start)
                     (bars nil)
                     (escaped nil))
                 (loop while (< position length)
                       for char = (char text position)
                       do (cond
                            (escaped
                             (setf escaped nil)
                             (incf position))
                            ((char= char #\\)
                             (setf escaped t)
                             (incf position))
                            ((char= char #\|)
                             (setf bars (not bars))
                             (incf position))
                            ((and (not bars)
                                  (find char '(#\Space #\Tab #\Newline #\( #\)
                                               #\' #\" #\` #\, #\;)))
                             (return))
                            (t (incf position))))
                 position))
             (separator (start end)
               (let ((position start)
                     (bars nil)
                     (escaped nil))
                 (loop while (< position end)
                       for char = (char text position)
                       do (cond
                            (escaped
                             (setf escaped nil)
                             (incf position))
                            ((char= char #\\)
                             (setf escaped t)
                             (incf position))
                            ((char= char #\|)
                             (setf bars (not bars))
                             (incf position))
                            ((and (not bars) (char= char #\:))
                             (return position))
                            (t (incf position)))
                       finally (return nil))))
             (decode-name (start end)
               (with-output-to-string (output)
                 (let ((position start)
                       (bars nil)
                       (escaped nil))
                   (loop while (< position end)
                         for char = (char text position)
                         do (cond
                              (escaped
                               (write-char char output)
                               (setf escaped nil))
                              ((char= char #\\) (setf escaped t))
                              ((char= char #\|) (setf bars (not bars)))
                              (t (write-char (if bars char (char-upcase char)) output)))
                            (incf position))))))
      (let ((position 0))
        (loop while (< position length)
              do (if (token-start-p (char text position))
                     (let* ((end (token-end position))
                            (colon (separator position end)))
                       (when colon
                         (let* ((package (decode-name position colon))
                                (internal (and (< (1+ colon) end)
                                               (char= (char text (1+ colon)) #\:)))
                                (name-start (if internal (+ colon 2) (1+ colon)))
                                (name (decode-name name-start end)))
                           (when (and (plusp (length package))
                                      (plusp (length name))
                                      (not (string= package "#")))
                             (push (list package name internal (%line-at text position)
                                         position name-start end)
                                   references))))
                       (setf position (max (1+ position) end)))
                     (incf position))))
      (nreverse references))))

(defun %handwritten-form-positions (stripped operator)
  (let ((prefixes (list "" "CL:" "CL::" "COMMON-LISP:" "COMMON-LISP::"))
        (operator-length (length operator)))
    (remove-if (lambda (position) (%handwritten-reader-data-p stripped position))
               (loop for opening = (position #\( stripped)
                     then (position #\( stripped :start (1+ opening))
                     while opening
                     for head = (position-if-not (function %handwritten-whitespace-p) stripped
                                                 :start (1+ opening))
                     when (and head
                               (some (lambda (prefix)
                                       (let* ((name-start (+ head (length prefix)))
                                              (end (+ name-start operator-length)))
                                         (and (<= end (length stripped))
                                              (string-equal operator stripped :start2 name-start :end2 end)
                                              (or (= end (length stripped))
                                                  (not (%symbol-constituent-p (char stripped end)))))))
                                     prefixes))
                     collect opening))))

(defun %handwritten-reader-data-p (text target)
  (loop with start = 0
        for marker = (position-if
                      (lambda (character)
                        (or (char= character #\')
                            (= (char-code character) 96)))
                      text :start start)
        while (and marker (< marker target))
        do (setf start (1+ marker))
           (unless (and (char= (char text marker) #\')
                        (plusp marker)
                        (char= (char text (1- marker)) #\#))
             (multiple-value-bind (form end)
                 (%read-suppressed-form-at text marker)
               (declare (ignore form))
               (when (and (integerp end) (< target end))
                 (return t))))
        finally (return nil)))

(defun scan-handwritten-stub-file (pathname &key relative
                                             (allowances *handwritten-stub-allowances*))
  (let* ((name (or relative (namestring pathname)))
         (text (uiop:read-file-string pathname)))
    (multiple-value-bind (candidates unresolved)
        (%scan-handwritten-text text name)
      (%handwritten-results candidates unresolved allowances))))

(defun scan-handwritten-stub-tree (root &key (allowances *handwritten-stub-allowances*))
  "Scan test code outside static integration fixtures; return violations, unresolved dynamics, and file count."
  (let* ((root (uiop:ensure-directory-pathname root))
         (pathnames
          (sort (remove-if
                (lambda (pathname)
                  (search "t/integration/fixtures/"
                          (enough-namestring pathname root)))
                (directory (merge-pathnames "t/**/*.lisp" root)))
               (function string<)
               :key (function namestring)))
         (candidates nil)
         (unresolved nil))
    (dolist (pathname pathnames)
      (multiple-value-bind (found issues)
          (%scan-handwritten-text (uiop:read-file-string pathname)
                                  (enough-namestring pathname root))
        (dolist (candidate found) (push candidate candidates))
        (dolist (issue issues) (push issue unresolved))))
    (multiple-value-bind (violations limitations)
        (%handwritten-results (nreverse candidates) (nreverse unresolved) allowances)
      (values violations limitations (length pathnames)))))
