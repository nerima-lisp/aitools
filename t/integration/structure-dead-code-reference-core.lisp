(in-package #:aitools.integration.structure-test)

(defvar *liveness-reference-collector* nil)

(defun %liveness-reference-name-of (object)
  (and (symbolp object)
       (not (keywordp object))
       (%liveness-symbol-name object)))

(defun %liveness-reference-package-of (object)
  (let ((origin (and (symbolp object)
                     (get object :u05-qualified-reference)))
        (source-name (and (symbolp object) (get object :u05-source-name)))
        (package (and (symbolp object) (symbol-package object))))
    (cond
      (origin (first origin))
      (source-name :local)
      ((null package) :uninterned)
      ((eq package *reader-package*) :local)
      (t (package-name package))))
)

(defun %liveness-emit-reference (namespace object)
  (let ((name (%liveness-reference-name-of object)))
    (when (and name (not (member name '("NIL" "T") :test #'string=)))
      (push (list namespace name (%liveness-reference-package-of object))
            *liveness-reference-collector*))))

(defun %liveness-reference-bound-p (object bindings)
  (and (eq (%liveness-reference-package-of object) :local)
       (member (%liveness-reference-name-of object) bindings :test #'equal)))

(defun %liveness-walk-sequence (forms values functions)
  (loop for tail = forms then (cdr tail)
        while (consp tail)
        do (%liveness-walk-form (car tail) values functions)
        finally
          (unless (null tail)
            (%liveness-walk-form tail values functions))))

(defun %liveness-walk-lambda-vars (source-lambda-list values functions method-p)
  (if method-p
      (let ((names '()) (mode :required))
        (when (listp source-lambda-list)
          (dolist (item source-lambda-list)
            (if (and (symbolp item)
                     (let ((name (%liveness-reference-name-of item)))
                       (and name (not (string= name ""))
                            (char= (char name 0) #\&))))
                (setf mode (intern (subseq (%liveness-reference-name-of item) 1)
                                   :keyword))
                (let* ((variable (if (consp item)
                                     (if (consp (first item))
                                         (second (first item))
                                         (first item))
                                     item))
                       (name (%liveness-reference-name-of variable)))
                  (when (and (consp item) (second item))
                    (%liveness-walk-type (second item)))
                  (when name (pushnew name names :test #'equal))
                  (when (and (consp item) (third item)
                             (member mode '(:optional :key)))
                    (let ((supplied (%liveness-reference-name-of (third item))))
                      (when supplied
                        (pushnew supplied names :test #'equal))))))))
        (nreverse names))
      (let ((names '()))
        (labels ((lambda-marker (item)
                   (let ((name (%liveness-reference-name-of item)))
                     (cond
                       ((null name) nil)
                       ((string= name "") nil)
                       ((char= (char name 0) #\&) name))))
                 (bind-variable (object)
                   (let ((name (%liveness-reference-name-of object)))
                     (when (and name
                                (or (string= name "")
                                    (char/= (char name 0) #\&)))
                       (pushnew name names :test #'equal))))
                 (bind-pattern (pattern)
                   (cond
                     ((symbolp pattern) (bind-variable pattern))
                     ((consp pattern) (walk-lambda-list pattern))))
                 (walk-parameter-spec (item mode)
                   (let* ((designator (if (consp item) (first item) item))
                          (pattern (cond
                                    ((eq mode :required) item)
                                    ((and (eq mode :key) (consp designator))
                                     (second designator))
                                    (t designator)))
                          (initial (and (consp item) (second item)))
                          (supplied (and (consp item) (third item))))
                     (when (and initial (member mode '(:optional :key :aux)))
                       (%liveness-walk-form initial (append values names)
                                            functions))
                     (bind-pattern pattern)
                     (when (and supplied (member mode '(:optional :key)))
                       (bind-pattern supplied))))
                 (walk-lambda-list (parameters)
                   (let ((mode :required)
                         (next-binding-p nil))
                     (loop for tail = parameters then (cdr tail)
                           while (consp tail)
                           for item = (car tail)
                           for marker = (lambda-marker item)
                           do (cond
                                ((or (equal marker "&WHOLE")
                                     (equal marker "&ENVIRONMENT")
                                     (equal marker "&REST")
                                     (equal marker "&BODY"))
                                 (setf next-binding-p t))
                                ((equal marker "&OPTIONAL")
                                 (setf mode :optional next-binding-p nil))
                                ((equal marker "&KEY")
                                 (setf mode :key next-binding-p nil))
                                ((equal marker "&AUX")
                                 (setf mode :aux next-binding-p nil))
                                ((equal marker "&ALLOW-OTHER-KEYS")
                                 (setf next-binding-p nil))
                                (marker
                                 (setf next-binding-p nil))
                                (next-binding-p
                                 (bind-pattern item)
                                 (setf next-binding-p nil))
                                (t (walk-parameter-spec item mode)))
                           finally
                             (unless (null tail)
                               (bind-pattern tail)))))
          (when (listp source-lambda-list) (walk-lambda-list source-lambda-list))
          (nreverse names)))))
)

(defun %liveness-walk-type (object)
  (cond
    ((symbolp object)
     (let ((name (%liveness-reference-name-of object)))
       (unless (or (keywordp object)
                   (equal name "*")
                   (and name (plusp (length name))
                        (char= (char name 0) #\&)))
         (%liveness-emit-reference :type object))))
    ((consp object)
     (let ((operator (%liveness-reference-name-of (first object))))
       (cond
         ((member operator '("AND" "OR" "NOT") :test #'equal)
          (mapc #'%liveness-walk-type (rest object)))
         ((equal operator "SATISFIES")
          (%liveness-emit-reference :function (second object)))
         ((member operator '("MEMBER" "EQL" "MOD") :test #'equal)
          nil)
         ((member operator '("ARRAY" "SIMPLE-ARRAY" "VECTOR" "SIMPLE-VECTOR")
                  :test #'equal)
          (%liveness-emit-reference :type (first object))
          (let ((element-type (second object)))
            (unless (or (null element-type)
                        (equal (%liveness-reference-name-of element-type) "*"))
              (%liveness-walk-type element-type))))
         (t
          (%liveness-emit-reference :type (first object))
          (dolist (part (rest object))
            (let ((name (%liveness-reference-name-of part)))
              (unless (or (numberp part)
                          (keywordp part)
                          (equal name "*")
                          (and name (plusp (length name))
                               (char= (char name 0) #\&)))
                (%liveness-walk-type part))))))))))

(defun %liveness-walk-quoted-type (object)
  (when (and (consp object)
             (equal (%liveness-reference-name-of (first object)) "QUOTE")
             (symbolp (second object)))
    (%liveness-emit-reference :type (second object))))

(defun %liveness-walk-slot-options (slot values functions)
  (when (consp slot)
    (loop for options on (rest slot) by #'cddr
          while (cdr options)
          do (case (first options)
               (:initform (%liveness-walk-form (second options) values functions))
               (:type (%liveness-walk-type (second options)))))))

(defun %liveness-walk-class (object values functions)
  (dolist (superclass (third object))
    (%liveness-walk-type superclass))
  (dolist (slot (fourth object))
    (%liveness-walk-slot-options slot values functions))
  (%liveness-walk-sequence (nthcdr 4 object) values functions))

(defun %liveness-walk-struct (object values functions)
  (let* ((spec (second object))
         (options (if (consp spec) (rest spec) nil))
         (slots (if (stringp (third object)) (cdddr object) (cddr object))))
    (dolist (option options)
      (when (consp option)
        (cond
          ((eq (first option) :include)
           (%liveness-walk-type (second option)))
          ((and (eq (first option) :constructor) (third option))
           (%liveness-walk-lambda-vars (third option) values functions nil)))))
    (dolist (slot slots)
      (%liveness-walk-slot-options slot values functions))))

(defun %liveness-walk-quasiquote-template (template depth visible-p values functions)
  (cond
    ((consp template)
     (let ((marker (first template)))
       (cond
         ((eq marker :u05-quasiquote)
          (%liveness-walk-quasiquote-template (second template) (1+ depth)
                                              nil values functions))
         ((member marker '(:u05-unquote :u05-unquote-splicing))
          (if (= depth 1)
              (progn
                (%liveness-walk-form (second template) values functions)
                nil)
              (%liveness-walk-quasiquote-template (second template) (1- depth)
                                                  nil values functions)))
         (visible-p
          (cons (%liveness-walk-quasiquote-template (car template) depth t
                                                    values functions)
                (%liveness-walk-quasiquote-template (cdr template) depth t
                                                    values functions)))
         (t
          (%liveness-walk-quasiquote-template (car template) depth nil
                                              values functions)
          (%liveness-walk-quasiquote-template (cdr template) depth nil
                                              values functions)
          nil))))
    (visible-p template)
    (t nil)))

(defun %liveness-walk-quasiquote (object values functions)
  (%liveness-walk-form
   (%liveness-walk-quasiquote-template (second object) 1 t values functions)
   values functions))
