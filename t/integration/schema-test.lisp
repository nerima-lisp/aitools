(in-package #:aitools.integration.dispatch-test)

(describe "aitools schema group names"
  (it "expands a group followed by a subcommand into full details"
    (aitools.test.support:with-workspace
      (*root* state-home)
      (declare (ignore state-home))
      (multiple-value-bind (code envelope stream)
          (run-aitools "schema" "json" "get" "read")
        (expect (list code stream) :to-equal (list 0 :stdout))
        (let ((commands (value envelope "commands")))
          (expect (map 'list (lambda (command) (value command "name")) commands)
                  :to-equal '("json get" "read"))
          (expect (every (lambda (command)
                           (and (stringp (value command "description"))
                                (vectorp (value command "args"))
                                (vectorp (value command "output_fields"))
                                (vectorp (value command "error_codes"))))
                         commands)
                  :to-be t)))))
  (it "resolves a nested group path and command leaf in schema words"
    (aitools.test.support:with-workspace
      (*root* state-home)
      (declare (ignore state-home))
      (multiple-value-bind (code envelope stream)
          (run-aitools "schema" "org" "todo" "set")
        (expect (list code stream) :to-equal (list 0 :stdout))
        (expect (map 'list (lambda (command) (value command "name"))
                      (value envelope "commands"))
                :to-equal '("org todo set")))))
  (it "lists schemas beneath the parent group" (aitools.test.support:with-workspace (*root* state-home) (declare (ignore state-home)) (multiple-value-bind (code envelope stream) (run-aitools "schema" "org") (expect (list code stream) :to-equal (list 0 :stdout)) (let ((names (loop for command across (value envelope "commands") collect (value command "name")))) (expect (and (member "org outline" names :test (function string=)) (member "org todo set" names :test (function string=))) :to-be-truthy)))))
  (it "lists schemas under a nested group path"
    (aitools.test.support:with-workspace
      (*root* state-home)
      (declare (ignore state-home))
      (multiple-value-bind (code envelope stream)
          (run-aitools "schema" "org" "todo")
        (expect (list code stream) :to-equal (list 0 :stdout))
        (expect (and (member "org todo set"
                             (map 'list (lambda (command) (value command "name"))
                                  (value envelope "commands"))
                             :test #'string=)
                     t)
                :to-be t))))
  (it "dispatches a nested command and tokenizes its repair group"
    (aitools.test.support:with-workspace
      (*root* state-home)
      (declare (ignore state-home))
      (multiple-value-bind (code help stream)
          (run-aitools "org" "todo" "set" "--help")
        (expect (list code stream) :to-equal (list 0 :stdout))
        (expect (value help "name") :to-equal "org todo set"))
      (multiple-value-bind (code envelope stream)
          (run-aitools "set" "notes.org" "TODO")
        (expect code :to-be 1)
        (expect stream :to-equal :stderr)
        (expect (member (format nil "aitools --root ~A org todo set notes.org TODO" *root*)
                        (repair-commands envelope)
                        :test #'string=)
                :to-be-truthy)))))
