(in-package #:aitools.integration.structure-test)
(defparameter *handwritten-stub-allowances* nil)
(defun %handwritten-whitespace-p (character) (find character '(#\Space #\Tab #\Newline #\Return #\Page)))
(defun %handwritten-form-positions (stripped operator)
  (let ((prefixes (list "" "CL:" "CL::" "COMMON-LISP:" "COMMON-LISP::"))
        (operator-length (length operator)))
    (remove-if (lambda (position) (%handwritten-reader-data-p stripped position))
               (loop for opening = (position #\( stripped)
                     then (position #\( stripped :start (1+ opening))
                     while opening
                     for head = (position-if-not (function %handwritten-whitespace-p) stripped
                                                 :start (1+ opening))
                     when (and head
                               (some (lambda (prefix)
                                       (let* ((name-start (+ head (length prefix)))
                                              (end (+ name-start operator-length)))
                                         (and (<= end (length stripped))
                                              (string-equal operator stripped :start2 name-start :end2 end)
                                              (or (= end (length stripped))
                                                  (not (%symbol-constituent-p (char stripped end)))))))
                                     prefixes))
                     collect opening))))
(defun %handwritten-reader-data-p (text target)
  (loop for marker = (position-if (lambda (c) (find c '(#\' #\`))) text)
          then (position-if (lambda (c) (find c '(#\' #\`))) text
                            :start (1+ marker))
        while (and marker (< marker target))
        thereis (multiple-value-bind (form end) (%read-form-at text marker)
                  (and (consp form)
                       (member (symbol-name (first form))
                               '("QUOTE" "QUASIQUOTE") :test #'string-equal)
                       (< target end)))))
(defun %strip-reader-comments (text)
  (let* ((sentinel (code-char #xe000))
         (protected (copy-seq text))
         (unreadable nil)
         (cursor 0))
    (loop for marker = (search "#;" text :start2 cursor)
          while marker
          do (setf (char protected (1+ marker)) sentinel
                   cursor (+ marker 2)))
    (let ((stripped (%strip-prose protected))
          (token (coerce (list #\# sentinel) 'string)))
      (setf cursor 0)
      (loop for marker = (search token stripped :start2 cursor)
            while marker
            do (multiple-value-bind (form end)
                   (%read-form-at text (+ marker 2))
                 (if (or (eq form :unreadable) (not (integerp end))
                         (<= end marker))
                     (progn
                       (push (list (%line-at text marker)
                                   "unreadable #; comment form")
                             unreadable)
                       (setf cursor (+ marker 2)))
                     (progn
                       (loop for index from marker below end
                             unless (char= (char stripped index) #\Newline)
                               do (setf (char stripped index) #\Space))
                       (setf cursor end)))))
      (values stripped (nreverse unreadable)))))
(defun %handwritten-form-head-p (form name)
  (and (consp form)
       (symbolp (first form))
       (string-equal (symbol-name (first form)) name)))
(defun %handwritten-function-name-parts (name)
  (cond
    ((symbolp name) (values name nil t))
    ((and (%handwritten-form-head-p name "SETF")
          (= (length name) 2)
          (symbolp (second name)))
     (values (second name) t t))
    (t (values nil nil nil))))
(defun %handwritten-symbol-package (symbol current-package)
  (let ((package (symbol-package symbol)))
    (if (or (null package) (eq package *reader-package*))
        (let ((resolved (find-package current-package)))
          (if resolved (package-name resolved) current-package))
        (package-name package))))
(defun %handwritten-production-package-p (name)
  (let ((normalized (string-upcase name)))
    (or (string= normalized "AITOOLS.DATA")
        (loop for context in *all-contexts*
              thereis (loop for layer in '(:domain :application :infrastructure :presentation)
                            thereis (string= normalized (context-package-name context layer)))))))
(defun %handwritten-candidate (symbol setf-name current-package relative line)
  (let ((package (%handwritten-symbol-package symbol current-package)))
    (when (%handwritten-production-package-p package)
      (list package (if setf-name (format nil "(SETF ~A)" (symbol-name symbol))
                       (symbol-name symbol)) relative line))))
(defun %handwritten-quoted-name-parts (designator)
  (when (and (%handwritten-form-head-p designator "QUOTE")
             (= (length designator) 2))
    (%handwritten-function-name-parts (second designator))))
(defun %handwritten-setf-results (form relative line current-package)
  (let ((candidates nil)
        (unresolved nil))
    (loop for tail on (rest form) by #'cddr
          for place = (first tail)
          when (and (%handwritten-form-head-p place "FDEFINITION")
                    (= (length place) 2))
            do (multiple-value-bind (symbol setf-name static-p)
                   (%handwritten-quoted-name-parts (second place))
                 (if static-p
                     (let ((candidate
                             (%handwritten-candidate symbol setf-name
                                                     current-package relative line)))
                       (when candidate (push candidate candidates)))
                     (push (format nil "~A:~D: dynamic FDEFINITION target ~S"
                                   relative line (second place))
                           unresolved)))
          when (and (%handwritten-form-head-p place "SYMBOL-FUNCTION")
                    (= (length place) 2))
            do (multiple-value-bind (symbol setf-name static-p)
                   (%handwritten-quoted-name-parts (second place))
                 (if static-p
                     (let ((candidate
                             (%handwritten-candidate symbol setf-name
                                                     current-package relative line)))
                       (when candidate (push candidate candidates)))
                     (push (format nil "~A:~D: dynamic SYMBOL-FUNCTION target ~S"
                                   relative line (second place))
                           unresolved))))
    (values (nreverse candidates) (nreverse unresolved))))
(defun %handwritten-package-designator (designator)
  (let ((name (typecase designator (symbol (symbol-name designator))
                                  (string designator))))
    (when name
      (let ((package (find-package name)))
        (if package (package-name package) (string-upcase name))))))
(defun %scan-handwritten-text (text relative)
  (multiple-value-bind (code reader-comments)
      (%strip-reader-comments text)
    (let ((forms nil)
          (candidates nil)
          (unresolved
            (mapcar (lambda (entry)
                      (format nil "~A:~D: ~A" relative (first entry)
                              (second entry)))
                    reader-comments))
          (current-package "CL-USER"))
      (dolist (operator '("in-package" "setf" "defun"))
        (dolist (position (%handwritten-form-positions code operator))
          (push (list operator position) forms)))
      (dolist (entry (sort forms #'< :key #'second))
        (let* ((operator (first entry))
               (position (second entry))
               (form (%read-form-at text position))
               (line (%line-at text position)))
          (cond
            ((eq form :unreadable)
             (push (format nil "~A:~D: unreadable ~A form" relative line operator)
                   unresolved))
            ((string= operator "in-package")
             (let ((name (%handwritten-package-designator (second form))))
               (when name (setf current-package name))))
            ((string= operator "defun")
             (multiple-value-bind (symbol setf-name valid-p)
                 (%handwritten-function-name-parts (second form))
               (when valid-p
                 (let ((candidate (%handwritten-candidate
                                   symbol setf-name current-package relative line)))
                   (when candidate (push candidate candidates))))))
            (t
             (multiple-value-bind (found unresolved-forms)
                 (%handwritten-setf-results form relative line current-package)
               (setf candidates (nconc (nreverse found) candidates)
                     unresolved (nconc (nreverse unresolved-forms) unresolved)))))))
      (values (nreverse candidates) (nreverse unresolved)))))

(defun %handwritten-unique-candidates (candidates)
  (let ((seen (make-hash-table :test #'equal))
        (unique nil))
    (dolist (candidate candidates)
      (let ((key (subseq candidate 0 2)))
        (unless (gethash key seen)
          (setf (gethash key seen) t)
          (push candidate unique))))
    (nreverse unique)))
(defun %handwritten-allowance (key allowances)
  (find-if (lambda (entry)
             (and (consp entry) (consp (rest entry))
                  (stringp (first entry)) (stringp (second entry))
                  (equal key (list (string-upcase (first entry))
                                   (string-upcase (second entry))))))
           allowances))
(defun %handwritten-allowance-reason-p (entry)
  (and (consp (cddr entry)) (stringp (third entry))
       (plusp (length (string-trim '(#\Space #\Tab #\Newline #\Return)
                                   (third entry))))))
(defun %handwritten-results (candidates unresolved allowances)
  (let ((violations nil)
        (used nil))
    (dolist (candidate (%handwritten-unique-candidates candidates))
      (let* ((key (subseq candidate 0 2))
             (allowance (%handwritten-allowance key allowances)))
        (if allowance
            (progn
              (push allowance used)
              (unless (%handwritten-allowance-reason-p allowance)
                (push (format nil "allowance for ~A:~A requires a nonempty reason"
                              (first key) (second key))
                      violations)))
            (push (format nil "~A:~D: hand-written replacement of ~A:~A"
                          (third candidate) (fourth candidate)
                          (first key) (second key))
                  violations))))
    (dolist (allowance allowances)
      (let ((key (and (consp allowance) (consp (rest allowance))
                      (stringp (first allowance)) (stringp (second allowance))
                      (list (string-upcase (first allowance))
                            (string-upcase (second allowance))))))
        (cond
          ((null key) (push (format nil "invalid handwritten-stub allowance ~S"
                                    allowance)
                            violations))
          ((not (member allowance used :test #'eq))
           (push (format nil "stale handwritten-stub allowance for ~A:~A"
                         (first key) (second key))
                 violations)))))
    (values (sort (nreverse violations) #'string<)
            (sort (remove-duplicates unresolved :test #'string=) #'string<))))
(defun scan-handwritten-stub-file (pathname &key relative
                                             (allowances *handwritten-stub-allowances*))
  (let* ((name (or relative (namestring pathname)))
         (text (uiop:read-file-string pathname)))
    (multiple-value-bind (candidates unresolved)
        (%scan-handwritten-text text name)
      (%handwritten-results candidates unresolved allowances))))
(defun scan-handwritten-stub-tree (root &key
                                        (allowances *handwritten-stub-allowances*))
  "Scan test Lisp, excluding fixtures; return violations, unresolved dynamics, and file count."
  (let ((root (uiop:ensure-directory-pathname root))
        (candidates nil)
        (unresolved nil))
    (let ((pathnames
           (remove-if
            (lambda (pathname)
              (search "t/integration/fixtures/" (enough-namestring pathname root)))
            (sort (directory (merge-pathnames "t/**/*.lisp" root))
                  #'string< :key #'namestring))))
      (dolist (pathname pathnames)
        (multiple-value-bind (found issues)
            (%scan-handwritten-text (uiop:read-file-string pathname)
                                    (enough-namestring pathname root))
          (progn (loop for candidate in found do (push candidate candidates))
            (loop for issue in issues do (push issue unresolved)))))
      (multiple-value-bind (violations limitations)
          (%handwritten-results (nreverse candidates) (nreverse unresolved) allowances)
        (values violations limitations (length pathnames))))))
