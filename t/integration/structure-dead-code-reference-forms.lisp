(in-package #:aitools.integration.structure-test)

(defun %liveness-walk-common-form (object operator values functions)
  (cond
    ((member operator '("QUOTE" "DEFPACKAGE" "IN-PACKAGE"
                        "DEFINE-DATA-TABLE" "DECLARE" "DECLAIM" "THE"
                        "CHECK-TYPE")
             :test #'equal)
     (cond
       ((member operator '("DECLARE" "DECLAIM") :test #'equal)
        (dolist (declaration (rest object))
          (when (and (consp declaration)
                     (member (%liveness-reference-name-of (first declaration))
                             '("TYPE" "FTYPE") :test #'equal))
            (%liveness-walk-type (second declaration)))))
       ((equal operator "THE")
        (%liveness-walk-type (second object))
        (%liveness-walk-form (third object) values functions))
       ((equal operator "CHECK-TYPE")
        (%liveness-walk-form (second object) values functions)
        (%liveness-walk-type (third object))))
     t)
    ((equal operator "FUNCTION")
     (let ((target (second object)))
       (if (symbolp target)
           (unless (%liveness-reference-bound-p target functions)
             (%liveness-emit-reference :function target))
           (%liveness-walk-form target values functions)))
     t)
    ((member operator '("DEFVAR" "DEFPARAMETER" "DEFCONSTANT")
             :test #'equal)
     (%liveness-walk-sequence (cddr object) values functions)
     t)
    ((member operator '("MAKE-INSTANCE" "MAKE-CONDITION" "FIND-CLASS"
                        "CHANGE-CLASS")
             :test #'equal)
     (%liveness-emit-reference :function (first object))
     (let ((class (if (equal operator "CHANGE-CLASS")
                      (third object)
                      (second object))))
       (if (and (consp class)
                (equal (%liveness-reference-name-of (first class)) "QUOTE"))
           (%liveness-emit-reference :type (second class))
           (when (and (symbolp class) (not (keywordp class)))
             (%liveness-emit-reference :type class)))
       (%liveness-walk-sequence
        (if (equal operator "CHANGE-CLASS") (cdddr object) (cddr object))
        values functions))
     t)
    ((member operator '("TYPEP" "SUBTYPEP") :test #'equal)
     (%liveness-emit-reference :function (first object))
     (%liveness-walk-form (second object) values functions)
     (if (and (consp (third object))
              (equal (%liveness-reference-name-of (first (third object)))
                     "QUOTE"))
         (%liveness-emit-reference :type (second (third object)))
         (%liveness-walk-type (third object)))
     (%liveness-walk-sequence (cdddr object) values functions)
     t)
    ((member operator '("TYPECASE" "ETYPECASE" "CTYPECASE") :test #'equal)
     (%liveness-emit-reference :function (first object))
     (%liveness-walk-form (second object) values functions)
     (dolist (clause (cddr object))
       (%liveness-walk-type (first clause))
       (%liveness-walk-sequence (rest clause) values functions))
     t)
    ((equal operator "HANDLER-CASE")
     (%liveness-walk-form (second object) values functions)
     (dolist (clause (cddr object))
       (when (consp clause)
         (%liveness-walk-type (first clause))
         (let* ((lambda-list (second clause))
                (variable (and (consp lambda-list) (first lambda-list)))
                (local (%liveness-reference-name-of variable)))
           (%liveness-walk-sequence (cddr clause)
                                    (if local (cons local values) values)
                                    functions))))
     t)
    ((member operator '("ERROR" "CERROR" "SIGNAL" "WARN") :test #'equal)
     (%liveness-emit-reference :function (first object))
     (when (and (consp (second object))
                (equal (%liveness-reference-name-of (first (second object)))
                       "QUOTE"))
       (%liveness-emit-reference :type (second (second object))))
     (%liveness-walk-sequence (cddr object) values functions)
     t)
    ((equal operator "FIND-SYMBOL")
     (unless (%liveness-reference-bound-p (first object) functions)
       (%liveness-emit-reference :function (first object)))
     t)
    ((equal operator "SYMBOL-FUNCTION")
     (let ((designator (second object)))
       (when (and (consp designator)
                  (equal (%liveness-reference-name-of (first designator)) "QUOTE"))
         (%liveness-emit-reference :function (second designator)))
       (%liveness-walk-sequence (cddr object) values functions))
     t)
    ((equal operator "SYMBOL-VALUE")
     (let ((designator (second object)))
       (when (and (consp designator)
                  (equal (%liveness-reference-name-of (first designator)) "QUOTE"))
         (%liveness-emit-reference :value (second designator)))
       (%liveness-walk-sequence (cddr object) values functions))
     t)
    (t nil)))

(defun %liveness-walk-dispatched-form (object operator values functions)
  (or (%liveness-walk-common-form object operator values functions)
      (%liveness-walk-definition-form object operator values functions)
      (%liveness-walk-binding-form object operator values functions)
      (%liveness-walk-loop-form object operator values functions)))

(defun %liveness-reference-p (form)
  "References in FORM as (NAMESPACE NAME PACKAGE), excluding local and quoted data."
  (let ((*liveness-reference-collector* nil))
    (%liveness-walk-form form nil nil)
    (nreverse *liveness-reference-collector*)))

(defun %liveness-walk-form (object values functions)
  (cond
    ((symbolp object)
     (unless (or (keywordp object)
                 (%liveness-reference-bound-p object values))
       (%liveness-emit-reference :value object)))
    ((and (consp object) (eq (first object) :u05-quasiquote))
     (%liveness-walk-quasiquote object values functions))
    ((consp object)
     (let* ((head (first object))
            (operator (%liveness-reference-name-of head))
            (args (rest object)))
       (unless (%liveness-walk-dispatched-form object operator values functions)
         (if (equal operator "COND")
             (progn
               (%liveness-emit-reference :function head)
               (dolist (clause args)
                 (when (consp clause)
                   (%liveness-walk-form (first clause) values functions)
                   (%liveness-walk-sequence (rest clause) values functions))))
             (progn
               (when (and (symbolp head) (not (keywordp head))
                          (not (%liveness-reference-bound-p head functions)))
                 (%liveness-emit-reference :function head))
               (if (equal operator "WITH-LOCK-HELD")
                   (progn
                     (%liveness-walk-sequence (second object) values functions)
                     (%liveness-walk-sequence (cddr object) values functions))
                   (%liveness-walk-sequence args values functions)))))))))
