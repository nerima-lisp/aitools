;;;; Run explicitly on Linux or Darwin: sbcl --script t/integration/env-metrics-smoke.lisp
;;;; A missing host source fails this smoke; fixture tests do not substitute for it.
(require :asdf)
(asdf:initialize-source-registry
 `(:source-registry (:directory ,(uiop:getcwd)) :inherit-configuration))
(asdf:load-system "aitools/cli")

(let ((registry (aitools.protocol.application:make-command-registry))
      (checks 0))
  (aitools.env.presentation:register-env-commands
   registry (aitools.env.infrastructure:make-production-env-ports))
  (let ((app (cl-cli:make-app :name "aitools" :commands (aitools/cli:finalize-app-commands registry)))
        (stdout (make-string-output-stream))
        (stderr (make-string-output-stream)))
    (flet ((check (condition label)
             (incf checks)
             (unless condition (error "Metrics smoke failed: ~A" label))))
      (let* ((code (aitools/cli:dispatch app registry '("aitools" "sys" "metrics" "--limit" "1")
                                        :stdout stdout :stderr stderr))
             (error-output (get-output-stream-string stderr))
             (document (json-kit:parse (get-output-stream-string stdout))))
        ;; Print classifications only: envelopes may contain process names or paths.
        (unless (member code '(0 3))
          (let* ((status (gethash "status" document))
                 (error-object (gethash "error" document))
                 (error-code (and (hash-table-p error-object) (gethash "code" error-object))))
            (format t "~&Metrics smoke diagnostic: exit=~D status=~A error-code=~A stderr-present=~A~%"
                    code
                    (if (member status '("ok" "partial" "error") :test #'equal) status "other")
                    (if (equal error-code "environment.unavailable") error-code "other")
                    (plusp (length error-output)))))
        (check (member code '(0 3)) "success or bounded partial exit")
        (check (equal error-output "") "empty stderr")
        (let* ((cpu (gethash "cpu" document))
               (memory (gethash "memory" document))
               (items (gethash "items" document)))
          (check (= (gethash "sample_interval_ms" document) 1000) "interval milliseconds")
          (check (<= 0 (gethash "busy_percent" cpu) 100) "aggregate CPU range")
          (check (plusp (gethash "logical_cpus" cpu)) "logical CPUs")
          (check (<= 0 (gethash "available_bytes" memory) (gethash "total_bytes" memory)) "memory range")
          (check (= (length items) 1) "bounded nonempty process output")
          (check (plusp (gethash "pid" (aref items 0))) "process PID")
          (check (>= (gethash "rss_bytes" (aref items 0)) 0) "RSS bytes")
          (check (not (find #\/ (gethash "command" (aref items 0)))) "command basename")
          (check (equal (gethash "process_cpu_basis" document)
                        (if (string-equal (software-type) "Darwin") "decaying_average" "lifetime_average"))
                 "OS-specific process CPU basis")
          (check (if (> (gethash "total" document) 1) (= code 3) (= code 0)) "truncation exit semantics")))
      (dolist (command '("network" "disk"))
        (let* ((arguments (append (list "aitools" "sys" command)
                                  (when (equal command "network") '("--limit" "1"))))
               (code (aitools/cli:dispatch app registry arguments :stdout stdout :stderr stderr))
               (document (json-kit:parse (get-output-stream-string stdout))))
          (check (member code '(0 3)) "host observation success or partial")
          (check (equal (get-output-stream-string stderr) "") "host observation empty stderr")
          (if (equal command "network")
              (let ((items (gethash "items" document)))
                (check (= (length items) 1) "one network interface")
                (check (equal (gethash "basis" document) "cumulative_interface_counters") "network counter basis")
                (check (equal (gethash "bytes" (gethash "units" document)) "bytes") "network bytes")
                (check (if (> (gethash "total" document) 1) (= code 3) (= code 0)) "network truncation exit")
                (dolist (key '("rx_bytes" "rx_packets" "rx_errors" "tx_bytes" "tx_packets" "tx_errors"))
                  (check (and (integerp (gethash key (aref items 0))) (>= (gethash key (aref items 0)) 0)) "nonnegative network counter")))
              (progn
                (check (= code 0) "disk exit")
                (check (equal (gethash "source" document) "statfs") "disk source")
                (check (equal (gethash "units" document) "bytes") "disk units")
                (check (equal (gethash "scope" document) "filesystem_containing_path") "single filesystem")
                (check (<= 0 (gethash "available_bytes" document) (gethash "total_bytes" document)) "disk capacity range")))))
      (let* ((code (aitools/cli:dispatch app registry
                                        '("aitools" "sys" "snapshot" "--process-limit" "1" "--network-limit" "1" "--port-limit" "1")
                                        :stdout stdout :stderr stderr))
             (document (json-kit:parse (get-output-stream-string stdout)))
             (sections (gethash "sections" document)))
        (check (member code '(0 3)) "snapshot success or partial")
        (check (equal (get-output-stream-string stderr) "") "snapshot stderr")
        (check (equal (gethash "scope" document) "host") "snapshot scope")
        (check (integerp (gethash "started_at_epoch_ms" document)) "snapshot start epoch")
        (check (integerp (gethash "finished_at_epoch_ms" document)) "snapshot finish epoch")
        (dolist (name '("info" "metrics" "network" "disk" "ports"))
          (let ((section (gethash name sections)))
            (check (member (gethash "status" section) '("ok" "partial" "unavailable") :test #'equal) "snapshot section status")
            (when (and (member name '("metrics" "network" "ports") :test #'equal)
                       (not (equal (gethash "status" section) "unavailable")))
              (check (<= (length (gethash "items" (gethash "data" section))) 1) "snapshot item bound")))))
      (format t "~&Host smoke: platform=~A assertions=~D passed~%" (software-type) checks))))
