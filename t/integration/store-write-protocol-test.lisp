;;;;
;;;; Write protocol behavior against a real temporary workspace and state directory.
(in-package #:aitools.store.test)

(describe "aitools.store commit-changes/k"
  (it "applies explicit directory modes after writing descendants and preserves omitted modes"
    (with-temp-store (store)
      (unwind-protect
           (progn
             (expect (commit store (list (mkdir-request "private" :mode #o500)
                                         (mkdir-request "private/nested" :mode #o750)
                                         (write-file-request "private/nested/file" (bytes "data"))))
                     :to-be :committed)
             (expect (disk-mode store "private") :to-be #o500)
             (expect (disk-mode store "private/nested") :to-be #o750)
             (expect (disk-text store "private/nested/file") :to-equal "data")
             (expect (commit store (list (mkdir-request "private"))) :to-be :committed)
             (expect (disk-mode store "private") :to-be #o500))
        (when (probe-file (disk-path store "private"))
          (sb-posix:chmod (disk-path store "private") #o700)))))

  (it "restores nested deleted directory modes and content through undo"
    (with-temp-store (store)
      (put-file store "private/nested/file" "data" :mode #o600)
      (sb-posix:chmod (disk-path store "private") #o700)
      (sb-posix:chmod (disk-path store "private/nested") #o750)
      (multiple-value-bind (status op-id)
          (commit store (list (delete-request "private/nested/file")
                              (delete-request "private/nested")
                              (delete-request "private")))
        (expect status :to-be :committed)
        (expect (disk-text store "private") :to-be :absent)
        (expect (undo store op-id) :to-be :committed)
        (expect (disk-mode store "private") :to-be #o700)
        (expect (disk-mode store "private/nested") :to-be #o750)
        (expect (disk-mode store "private/nested/file") :to-be #o600)
        (expect (disk-text store "private/nested/file") :to-equal "data"))))

  (it "applies every action and reports before/after states and bytes"
    (with-temp-store (store)
      (put-file store "edit.txt" "old")
      (put-file store "gone.txt" "bye")
      (put-file store "mv.txt" "moving")
      (put-file store "exec.sh" "#!/bin/sh")
      (multiple-value-bind (status op-id results)
          (commit store (list (write-file-request "new/deep.txt" (bytes "fresh"))
                              (write-file-request "edit.txt" (bytes "new"))
                              (delete-request "gone.txt")
                              (move-request "mv.txt" "moved.txt")
                              (chmod-request "exec.sh" #o755)
                              (symlink-request "link" "edit.txt")))
        (expect status :to-be :committed)
        (expect (valid-op-id-p op-id) :to-be-truthy)
        (expect (actions results)
                :to-equal '(("new" :created) ("new/deep.txt" :created) ("edit.txt" :modified)
                            ("gone.txt" :deleted) ("moved.txt" :moved) ("exec.sh" :mode-changed)
                            ("link" :linked)))
        (let ((edit (find "edit.txt" results :key #'change-result-path :test #'string=)))
          (expect (octets-string (change-result-before-content edit)) :to-equal "old")
          (expect (octets-string (change-result-after-content edit)) :to-equal "new")
          (expect (change-result-hash-after edit)
                  :to-equal (aitools.kernel.domain:content-hash (bytes "new"))))
        (expect (change-result-from (find "moved.txt" results :key #'change-result-path :test #'string=))
                :to-equal "mv.txt"))
      (expect (disk-text store "new/deep.txt") :to-equal "fresh")
      (expect (disk-text store "edit.txt") :to-equal "new")
      (expect (disk-text store "gone.txt") :to-be :absent)
      (expect (disk-text store "mv.txt") :to-be :absent)
      (expect (disk-text store "moved.txt") :to-equal "moving")
      (expect (disk-mode store "exec.sh") :to-be #o755)
      (expect (entry-state-target (workspace-state store "link")) :to-equal "edit.txt")
      (expect (temp-files store) :to-equal '())
      (expect (intent-files store) :to-equal '())
      (expect (length (read-journal store)) :to-be 1)))

  (it "writes nothing and returns no op id for --dry-run"
    (with-temp-store (store)
      (put-file store "a.txt" "a")
      (multiple-value-bind (status op-id results) (commit store (list (write-file-request "a.txt" (bytes "b"))) :dry-run t)
        (expect status :to-be :committed)
        (expect op-id :to-be nil)
        (expect (actions results) :to-equal '(("a.txt" :modified))))
      (expect (disk-text store "a.txt") :to-equal "a")
      (expect (read-journal store) :to-equal '())))

  (it "returns no op and no journal entry when nothing changes"
    (with-temp-store (store)
      (put-file store "d/x" "x")
      (multiple-value-bind (status op-id results) (commit store (list (mkdir-request "d")))
        (expect status :to-be :committed)
        (expect op-id :to-be nil)
        (expect results :to-equal '()))
      (expect (read-journal store) :to-equal '())))

  (it "preserves :path and supplied optional rejection fields and writes nothing"
    (with-temp-store (store)
      (put-file store "a.txt" "a")
      (multiple-value-bind (status code message fields)
          (commit-changes/k store (list "edit")
                            (lambda (commit reject)
                              (declare (ignore commit))
                              (funcall reject "selection.no-match" "no match"
                                       :candidates (list "a.txt")
                                       :diagnostics nil
                                       :repairs (list "repair")
                                       :path "a.txt"))
                            :on-committed (lambda (&rest args) (declare (ignore args)) :committed)
                            :on-rejected (lambda (code message
                                                 &key (candidates nil candidates-p)
                                                   (diagnostics nil diagnostics-p)
                                                   (conflicts nil conflicts-p)
                                                   (repairs nil repairs-p)
                                                   (path nil path-p))
                                          (values :rejected code message
                                                  (list :candidates (list candidates-p candidates)
                                                        :diagnostics (list diagnostics-p diagnostics)
                                                        :conflicts (list conflicts-p conflicts)
                                                        :repairs (list repairs-p repairs)
                                                        :path (list path-p path))))
                            :on-busy (lambda () :busy))
        (expect status :to-be :rejected)
        (expect code :to-equal "selection.no-match")
        (expect message :to-equal "no match")
        (expect fields :to-equal
                (list :candidates (list t (list "a.txt"))
                      :diagnostics (list t nil)
                      :conflicts (list nil nil)
                      :repairs (list t (list "repair"))
                      :path (list t "a.txt"))))
      (expect (disk-text store "a.txt") :to-equal "a")))

  (it "rejects an I/O failure before the commit point as environment.io and leaves nothing"
    (with-temp-store (store)
      (put-file store "a.txt" "a")
      (let* ((io (store-io-port store))
             (failing (aitools.store.application::copy-store-io io :append-file (lambda (&rest args)
                                                       (declare (ignore args))
                                                       (error 'store-io-error :operation "write" :path "x"))))
             (broken (make-store failing (store-root store)
                                 (subseq (store-state-directory store) 0
                                         (position #\/ (store-state-directory store) :from-end t)))))
        (expect (nth-value 1 (commit broken (list (write-file-request "a.txt" (bytes "b"))))) :to-equal "environment.io"))
      (expect (disk-text store "a.txt") :to-equal "a")
      (expect (temp-files store) :to-equal '())
      (expect (intent-files store) :to-equal '())))

  (it "validates after the lock is held (TOCTOU)"
    ;; A fake adapter that rewrites the target at the moment the lock is
    ;; granted, i.e. just before validation would run. Validation must see
    ;; the rewritten content; a validate-then-lock implementation sees "v1".
    (with-temp-store (plain)
      (put-file plain "a.txt" "v1")
      (let* ((io (store-io-port plain))
             (real-try-lock (store-io-try-lock io))
             (mutating (aitools.store.application::copy-store-io io :try-lock (lambda (path &rest keys)
                                                     (let ((handle (apply real-try-lock path keys)))
                                                       (when handle (put-file plain "a.txt" "v2"))
                                                       handle))))
             (store (make-store mutating (store-root plain)
                                (subseq (store-state-directory plain) 0
                                        (position #\/ (store-state-directory plain) :from-end t))))
             (seen nil))
        (commit-changes/k store '("edit")
                          (lambda (commit reject)
                            (declare (ignore reject))
                            (setf seen (disk-text plain "a.txt"))
                            (funcall commit (list (write-file-request "a.txt" (bytes "v3")))))
                          :on-committed (lambda (&rest args) (declare (ignore args)))
                          :on-rejected (lambda (&rest args) (declare (ignore args)))
                          :on-busy (lambda ()))
        (expect seen :to-equal "v2")
        (expect (disk-text plain "a.txt") :to-equal "v3"))))

  (it "replaces a symlink itself rather than writing through it"
    (with-temp-store (store)
      (put-file store "real.txt" "r")
      (commit store (list (symlink-request "l" "real.txt")))
      (commit store (list (write-file-request "l" (bytes "replaced"))))
      (expect (entry-state-kind (workspace-state store "l")) :to-be :file)
      (expect (disk-text store "real.txt") :to-equal "r"))))

