(in-package #:aitools.integration.structure-test)

(describe "aitools structure test (store lock kit dependency)"
  (it "allows application boundary objects and keeps retry execution in infrastructure"
    (expect (symbol-allowed-p "store" :application "RESILIENCE-KIT" "MAKE-RETRY-POLICY")
            :to-be-truthy)
    (dolist (layer (list :application :infrastructure))
      (expect (member "CL-BOUNDARY-KIT"
                      (allowed-package-names "store" layer :core)
                      :test (function string=))
              :to-be-truthy))
    (expect (member "CL-BOUNDARY-KIT"
                    (allowed-package-names "store" :domain :core)
                    :test (function string=))
            :to-equal nil)
    (dolist (reference (list (list "RESILIENCE-KIT" "CALL-WITH-RETRY")
                             (list "RESILIENCE-KIT" "RETRY-EXHAUSTED")))
      (destructuring-bind (package symbol) reference
        (expect (symbol-allowed-p "store" :application package symbol) :to-equal nil)
        (expect (symbol-allowed-p "store" :domain package symbol) :to-equal nil)
        (expect (symbol-allowed-p "store" :infrastructure package symbol) :to-be-truthy)
        (expect (symbol-allowed-p "protocol" :application package symbol) :to-equal nil)))
    (expect (symbol-allowed-p "store" :application "OTHER-KIT" "CALL-WITH-RETRY")
            :to-equal nil)
    (expect (symbol-allowed-p "store" :application "RESILIENCE-KIT" "UNLISTED-RETRY")
            :to-equal nil))

  (it "blocks effectful boundary constructors from application"
    (dolist (reference (list (list "CL-BOUNDARY-KIT" "MAKE-CLOCK")
                             (list "CL-BOUNDARY-KIT" "MAKE-SLEEPER")))
      (destructuring-bind (package symbol) reference
        (expect (symbol-allowed-p "store" :application package symbol) :to-equal nil)
        (expect (symbol-allowed-p "store" :domain package symbol) :to-equal nil)
        (expect (application-effectful-boundary-symbol-p "store" :application package symbol)
                :to-be-truthy)))
    (expect (application-effectful-boundary-symbol-p
             "store" :application "CL-BOUNDARY-KIT" "CLOCK-NOW")
            :to-equal nil)
    (dolist (symbol *application-effectful-boundary-constructors*)
      (expect (application-effectful-boundary-symbol-p
               "store" :application "CL-BOUNDARY-KIT" symbol)
              :to-be-truthy))
    (let* ((relative "packages/feature/env/src/infrastructure/production-boundaries.lisp")
           (pathname (merge-pathnames relative (repository-root)))
           (violations (scan-file pathname relative "store" :application :core nil)))
      (dolist (symbol (list "MAKE-CLOCK" "MAKE-ENVIRONMENT"
                            "MAKE-FILESYSTEM" "MAKE-HOST-INFO"))
        (let ((expected (format nil
                                "CL-BOUNDARY-KIT:~A, which store/application may not depend on"
                                symbol)))
          (expect (not (null (some (lambda (violation) (search expected violation))
                                   violations)))
                  :to-equal t))))
    (uiop:with-temporary-file (:pathname pathname :type "lisp"
                               :stream stream :direction :output)
      (format stream
              "(defpackage #:aitools.store.application (:use #:cl #:cl-boundary-kit) (:import-from #:cl-boundary-kit #:make-filesystem))~%(in-package #:aitools.store.application)~%")
      (finish-output stream)
      (expect (scan-file pathname "fixture.lisp" "store" :application :core nil)
              :to-equal
              (list "fixture.lisp:1: :use CL-BOUNDARY-KIT imports effectful constructors into store/application"
                    "fixture.lisp:1: :import-from CL-BOUNDARY-KIT:MAKE-FILESYSTEM, which store/application may not depend on"))))

  (it "matches keyed coverage exclusions to current Store source forms"
    (let* ((root (repository-root))
           (baseline
             (with-open-file (stream (merge-pathnames "coverage-baselines/store.lisp" root))
               (let ((*read-eval* nil) (*package* (find-package "CL-USER")))
                 (read stream nil :eof))))
           (exclusions (getf baseline :coverage-exclusions))
           (expected-keys
             '((:branch "AITOOLS.STORE.APPLICATION" "%ARCHIVE-PREFIX-CURSOR")
               (:branch "aitools.store.application" "tx-status")
               (:branch "aitools.store.domain" "change-request")
               (:branch "aitools.store.domain" "change-result")
               (:branch "aitools.store.domain" "conflict")
               (:branch "aitools.store.domain" "entry-state")
               (:branch "aitools.store.domain" "intent-step")
               (:branch "aitools.store.domain" "tx-index")
               (:branch "aitools.store.domain" "tx-meta")
               (:branch "aitools.store.domain" "tx-op-record")
               (:expression "AITOOLS.STORE.APPLICATION" "COLLECT-GARBAGE")
               (:expression "AITOOLS.STORE.APPLICATION" "CALL-WITH-TEMP-DIR")
               (:expression "AITOOLS.STORE.APPLICATION" "RECOVER/K")
               (:expression "AITOOLS.STORE.APPLICATION" "TX-COMMIT/K")
               (:expression "AITOOLS.STORE.APPLICATION" "TX-DROP/K")
               (:expression "AITOOLS.STORE.APPLICATION" "TX-REBASE/K")
               (:expression "AITOOLS.STORE.APPLICATION" "TX-STAGE/K")
               (:expression "AITOOLS.STORE.APPLICATION" "%RUN-UNDER-TX-LOCKS")
               (:expression "AITOOLS.STORE.APPLICATION" "TX-BEGIN/K")
               (:expression "AITOOLS.STORE.APPLICATION" "TX-RECORD-READ/K")
               (:expression "AITOOLS.STORE.APPLICATION" "TX-ABORT/K")
               (:expression "AITOOLS.STORE.APPLICATION" "UNDO-OP/K")
               (:expression "AITOOLS.STORE.APPLICATION" "COMMIT-CHANGES/K")
               (:expression "aitools.store.domain" "CHANGES->JSON")
               (:expression "aitools.store.domain" "WRITE-RESULT-FIELDS")
               (:expression "aitools.store.domain" "%JSON-FIELD")
               (:expression "aitools.store.domain" "%JSON-LIST")
               (:expression "aitools.store.domain" "RETENTION-REMOVALS")
               (:expression "AITOOLS.STORE.INFRASTRUCTURE" "MAKE-POSIX-STORE-IO")
               (:expression "AITOOLS.STORE.INFRASTRUCTURE" "%OPEN-DIRECTORY-AT")))
           (current-package nil)
           (structures nil)
           (functions nil)
           (macros nil)
           (flows nil))
      (labels ((source-name (designator)
                 (cond ((symbolp designator) (string-downcase (symbol-name designator)))
                       ((stringp designator) (string-downcase designator))))
               (structure-name (form)
                 (let ((designator (second form)))
                   (source-name (if (consp designator) (first designator) designator))))
               (typed-slots (form)
                 (loop for slot in (cddr form)
                       when (and (consp slot)
                                 (symbolp (first slot))
                                 (loop for (key value) on (cddr slot) by #'cddr
                                       thereis (eq key :type)))
                         collect (string-downcase (symbol-name (first slot)))))
               (exclusion-key (exclusion)
                 (list (getf exclusion :kind)
                       (getf exclusion :package)
                       (getf exclusion :symbol)))
               (visit (form)
                 (cond
                   ((and (consp form) (eq (first form) 'in-package))
                    (setf current-package (source-name (second form))))
                   ((and (consp form) (eq (first form) 'defstruct))
                    (push (list current-package (structure-name form) (typed-slots form))
                          structures))
                   ((and (consp form) (eq (first form) 'defun))
                    (push (list current-package (source-name (second form))) functions))
                   ((and (consp form) (eq (first form) 'defmacro))
                    (push (list current-package (source-name (second form))) macros))
                   ((and (consp form) (symbolp (first form))
                         (string= (source-name (first form)) "define-flow"))
                    (push (list current-package (source-name (first (second form)))) flows))
                   ((and (consp form) (eq (first form) 'progn))
                    (dolist (subform (rest form)) (visit subform)))))
               (source-matches (definitions package symbol)
                 (remove-if-not
                  (lambda (definition)
                    (and (stringp package)
                         (stringp symbol)
                         (string= (source-name package) (first definition))
                         (string= (source-name symbol) (second definition))))
                  definitions))
               (valid-exclusion-p (exclusion)
                 (let* ((package (getf exclusion :package))
                        (symbol (getf exclusion :symbol))
                        (kind (getf exclusion :kind))
                        (reason (getf exclusion :reason))
                        (structure-matches (source-matches structures package symbol))
                        (function-matches (source-matches functions package symbol))
                        (macro-matches (source-matches macros package symbol))
                        (flow-matches (source-matches flows package symbol)))
                   (and (= (length exclusion) 8)
                        (or (eq kind :branch) (eq kind :expression))
                        (stringp package)
                        (stringp symbol)
                        (stringp reason)
                        (plusp (length reason))
                        (cond
                          ((eq kind :branch)
                           (and (= (length structure-matches) 1)
                                (third (first structure-matches))
                                (null function-matches)
                                (null macro-matches)
                                (null flow-matches)))
                          ((eq kind :expression)
                           (and (null structure-matches)
                                (= 1 (+ (length function-matches)
                                        (length macro-matches)
                                        (length flow-matches)))))))))
               (valid-exclusions-p (candidates)
                 (and (equal (mapcar #'exclusion-key candidates) expected-keys)
                      (= (length candidates)
                         (length (remove-duplicates (mapcar #'exclusion-key candidates)
                                                    :test #'equal)))
                      (every #'valid-exclusion-p candidates))))
        (dolist (pathname (directory (merge-pathnames "packages/core/store/src/**/*.lisp" root)))
          (with-open-file (stream pathname)
            (let ((*read-eval* nil) (*package* (find-package "CL-USER")))
              (setf current-package nil)
              (loop for form = (read stream nil :eof)
                    until (eq form :eof)
                    do (visit form)))))
        (expect (getf baseline :unreachable-branch-exclusions) :to-equal nil)
        (expect (getf baseline :uncovered-in-package-expressions) :to-equal nil)
        (expect exclusions :to-be-truthy)
        (expect (valid-exclusions-p exclusions) :to-be-truthy)
        (expect (valid-exclusion-p
                 '(:kind :branch :package "aitools.store.domain"
                   :symbol "stale-key" :reason "no current definition"))
                :to-equal nil)
        (expect (valid-exclusion-p
                 '(:kind :expression :package "aitools.store.domain"
                   :symbol "stale-expression" :reason "no current definition"))
                :to-equal nil)
        (let ((empty-reason (copy-list (first exclusions))))
          (setf (getf empty-reason :reason) "")
          (expect (valid-exclusion-p empty-reason) :to-equal nil))))))
