(in-package #:aitools.process.integration-test)
  (defun process-timeout-pid-alive-p (pid)
    (handler-case (progn (sb-posix:kill pid 0) t)
      (sb-posix:syscall-error () nil)))
  (defun process-timeout-group-alive-p (pid)
    (handler-case (progn (sb-posix:kill (- pid) 0) t)
      (sb-posix:syscall-error () nil)))
  (defun wait-for-timeout-pid-gone (pid &key (timeout-ms 3000))
    (loop with deadline = (+ (get-internal-real-time)
                             (floor (* timeout-ms internal-time-units-per-second) 1000))
          when (not (process-timeout-pid-alive-p pid)) return t
          when (>= (get-internal-real-time) deadline) return nil
          do (sleep 0.02)))
  (defun wait-for-timeout-group-gone (pid &key (timeout-ms 3000))
    (loop with deadline = (+ (get-internal-real-time)
                             (floor (* timeout-ms internal-time-units-per-second) 1000))
          when (not (process-timeout-group-alive-p pid)) return t
          when (>= (get-internal-real-time) deadline) return nil
          do (sleep 0.02)))
  (defun process-timeout-marker-pids (envelope)
  (let* ((lines (lines envelope "stdout" "head"))
         (group-line
           (find-if (lambda (line)
                      (and (>= (length line) 6)
                           (string= "group:" line :end2 6)))
                    lines))
         (child-line
           (find-if (lambda (line)
                      (and (>= (length line) 6)
                           (string= "child:" line :end2 6)))
                    lines))
         (group-pid (and group-line (parse-integer group-line :start 6)))
         (child-pid (and child-line (parse-integer child-line :start 6))))
    (values group-pid child-pid)))
  (defun process-timeout-cleanup (group-pid child-pid)
    (when (and group-pid (/= group-pid (sb-posix:getpgid 0)))
      (handler-case (sb-posix:kill (- group-pid) 9)
        (sb-posix:syscall-error () nil)))
    (when (and child-pid (process-timeout-pid-alive-p child-pid))
      (handler-case (sb-posix:kill child-pid 9)
        (sb-posix:syscall-error () nil)))
    (when child-pid
      (expect (wait-for-timeout-pid-gone child-pid) :to-be t))
    (when (and group-pid (/= group-pid (sb-posix:getpgid 0)))
      (expect (wait-for-timeout-group-gone group-pid) :to-be t)))
  (describe "aitools run timeout process group cleanup"
  (it "kills a descendant through the process-kit run path"
    (let ((group-pid nil)
          (child-pid nil))
      (unwind-protect
           (multiple-value-bind (code envelope)
               (invoke (list* "run" "--timeout" "1s" "--"
                             (sh "printf 'group:%s\\n' \"$$\"; sleep 5 & child=$!; printf 'child:%s\\n' \"$child\"; wait")))
             (multiple-value-setq (group-pid child-pid)
               (process-timeout-marker-pids envelope))
             (expect (integerp group-pid) :to-be t)
             (expect (integerp child-pid) :to-be t)
             (expect code :to-be 0)
             (expect (value envelope "timed_out") :to-be t)
             (expect (/= group-pid (sb-posix:getpgid 0)) :to-be t)
             (expect (value envelope "duration_ms") :to-be-less-than 3000)
             (expect (wait-for-timeout-pid-gone child-pid) :to-be t)
             (expect (wait-for-timeout-group-gone group-pid) :to-be t))
        (process-timeout-cleanup group-pid child-pid))))
  (it "kills a descendant through the stream-input spawn path"
    (let* ((producer (sb-ext:run-program (program-on-path "sleep") '("20")
                                         :output :stream :wait nil))
           (group-pid nil)
           (child-pid nil))
      (unwind-protect
           (let ((*standard-input* (sb-ext:process-output producer)))
             (multiple-value-bind (code envelope)
                 (invoke (list* "run" "--stdin" "--timeout" "1s" "--"
                               (sh "printf 'group:%s\\n' \"$$\"; sleep 5 & child=$!; printf 'child:%s\\n' \"$child\"; wait")))
               (multiple-value-setq (group-pid child-pid)
                 (process-timeout-marker-pids envelope))
               (expect (integerp group-pid) :to-be t)
               (expect (integerp child-pid) :to-be t)
               (expect code :to-be 0)
               (expect (value envelope "timed_out") :to-be t)
               (expect (/= group-pid (sb-posix:getpgid 0)) :to-be t)
               (expect (value envelope "duration_ms") :to-be-less-than 3000)
               (expect (wait-for-timeout-pid-gone child-pid) :to-be t)
               (expect (wait-for-timeout-group-gone group-pid) :to-be t)))
        (unwind-protect
             (process-timeout-cleanup group-pid child-pid)
          (sb-ext:process-kill producer 9)
          (sb-ext:process-wait producer)
          (sb-ext:process-close producer))))))

