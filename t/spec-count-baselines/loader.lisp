(in-package #:aitools/test)
(defparameter *context-spec-count-baselines* nil)
(defparameter *all-minimum-executed-specs* 0)
(defun %valid-context-spec-count-baseline-p (context baseline)
  (and (listp baseline) (evenp (length baseline))
       (let* ((keys (loop for tail on baseline by (function cddr)
                          collect (car tail)))
              (linux (getf baseline :linux-specs))
              (darwin (getf baseline :darwin-specs))
              (minimum (getf baseline :minimum-executed-specs))
              (reason (getf baseline :reason)))
         (and (= (length (remove-duplicates keys :test (function eq)))
                 (length keys))
              (= (getf baseline :schema-version 0) 1)
              (eq (getf baseline :context) context)
              (integerp linux) (plusp linux)
              (integerp darwin) (plusp darwin)
              (integerp minimum) (= minimum (min linux darwin))
              (stringp reason) (plusp (length reason))
              (eq (getf baseline :source) :successful-linux-and-darwin-ci-runs)
              (stringp (getf baseline :run-id))
              (integerp (getf baseline :linux-job-id))
              (integerp (getf baseline :darwin-job-id))
              (stringp (getf baseline :revision))))))
(defun %read-context-spec-count-baseline (pathname)
  (let* ((context (intern (string-upcase (pathname-name pathname)) :keyword))
         (*read-eval* nil))
    (with-open-file (stream pathname)
      (let ((baseline (read stream nil :eof)))
        (unless (%valid-context-spec-count-baseline-p context baseline)
          (error "Invalid ~A executed-spec baseline: ~S" context baseline))
        (unless (eq (read stream nil :eof) :eof)
          (error "Executed-spec baseline contains trailing data: ~A" pathname))
        (cons context baseline)))))
(defun %load-context-spec-count-baselines ()
  (let* ((source (asdf:system-source-directory "aitools/test/base"))
         (directory (merge-pathnames "t/spec-count-baselines/" source))
         (pathnames
          (sort (remove-if (lambda (pathname)
                             (string-equal (pathname-name pathname) "loader"))
                           (directory (merge-pathnames "*.lisp" directory)))
                #'string< :key #'namestring))
         (baselines (mapcar #'%read-context-spec-count-baseline pathnames)))
    (unless baselines
      (error "No context executed-spec baselines were found in ~A" directory))
    (unless (= (length baselines)
               (length (remove-duplicates (mapcar #'car baselines) :test #'eq)))
      (error "Context executed-spec baselines contain duplicate contexts"))
    (unless (assoc :shared baselines)
      (error "The shared executed-spec baseline is missing"))
    baselines))
(setf *context-spec-count-baselines* (%load-context-spec-count-baselines))
(setf *all-minimum-executed-specs*
      (loop for entry in *context-spec-count-baselines*
            sum (getf (cdr entry) :minimum-executed-specs)))
(defun %context-baseline-name (context)
  (etypecase context
    (string (string-downcase context))
    (symbol (string-downcase (symbol-name context)))))
(defun %minimum-executed-specs-for-context (&optional (context (uiop:getenv "AITOOLS_TEST_CONTEXT")))
  (if (null context)
      *all-minimum-executed-specs*
    (let* ((name (%context-baseline-name context))
           (entry
            (find name *context-spec-count-baselines*
                  :key (lambda (item)
                         (string-downcase (symbol-name (car item))))
                  :test #'string=)))
      (unless entry
        (error "No executed-spec floor is configured for context ~S" context))
      (when (eq (car entry) :shared)
        (error "The shared executed-spec floor applies only to the full suite"))
      (getf (cdr entry) :minimum-executed-specs))))
(setf *minimum-executed-specs* (%minimum-executed-specs-for-context))
(defun %test-context-from-system-name (name)
  (let ((prefix "aitools/test/"))
    (when (and (stringp name) (> (length name) (length prefix))
               (string= prefix name :end2 (length prefix)))
      (let ((context (string-downcase (subseq name (length prefix)))))
        (unless (or (string= context "base") (string= context "shared"))
          context)))))
(defun %context-test-system-problems-for (system-names)
  (when system-names
    (let* ((floored
            (mapcar (lambda (entry)
                      (string-downcase (symbol-name (car entry))))
                    (remove-if (lambda (entry)
                                 (eq (car entry) :shared))
                               *context-spec-count-baselines*)))
           (registered
            (remove-duplicates
             (remove nil (mapcar #'%test-context-from-system-name system-names))
             :test #'string=))
           (problems nil))
      (dolist (context floored)
        (unless (member context registered :test (function string=))
          (push (format nil "context ~A has a floor but no registered test system" context)
                problems)))
      (dolist (context registered)
        (unless (member context floored :test #'string=)
          (push (format nil "context ~A has a registered test system but no floor" context)
                problems)))
      (nreverse problems))))
(defun %registered-context-test-system-names ()
  (remove nil (mapcar (lambda (name)
                        (when (%test-context-from-system-name name) name))
                      (asdf:registered-systems))))
(defun %validate-context-test-systems (&optional context)
  (let* ((systems (%registered-context-test-system-names))
         (problems (%context-test-system-problems-for systems)))
    (when context
      (let ((name (%context-baseline-name context)))
        (%minimum-executed-specs-for-context context)
        (unless (member (format nil "aitools/test/~A" name) systems :test #'string=)
          (push (format nil "selected context ~A has no registered test system" name)
                problems))))
    (when problems
      (error "Inconsistent context test systems: ~{~A~^; ~}" (nreverse problems)))
    t))
