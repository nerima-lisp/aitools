(in-package #:aitools.integration.cps-contract-test)

(defun %positional-parameters (lambda-list)
  (let ((section :required)
        (position 0)
        (parameters '()))
    (dolist (parameter lambda-list)
      (cond
        ((and (symbolp parameter)
              (string= (symbol-name parameter) "&OPTIONAL"))
         (setf section :optional))
        ((and (symbolp parameter)
              (> (length (symbol-name parameter)) 0)
              (char= (char (symbol-name parameter) 0) #\&))
         (setf section :other))
        ((member section '(:required :optional))
         (let ((variable (%parameter-variable parameter)))
           (incf position)
           (when (symbolp variable)
             (push (list variable position) parameters))))))
    (nreverse parameters)))

(defun %proper-list-length (form)
  (labels ((count-tail (tail length)
             (cond
               ((null tail) length)
               ((consp tail) (count-tail (cdr tail) (1+ length)))
               (t nil))))
    (count-tail form 0)))

(defun %lambda-list-variables (lambda-list)
  (let ((variables '()))
    (dolist (parameter lambda-list)
      (unless (and (symbolp parameter)
                   (> (length (symbol-name parameter)) 0)
                   (char= (char (symbol-name parameter) 0) #\&))
        (let ((variable (%parameter-variable parameter)))
          (when (symbolp variable)
            (pushnew variable variables :test #'eq)))))
    (nreverse variables)))

(defun %without-bound-symbols (active lambda-list)
  (let ((bound (%lambda-list-variables lambda-list)))
    (remove-if
     (lambda (entry)
       (member (if (consp entry) (car entry) entry) bound :test #'eq))
     active)))

(defun %function-argument-shape (argument)
  (cond
    ((%operator-name-p argument "LAMBDA") '(:lambda))
    ((%operator-name-p argument "FUNCTION")
     (let ((designator (second argument)))
       (cond
         ((symbolp designator)
          (list :function-designator (%function-name-string designator)))
         ((%operator-name-p designator "LAMBDA") '(:lambda))
         (t :dynamic))))
    ((%operator-name-p argument "QUOTE")
     (let ((designator (second argument)))
       (if (symbolp designator)
           (list :function-designator (%function-name-string designator))
           :dynamic)))
    (t :dynamic)))
