(in-package #:cl-user)

(in-package #:aitools.integration.cps-contract-test)

(defun %on-name-p (symbol)
  (and (symbolp symbol)
       (let ((name (symbol-name symbol)))
         (and (> (length name) 3)
              (string-equal name "ON-" :end1 3)))))

(defun %key-parameter (parameter)
  (let* ((key-and-variable (if (consp parameter) (first parameter) parameter))
         (explicit-p (consp key-and-variable))
         (key (if explicit-p (first key-and-variable) key-and-variable))
         (variable (if explicit-p (second key-and-variable) key-and-variable)))
    (values key variable)))

(defun %continuation-variables (lambda-list)
  (let ((section :required)
        (variables '()))
    (dolist (parameter lambda-list)
      (cond
        ((and (symbolp parameter) (string= (symbol-name parameter) "&KEY"))
         (setf section :key))
        ((and (symbolp parameter)
              (> (length (symbol-name parameter)) 0)
              (char= (char (symbol-name parameter) 0) #\&))
         (unless (member (symbol-name parameter) '("&OPTIONAL" "&REST" "&AUX") :test #'string=)
           (setf section :other)))
        ((eq section :key)
         (multiple-value-bind (key variable) (%key-parameter parameter)
           (when (or (%on-name-p key) (%on-name-p variable))
             (when (symbolp variable)
               (pushnew (string-upcase (symbol-name variable)) variables :test #'string=)))))
        ((eq section :other) nil)))
    (nreverse variables)))

(defun %parameter-variable (parameter)
  (let ((first (if (consp parameter) (first parameter) parameter)))
    (if (consp first) (second first) first)))

(defun %lambda-list-variable-names (lambda-list)
  (let ((variables '()))
    (dolist (parameter lambda-list)
      (unless (and (symbolp parameter)
                   (> (length (symbol-name parameter)) 0)
                   (char= (char (symbol-name parameter) 0) #\&))
        (let ((variable (%parameter-variable parameter)))
          (when (symbolp variable)
            (pushnew (string-upcase (symbol-name variable)) variables :test #'string=)))))
    (nreverse variables)))

(defun %without-variable-names (active variables)
  (let ((bound (remove nil (mapcar (lambda (variable)
                                     (and (symbolp variable)
                                          (string-upcase (symbol-name variable))))
                                   variables))))
    (remove-if (lambda (name) (member name bound :test #'string=)) active)))

(defun %function-name-string (name)
  (let ((symbol (if (symbolp name)
                    name
                    (and (consp name)
                         (eq (first name) (find-symbol "SETF" "COMMON-LISP"))
                         (second name)))))
    (and (symbolp symbol)
         (string-upcase (symbol-name symbol)))))

(defun %slash-k-name-p (name)
  (and (stringp name)
       (>= (length name) 2)
       (string-equal name "/K" :start1 (- (length name) 2))))

(defun %top-level-definitions (form)
  ;; Recurse only through forms whose bodies may contain top-level definitions.
  (cond
    ((%operator-name-p form "DEFUN") (list form))
    ((%operator-name-p form "DEFINE-FLOW") (list form))
    ((%operator-name-p form "DEFINE-WRITE-COMMAND") (list form))
    ((%operator-name-p form "PROGN")
     (mapcan #'%top-level-definitions (cdr form)))
    ((%operator-name-p form "EVAL-WHEN")
     (mapcan #'%top-level-definitions (cddr form)))
    ((%operator-name-p form "LOCALLY")
     (mapcan #'%top-level-definitions (cdr form)))
    (t nil)))

(defun %continuation-reference-p (form variables)
  (labels ((walk (item)
             (cond
               ((and (symbolp item)
                     (not (keywordp item))
                     (member (string-upcase (symbol-name item)) variables :test #'string=))
                t)
               ((consp item)
                (cond
                  ((%operator-name-p item "QUOTE") nil)
                  ((and (%operator-name-p item "FUNCTION")
                        (symbolp (second item)))
                   nil)
                  (t (walk-list item))))
               (t nil)))
           (walk-list (tail)
             (if (consp tail)
                 (or (walk (car tail))
                     (walk-list (cdr tail)))
                 (walk tail))))
    (walk form)))

(defun %flow-body-kinds (body variables)
  (let ((return-from-p nil)
        (positional-continuation-p nil)
        (apply-continuation-p nil))
    (labels ((without-bound-variables (active lambda-list)
               (%without-variable-names active (%lambda-list-variable-names lambda-list)))
             (walk (form active &optional ignore-continuations)
               (when (and (not ignore-continuations)
                          (symbolp form)
                          (not (keywordp form))
                          (member (string-upcase (symbol-name form)) active :test #'string=))
                 (setf positional-continuation-p t))
               (when (consp form)
                 (cond
                   ((%operator-name-p form "QUOTE") nil)
                   ((%operator-name-p form "DECLARE") nil)
                   ((%operator-name-p form "RETURN-FROM")
                    (setf return-from-p t)
                    (dolist (item (cdr form)) (walk item active ignore-continuations)))
                   ((%operator-name-p form "APPLY")
                    (let* ((function-designator (second form))
                           (continuation-callback-p
                             (and (symbolp function-designator)
                                  (%continuation-reference-p function-designator active))))
                      (when continuation-callback-p
                        (setf apply-continuation-p t))
                      (walk function-designator active
                            (or continuation-callback-p ignore-continuations))
                      (dolist (item (cddr form)) (walk item active ignore-continuations))))
                   ((%operator-name-p form "LAMBDA")
                    (let ((inner-active (without-bound-variables active (second form))))
                      (dolist (item (cddr form)) (walk item inner-active ignore-continuations))))
                   ((and (%operator-name-p form "FUNCTION")
                         (symbolp (second form))) nil)
                   ((or (%operator-name-p form "LET") (%operator-name-p form "LET*"))
                    (let* ((bindings (second form))
                           (bound (mapcar (lambda (binding)
                                            (%parameter-variable binding))
                                          bindings)))
                      (if (%operator-name-p form "LET*")
                          (let ((visible active))
                            (dolist (binding bindings)
                              (when (consp binding)
                                (walk (second binding) visible ignore-continuations))
                              (setf visible
                                    (%without-variable-names
                                     visible (list (%parameter-variable binding)))))
                            (dolist (item (cddr form)) (walk item visible ignore-continuations)))
                          (progn
                            (dolist (binding bindings)
                              (when (consp binding)
                                (walk (second binding) active ignore-continuations)))
                            (let ((inner-active (%without-variable-names active bound)))
                              (dolist (item (cddr form))
                                (walk item inner-active ignore-continuations)))))))
                   ((%operator-name-p form "FLOW-CALL")
                    (walk (second form) active ignore-continuations)
                    (dolist (clause (cddr form))
                      (if (and (consp clause) (consp (second clause)))
                          (let ((inner-active (without-bound-variables active (second clause))))
                            (dolist (item (cddr clause)) (walk item inner-active ignore-continuations)))
                          (walk clause active ignore-continuations))))
                   (t
                    (when (and (not ignore-continuations)
                               (%continuation-reference-p form active))
                      (setf positional-continuation-p t))
                    (do ((tail form (cdr tail)))
                        ((atom tail)
                         (when tail
                           (walk tail active ignore-continuations)))
                      (walk (car tail) active ignore-continuations)))))))
      (dolist (form body) (walk form variables)))
    (append (and return-from-p (list :return-from))
            (and positional-continuation-p (list :positional-continuation))
            (and apply-continuation-p (list :apply-continuation)))))

(defun %definition-violations (form relative-path package-name)
  (let* ((name (%function-name-string (second form)))
         (symbol (second form))
         (symbol-package (and (symbolp symbol) (symbol-package symbol))))
    (append (and (%slash-k-name-p name)
                 ;; This adapter converts whichever flow callback fires into
                 ;; COMMAND-RESULT at the command boundary.
                 (not (and (string= relative-path "packages/core/protocol/src/application/command-result.lisp")
                           (equal package-name "AITOOLS.PROTOCOL.APPLICATION")
                           (eq symbol-package (find-package "AITOOLS.PROTOCOL.APPLICATION"))
                           (string= name "CALL-WITH-COMMAND-RESULT/K")
                           (symbolp symbol)
                           (string= (symbol-name symbol) "CALL-WITH-COMMAND-RESULT/K")))
                 (list (list relative-path name :slash-k-defun)))
            (and (%continuation-variables (third form))
                 (list (list relative-path name :on-key-defun))))))

(defun %flow-violations (form relative-path)
  (let* ((lambda-list (second form))
         (name (%function-name-string (first lambda-list)))
         (variables (%continuation-variables (rest lambda-list))))
    (mapcar (lambda (kind) (list relative-path name kind)) (%flow-body-kinds (cddr form) variables))))

(defun %fixture-violations (text &optional (relative-path "fixture.lisp"))
  (append (%source-violations text relative-path)
          (mapcar (lambda (record)
                    (list (getf record :definition-path)
                          (getf record :symbol)
                          :positional-continuation-defun))
                  (%fixture-positional-continuation-inventory text relative-path))))

(defun repository-root ()
  (asdf:system-source-directory "aitools"))
