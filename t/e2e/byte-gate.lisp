;;;; t/e2e/byte-gate.lisp
(in-package #:aitools.e2e.test)

(defparameter +byte-gate-allowed-determinism-drop+ 0.0)
(defparameter +byte-gate-baseline-revision+ "5ab1f7621dfd356f43213964b16bc1b223c8a640")

(defstruct byte-gate-record
  key case-id invocation exit-code stdout stderr)

(defun byte-gate-blob-name-p (name suffix)
  (and (stringp name)
       (= (length name) (+ 8 (length suffix)))
       (every (lambda (char) (char<= #\0 char #\9)) (subseq name 0 8))
       (string= suffix name :start2 8)))

(defun byte-gate-read-blob (root name suffix expected-length)
  (unless (byte-gate-blob-name-p name suffix)
    (error "invalid byte-gate blob reference ~S" name))
  (let* ((path (merge-pathnames name root))
         (mode (sb-posix:stat-mode (sb-posix:lstat (native path))))
         (resolved (progn
                     (unless (= (logand mode #o170000) #o100000)
                       (error "byte-gate blob is not a regular file"))
                     (truename path)))
         (root-name (native (truename root)))
         (path-name (native resolved))
         (root-prefix (if (and (plusp (length root-name))
                               (char= (char root-name (1- (length root-name))) #\/))
                          root-name
                          (concatenate 'string root-name "/")))
         (prefix-length (length root-prefix)))
    (unless (and (< prefix-length (length path-name))
                 (string= root-prefix path-name :end2 prefix-length))
      (error "byte-gate blob escaped its capture directory"))
    (with-open-file (stream resolved :element-type '(unsigned-byte 8))
      (let* ((size (file-length stream))
             (octets (make-array size :element-type '(unsigned-byte 8)))
             (count (read-sequence octets stream)))
        (unless (and (= count size) (= count expected-length))
          (error "byte-gate blob length mismatch for ~A" name))
        octets))))

(defun byte-gate-read-capture (directory)
  (let* ((root (truename (uiop:ensure-directory-pathname directory)))
         (manifest (merge-pathnames "records.jsonl" root))
         (records (make-hash-table :test #'equal)))
    (unless (probe-file manifest)
      (error "byte-gate capture has no records.jsonl"))
    (with-open-file (stream manifest :direction :input :external-format :utf-8)
      (loop for line = (read-line stream nil nil)
            while line
            for object = (json-kit:parse line :false-value nil :null-value nil)
            for case-id = (gethash "case_id" object)
            for invocation = (gethash "invocation" object)
            for exit-code = (gethash "exit_code" object)
            for stdout-name = (gethash "stdout_file" object)
            for stderr-name = (gethash "stderr_file" object)
            for stdout-length = (gethash "stdout_length" object)
            for stderr-length = (gethash "stderr_length" object)
            for key = (list case-id invocation)
            do (unless (and (hash-table-p object)
                            (stringp case-id) (plusp (length case-id))
                            (integerp invocation) (plusp invocation)
                            (integerp exit-code)
                            (integerp stdout-length) (not (minusp stdout-length))
                            (integerp stderr-length) (not (minusp stderr-length)))
                 (error "invalid byte-gate manifest record"))
               (when (gethash key records)
                 (error "duplicate byte-gate invocation ID ~S" key))
               (unless (and (byte-gate-blob-name-p stdout-name ".stdout.bin")
                            (byte-gate-blob-name-p stderr-name ".stderr.bin")
                            (string= stdout-name stderr-name
                                     :end1 8 :end2 8))
                 (error "invalid byte-gate stream blob references for ~S" key))
               (setf (gethash key records)
                     (make-byte-gate-record
                      :key key :case-id case-id :invocation invocation :exit-code exit-code
                      :stdout (byte-gate-read-blob root stdout-name ".stdout.bin" stdout-length)
                      :stderr (byte-gate-read-blob root stderr-name ".stderr.bin" stderr-length)))))
    (when (zerop (hash-table-count records))
      (error "byte-gate capture is empty"))
    records))

(defun byte-gate-record-ids (records)
  (sort (loop for key being the hash-keys of records collect key)
        (lambda (left right)
          (or (string< (first left) (first right))
              (and (string= (first left) (first right))
                   (< (second left) (second right)))))))
(defun byte-gate-validate-ids (ids)
  (let ((count (handler-case (list-length ids)
                 (type-error () nil))))
    (unless (and count (plusp count))
      (error "expected invocation inventory must be a non-empty proper list"))
    (let ((seen (make-hash-table :test #'equal)))
      (dolist (id ids)
        (unless (and (consp id)
                     (stringp (first id))
                     (plusp (length (first id)))
                     (consp (rest id))
                     (integerp (second id))
                     (plusp (second id))
                     (null (cddr id)))
          (error "invalid expected byte-gate invocation ID"))
        (when (gethash id seen)
          (error "duplicate expected byte-gate invocation ID ~S" id))
        (setf (gethash id seen) t)))
    (sort (copy-list ids)
          (lambda (left right)
            (or (string< (first left) (first right))
                (and (string= (first left) (first right))
                     (< (second left) (second right))))))))

