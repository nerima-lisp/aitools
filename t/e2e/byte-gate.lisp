;;;; t/e2e/byte-gate.lisp
(in-package #:aitools.e2e.test)

(defparameter +byte-gate-allowed-determinism-drop+ 0.0)

(defstruct byte-gate-record
  key case-id invocation exit-code stdout stderr)

(defun byte-gate-blob-name-p (name suffix)
  (and (stringp name)
       (= (length name) (+ 8 (length suffix)))
       (every (lambda (char) (char<= #\0 char #\9)) (subseq name 0 8))
       (string= name suffix :start2 8)))

(defun byte-gate-read-blob (root name suffix expected-length)
  (unless (byte-gate-blob-name-p name suffix)
    (error "invalid byte-gate blob reference ~S" name))
  (let* ((path (merge-pathnames name root))
         (mode (sb-posix:stat-mode (sb-posix:lstat (native path))))
         (resolved (progn
                     (unless (= (logand mode #o170000) #o100000)
                       (error "byte-gate blob is not a regular file"))
                     (truename path)))
         (root-name (native (truename root)))
         (path-name (native resolved))
         (root-prefix (if (and (plusp (length root-name))
                               (char= (char root-name (1- (length root-name))) #\/))
                          root-name
                          (concatenate 'string root-name "/")))
         (prefix-length (length root-prefix)))
    (unless (and (< prefix-length (length path-name))
                 (string= root-prefix path-name :end2 prefix-length))
      (error "byte-gate blob escaped its capture directory"))
    (with-open-file (stream resolved :element-type '(unsigned-byte 8))
      (let* ((size (file-length stream))
             (octets (make-array size :element-type '(unsigned-byte 8)))
             (count (read-sequence octets stream)))
        (unless (and (= count size) (= count expected-length))
          (error "byte-gate blob length mismatch for ~A" name))
        octets))))

(defun byte-gate-read-capture (directory)
  (let* ((root (truename (uiop:ensure-directory-pathname directory)))
         (manifest (merge-pathnames "records.jsonl" root))
         (records (make-hash-table :test #'equal)))
    (unless (probe-file manifest)
      (error "byte-gate capture has no records.jsonl"))
    (with-open-file (stream manifest :direction :input :external-format :utf-8)
      (loop for line = (read-line stream nil nil)
            while line
            for object = (json-kit:parse line :false-value nil :null-value nil)
            for case-id = (gethash "case_id" object)
            for invocation = (gethash "invocation" object)
            for exit-code = (gethash "exit_code" object)
            for stdout-name = (gethash "stdout_file" object)
            for stderr-name = (gethash "stderr_file" object)
            for stdout-length = (gethash "stdout_length" object)
            for stderr-length = (gethash "stderr_length" object)
            for key = (list case-id invocation)
            do (unless (and (hash-table-p object)
                            (stringp case-id) (plusp (length case-id))
                            (integerp invocation) (plusp invocation)
                            (integerp exit-code)
                            (integerp stdout-length) (not (minusp stdout-length))
                            (integerp stderr-length) (not (minusp stderr-length)))
                 (error "invalid byte-gate manifest record"))
               (when (gethash key records)
                 (error "duplicate byte-gate invocation ID ~S" key))
               (unless (and (byte-gate-blob-name-p stdout-name ".stdout.bin")
                            (byte-gate-blob-name-p stderr-name ".stderr.bin")
                            (string= stdout-name stderr-name
                                     :end1 8 :end2 8))
                 (error "invalid byte-gate stream blob references for ~S" key))
               (setf (gethash key records)
                     (make-byte-gate-record
                      :key key :case-id case-id :invocation invocation :exit-code exit-code
                      :stdout (byte-gate-read-blob root stdout-name ".stdout.bin" stdout-length)
                      :stderr (byte-gate-read-blob root stderr-name ".stderr.bin" stderr-length)))))
    (when (zerop (hash-table-count records))
      (error "byte-gate capture is empty"))
    records))

(defun byte-gate-record-ids (records)
  (sort (loop for key being the hash-keys of records collect key)
        (lambda (left right)
          (or (string< (first left) (first right))
              (and (string= (first left) (first right))
                   (< (second left) (second right)))))))
(defun byte-gate-validate-ids (ids)
  (let ((count (handler-case (list-length ids)
                 (type-error () nil))))
    (unless (and count (plusp count))
      (error "expected invocation inventory must be a non-empty proper list"))
    (let ((seen (make-hash-table :test #'equal)))
      (dolist (id ids)
        (unless (and (consp id)
                     (stringp (first id))
                     (plusp (length (first id)))
                     (consp (rest id))
                     (integerp (second id))
                     (plusp (second id))
                     (null (cddr id)))
          (error "invalid expected byte-gate invocation ID"))
        (when (gethash id seen)
          (error "duplicate expected byte-gate invocation ID ~S" id))
        (setf (gethash id seen) t)))
    (sort (copy-list ids)
          (lambda (left right)
            (or (string< (first left) (first right))
                (and (string= (first left) (first right))
                     (< (second left) (second right))))))))

(defun byte-gate-read-expected-inventory (pathname)
  (with-open-file (stream pathname :direction :input :external-format :utf-8)
    (let* ((*read-eval* nil)
           (inventory (read stream nil :eof)))
      (when (eq inventory :eof)
        (error "expected invocation inventory is empty"))
      (unless (eq (read stream nil :eof) :eof)
        (error "expected invocation inventory must contain one form"))
      (byte-gate-validate-ids inventory))))

(defun byte-gate-same-output-p (left right)
  (and (= (byte-gate-record-exit-code left) (byte-gate-record-exit-code right))
       (equalp (byte-gate-record-stdout left) (byte-gate-record-stdout right))
       (equalp (byte-gate-record-stderr left) (byte-gate-record-stderr right))))

(defun byte-gate-deterministic-ids (first second ids)
  (remove-if-not (lambda (id)
                   (byte-gate-same-output-p (gethash id first) (gethash id second)))
                 ids))

(defun byte-gate-id-label (id)
  (format nil "~A#~D" (first id) (second id)))

(defun byte-gate-report-value (report)
  (json-kit:alist->json-object
   (list (cons "passed" (if (getf report :passed) t json-kit:+json-false+))
         (cons "expected_invocation_count" (getf report :expected-invocation-count))
         (cons "baseline_deterministic_count" (getf report :baseline-deterministic-count))
         (cons "baseline_invocation_count" (getf report :baseline-invocation-count))
         (cons "candidate_deterministic_count" (getf report :candidate-deterministic-count))
         (cons "candidate_invocation_count" (getf report :candidate-invocation-count))
         (cons "allowed_determinism_drop" (getf report :allowed-determinism-drop))
         (cons "baseline_nondeterministic" (getf report :baseline-nondeterministic))
         (cons "candidate_nondeterministic" (getf report :candidate-nondeterministic))
         (cons "byte_mismatches" (getf report :byte-mismatches))
         (cons "failure_reasons" (getf report :failure-reasons)))))

(defun byte-gate-nondeterministic-entries (ids deterministic reason)
  (loop for id in ids
        unless (member id deterministic :test #'equal)
          collect (json-kit:alist->json-object
                   (list (cons "case_id" (first id))
                         (cons "invocation" (second id))
                         (cons "reason" reason)))))

(defun byte-gate-mismatch-entries (mismatches)
  (mapcar (lambda (mismatch)
            (json-kit:alist->json-object
             (list (cons "invocation_id" (first mismatch))
                   (cons "candidate_run" (second mismatch)))))
          mismatches))

(defun byte-gate-write-report (report pathname)
  (ensure-directories-exist pathname)
  (with-open-file (stream pathname :direction :output :if-exists :error
                                   :if-does-not-exist :create :external-format :utf-8)
    (write-string (json-kit:stringify (byte-gate-report-value report)) stream)
    (terpri stream))
  pathname)

(defun compare-e2e-byte-captures (baseline-first baseline-second candidate-first candidate-second
                                  &key (expected-ids nil expected-ids-p) report-path)
  (unless expected-ids-p
    (error "byte-gate comparison requires the fixed expected invocation inventory"))
  (let* ((ids (byte-gate-validate-ids expected-ids))
         (captures (let ((captures (list (byte-gate-read-capture baseline-first)
                                         (byte-gate-read-capture baseline-second)
                                         (byte-gate-read-capture candidate-first)
                                         (byte-gate-read-capture candidate-second))))
                     (loop for capture in captures
                           for capture-number from 1
                           unless (equal ids (byte-gate-record-ids capture))
                             do (error "byte-gate capture ~D does not match the expected invocation inventory"
                                       capture-number))
                     captures))
         (baseline-a (first captures))
         (baseline-b (second captures))
         (candidate-a (third captures))
         (candidate-b (fourth captures))
         (deterministic-baseline (byte-gate-deterministic-ids baseline-a baseline-b ids))
         (deterministic-candidate (byte-gate-deterministic-ids candidate-a candidate-b ids))
         (mismatches '())
         (failures '()))
    (when (null deterministic-baseline)
      (push "baseline has no deterministic invocation" failures))
    (when (null deterministic-candidate)
      (push "candidate has no deterministic invocation" failures))
    (dolist (id deterministic-baseline)
      (unless (byte-gate-same-output-p (gethash id baseline-a) (gethash id candidate-a))
        (push (list (byte-gate-id-label id) "candidate-first") mismatches))
      (unless (byte-gate-same-output-p (gethash id baseline-a) (gethash id candidate-b))
        (push (list (byte-gate-id-label id) "candidate-second") mismatches)))
    (when mismatches
      (push "deterministic baseline bytes or exit status changed" failures))
    (let* ((baseline-rate (/ (length deterministic-baseline) (length ids)))
           (candidate-rate (/ (length deterministic-candidate) (length ids)))
           (drop (- baseline-rate candidate-rate)))
      (when (> drop +byte-gate-allowed-determinism-drop+)
        (push "candidate determinism rate fell beyond the configured allowance" failures))
      (let ((report
              (list :passed (null failures)
                    :expected-invocation-count (length ids)
                    :baseline-deterministic-count (length deterministic-baseline)
                    :baseline-invocation-count (length ids)
                    :candidate-deterministic-count (length deterministic-candidate)
                    :candidate-invocation-count (length ids)
                    :allowed-determinism-drop
                    (princ-to-string +byte-gate-allowed-determinism-drop+)
                    :baseline-nondeterministic
                    (byte-gate-nondeterministic-entries
                     ids deterministic-baseline
                     "stdout, stderr, or exit status differed across the baseline pair; reason not identified")
                    :candidate-nondeterministic
                    (byte-gate-nondeterministic-entries
                     ids deterministic-candidate
                     "stdout, stderr, or exit status differed across the candidate pair; reason not identified")
                    :byte-mismatches (byte-gate-mismatch-entries (nreverse mismatches))
                    :failure-reasons (nreverse failures))))
        (when report-path
          (byte-gate-write-report report report-path))
        (unless (getf report :passed)
          (error "E2E byte gate failed: ~{~A~^; ~}" (getf report :failure-reasons)))
        report))))
