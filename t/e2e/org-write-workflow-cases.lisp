(in-package #:aitools.e2e.test)

(describe "aitools e2e org write workflows"
  (define-org-case ("org tx dry-run plans against the staged overlay without changing it" ws)
    (let* ((original (format nil "* TODO Build :work:~%"))
           (property-only (format nil "* TODO Build :work:~%:PROPERTIES:~%:OWNER: 高橋~%:END:~%")))
      (put ws "tx-dry.org" original)
      (let* ((before (file-octets ws "tx-dry.org"))
             (tx (jget (run-ok ws (list "tx" "begin")) "tx"))
             (staged (org-ok ws (org-write-time-args
                                 (list "org" "property" "set" "tx-dry.org" "--match" "/TODO"
                                       "--name" "OWNER" "--value" "高橋" "--tx" tx)) "org property set"))
             (overlay-before (jget (run-ok ws (list "tx" "diff" tx)) "changes" 0 "diff"))
             (planned (org-ok ws
                              (append (org-write-time-args
                                       (list "org" "todo" "set" "tx-dry.org" "--match" "/TODO"
                                             "--state" "DONE" "--tx" tx))
                                      (list "--dry-run")) "org todo set")))
        (expect (jget staged "tx") :to-equal tx)
        (expect (jget staged "tx_op") :to-be 1)
        (expect-org-fragments overlay-before (list "* TODO Build :work:" ":OWNER: 高橋"))
        (expect (file-octets ws "tx-dry.org") :to-equalp before)
        (expect (jget planned "dry_run") :to-be t)
        (dolist (key (list "tx" "tx_op" "op_id" "next_commands"))
          (expect (nth-value 1 (gethash key planned)) :to-be nil))
        (let* ((plan-diff (jget planned "changes" 0 "diff"))
               (overlay-after (jget (run-ok ws (list "tx" "diff" tx)) "changes" 0 "diff")))
          (expect-org-fragments plan-diff (list "+* DONE Build :work:" ":OWNER: 高橋"))
          (expect overlay-after :to-equal overlay-before)
          (expect (search "* DONE Build :work:" overlay-after) :to-be nil)
          (expect (file-octets ws "tx-dry.org") :to-equalp before))
        (run-ok ws (list "tx" "commit" tx))
        (expect (file-octets ws "tx-dry.org") :to-equalp (octets property-only)))))

  (define-org-case ("org todo note follows configured logging markers byte for byte" ws)
    (put ws "todo-note.org" (format nil "#+TODO: TODO(t!) | DONE(d@)~%* TODO Close~%"))
    (let* ((original (file-octets ws "todo-note.org"))
           (result (org-ok ws
                           (org-write-time-args
                            (list "org" "todo" "set" "todo-note.org" "--match" "/TODO"
                                  "--state" "DONE" "--note" "closing note")) "org todo set"))
           (expected
             (format nil "#+TODO: TODO(t!) | DONE(d@)~%* DONE Close~%:LOGBOOK:~%- State \"DONE\"       from \"TODO\"       [2026-10-19 Mon 09:00] \\\\~%  closing note~%:END:~%")))
      (expect (jget result "previous_state") :to-equal "TODO")
      (expect (jget result "new_state") :to-equal "DONE")
      (expect (jget result "changed") :to-be t)
      (expect-org-write-and-undo ws "todo-note.org" original expected result)))

  (define-org-case ("org planning rejects duplicate timestamps on indented lines" ws)
    (put ws "duplicate-planning.org"
         (format nil "* TODO Release~%   SCHEDULED: <2026-10-20> SCHEDULED: <2026-10-22>~%"))
    (let ((before (file-octets ws "duplicate-planning.org")))
      (org-error ws
                 (org-write-time-args
                  '("org" "planning" "set" "duplicate-planning.org" "--match" "/TODO"
                    "--kind" "scheduled" "--timestamp" "<2026-10-23>")) "org planning set" "selection.ambiguous")
      (expect (file-octets ws "duplicate-planning.org") :to-equalp before)
      (org-error ws
                 (org-write-time-args
                  '("org" "planning" "delete" "duplicate-planning.org" "--match" "/TODO"
                    "--kind" "scheduled")) "org planning delete" "selection.ambiguous")
      (expect (file-octets ws "duplicate-planning.org") :to-equalp before))))

(defun archive-args (source destination selector)
  (org-write-time-args (append (list "org" "archive" source "--to" destination "--target-heading" "Archived") selector)))


(defun archive-expect-line (text line)
  (expect (member line (text-lines text) :test #'equal) :to-be-truthy))

(describe "aitools e2e org archive"
  (define-org-case ("heading path moves one duplicate subtree and dry-run agrees" ws)
    (put ws "source.org" (hp-text '("#+TODO: TODO | DONE" "* Project" "** DONE Task" ":PROPERTIES:" ":OWNER: A" ":END:" ":LOGBOOK:" "- Note" ":END:" "*** Child" "** DONE Task" "*** Other")))
    (put ws "archive.org" "")
    (let* ((path (hp-path-json ws "source.org" "Project" "Task" 1))
           (args (archive-args "source.org" "archive.org" (hp-heading-path path)))
           (source (file-octets ws "source.org")) (dest (file-octets ws "archive.org"))
           (dry (org-ok ws (append args '("--dry-run")) "org archive")))
      (expect (file-octets ws "source.org") :to-equalp source)
      (expect (file-octets ws "archive.org") :to-equalp dest)
      (let ((real (org-ok ws args "org archive")))
        (expect (jget real "changed") :to-be t)
        (dolist (result (list dry real))
          (dotimes (index 2)
            (let ((diff (jget result "changes" index "diff")))
              (expect (and (stringp diff) (plusp (length diff))) :to-be t))))
        (expect (jget real "changes" 0 "diff") :to-equal (jget dry "changes" 0 "diff"))
        (expect (jget real "changes" 1 "diff") :to-equal (jget dry "changes" 1 "diff"))
        (expect (file-text ws "source.org") :to-equal (hp-text '("#+TODO: TODO | DONE" "* Project" "** DONE Task" "*** Other")))
        (dolist (line '("* Archived" "** DONE Task" "*** Child" ":OWNER: A" ":LOGBOOK:"))
          (archive-expect-line (file-text ws "archive.org") line)))))
  (define-org-case ("metadata values and duplicate children" ws)
    (ensure-directories-exist (ws-path ws "task/file.org"))
    (ensure-directories-exist (ws-path ws "archive/2026/file.org"))
    (put ws "task/file.org" (hp-text '("#+TODO: TODO | DONE" "* Project" "** DONE Task" ":PROPERTIES:" ":OWNER: A" ":END:" ":LOGBOOK:" "- Note" ":END:" "*** Same" "*** Same" "** DONE Other")))
    (put ws "archive/2026/file.org" "")
    (org-ok ws (archive-args "task/file.org" "archive/2026/file.org" (hp-heading-path (hp-path-json ws "task/file.org" "Project" "Task" 1))) "org archive")
    (expect (file-text ws "task/file.org") :to-equal (hp-text '("#+TODO: TODO | DONE" "* Project" "** DONE Other")))
    (let ((lines (text-lines (file-text ws "archive/2026/file.org"))))
      (dolist (line '(":ARCHIVE_TIME: 2026-10-19 Mon 09:00" ":ARCHIVE_FILE: ../../task/file.org" ":ARCHIVE_OLPATH: Project" ":ARCHIVE_CATEGORY: file" ":ARCHIVE_TODO: DONE"))
        (expect (member line lines :test #'equal) :to-be-truthy))
      (expect (count "*** Same" lines :test #'equal) :to-be 2)))
  (define-org-case ("creates missing file and removes last heading" ws)
    (put ws "single.org" (hp-text '("#+TODO: TODO | DONE" "* DONE Only")))
    (org-ok ws (archive-args "single.org" "new.org" '("--match" "/DONE")) "org archive")
    (expect (file-text ws "single.org") :to-equal (hp-text '("#+TODO: TODO | DONE")))
    (archive-expect-line (file-text ws "new.org") "* Archived")
    (archive-expect-line (file-text ws "new.org") "** DONE Only"))
  (define-org-case ("existing nested target preserves siblings" ws)
    (put ws "source.org" (hp-text '("#+TODO: TODO | DONE" "* DONE Task" "** Child")))
    (put ws "archive.org" (hp-text '("* Parent" "** Archived" "*** Existing" "* Sibling")))
    (org-ok ws (archive-args "source.org" "archive.org" '("--match" "/DONE")) "org archive")
    (let ((lines (text-lines (file-text ws "archive.org"))))
      (dolist (line '("* Parent" "** Archived" "*** Existing" "*** DONE Task" "**** Child" "* Sibling"))
        (expect (member line lines :test #'equal) :to-be-truthy))
      (expect (< (position "** Archived" lines :test #'equal) (position "*** DONE Task" lines :test #'equal) (position "* Sibling" lines :test #'equal)) :to-be t)))
  (define-org-case ("selection failures preserve both files" ws)
    (put ws "source.org" (hp-text '("#+TODO: TODO | DONE" "* DONE One" "* DONE Two")))
    (put ws "archive.org" (hp-text '("* Archived")))
    (let ((source (file-octets ws "source.org")) (dest (file-octets ws "archive.org")))
      (org-error ws (archive-args "source.org" "archive.org" '("--match" "/TODO")) "org archive" "selection.no-match")
      (org-error ws (archive-args "source.org" "archive.org" '("--match" "/DONE")) "org archive" "selection.ambiguous")
      (expect (file-octets ws "source.org") :to-equalp source)
      (expect (file-octets ws "archive.org") :to-equalp dest)))
  (define-org-case ("destination workflow mismatch preserves both files" ws)
    (put ws "source.org" (hp-text '("#+TODO: TODO | DONE" "* DONE Task")))
    (put ws "archive.org" (hp-text '("#+TODO: TODO | FINISHED" "* Archived")))
    (let ((source (file-octets ws "source.org")) (dest (file-octets ws "archive.org")))
      (let ((envelope (org-error ws (archive-args "source.org" "archive.org" '("--match" "/DONE"))
                                 "org archive" "input.unsupported-format")))
        (expect (search "Target settings assign a different TODO meaning"
                        (jget envelope "error" "message")) :to-be-truthy))
      (expect (file-octets ws "source.org") :to-equalp source)
      (expect (file-octets ws "archive.org") :to-equalp dest)))
  (define-org-case ("same file dry-run matches actual move" ws)
    (put ws "same.org" (hp-text '("#+TODO: TODO | DONE" "* DONE Task" "** Child" "* Archived" "** Previous")))
    (let* ((before (file-octets ws "same.org")) (args (archive-args "same.org" "same.org" '("--match" "/DONE")))
           (dry (org-ok ws (append args '("--dry-run")) "org archive")))
      (expect (file-octets ws "same.org") :to-equalp before)
      (let ((real (org-ok ws args "org archive")))
        (dolist (result (list dry real))
          (let ((diff (jget result "changes" 0 "diff")))
            (expect (and (stringp diff) (plusp (length diff))) :to-be t)))
        (expect (jget dry "changes" 0 "diff") :to-equal (jget real "changes" 0 "diff"))
        (dolist (line '("* Archived" "** Previous" "** DONE Task" "*** Child"))
          (archive-expect-line (file-text ws "same.org") line)))))
  (define-org-case ("transaction stages both files before commit" ws)
    (put ws "source.org" (hp-text '("#+TODO: TODO | DONE" "* DONE Task")))
    (put ws "archive.org" (hp-text '("* Archived")))
    (let* ((source (file-octets ws "source.org")) (dest (file-octets ws "archive.org"))
           (tx (jget (run-ok ws '("tx" "begin")) "tx"))
           (result (org-ok ws (append (archive-args "source.org" "archive.org" '("--match" "/DONE")) (list "--tx" tx)) "org archive")))
      (expect (jget result "tx") :to-equal tx)
      (expect (file-octets ws "source.org") :to-equalp source)
      (expect (file-octets ws "archive.org") :to-equalp dest)
      (run-ok ws (list "tx" "commit" tx))
      (expect (file-text ws "source.org") :to-equal (hp-text '("#+TODO: TODO | DONE")))
      (archive-expect-line (file-text ws "archive.org") "** DONE Task"))))

(describe "aitools e2e org archive destination paths"
  (define-org-case ("creates missing destination directories" ws)
    (put ws "source.org" (hp-text '("#+TODO: TODO | DONE" "* DONE Task")))
    (org-ok ws (archive-args "source.org" "missing/dir/archive.org" '("--match" "/DONE")) "org archive")
    (expect (file-text ws "source.org") :to-equal (hp-text '("#+TODO: TODO | DONE")))
    (archive-expect-line (file-text ws "missing/dir/archive.org") "* Archived")
    (archive-expect-line (file-text ws "missing/dir/archive.org") "** DONE Task"))
  (define-org-case ("ambiguous destination leaves both files unchanged" ws)
    (put ws "source.org" (hp-text '("#+TODO: TODO | DONE" "* DONE Task")))
    (put ws "archive.org" (hp-text '("* Archived" "* Archived")))
    (let ((source (file-octets ws "source.org")) (dest (file-octets ws "archive.org")))
      (org-error ws (archive-args "source.org" "archive.org" '("--match" "/DONE")) "org archive" "selection.ambiguous")
      (expect (file-octets ws "source.org") :to-equalp source)
      (expect (file-octets ws "archive.org") :to-equalp dest))))
