(in-package #:aitools.e2e.test)

(defun capture-args (file target title &rest options)
  (org-write-time-args
   (append (list "org" "capture" file "--target" target "--title" title) options)
   "2026-11-21T09:00:00"))

(describe "aitools e2e org capture"
  (define-org-case ("capture selects duplicate headings by heading-path and preserves body" ws)
    (let* ((before (format nil "#+TITLE: Test~%* Parent~%** Same~%first~%** Same~%second~%* End~%tail~%"))
           (body (format nil "#+BEGIN_SRC text~%hello~%#+END_SRC~%#+RESULTS:~%: hello~%"))
           (expected (format nil "#+TITLE: Test~%* Parent~%** Same~%first~%** Same~%second~%*** New~%~A* End~%tail~%" body))
           (args (capture-args "capture.org" "headline" "New"
                               "--heading-path" (hp-json "Parent" 1 "Same" 2)
                               "--body" body)))
      (put ws "capture.org" before)
      (let ((dry (org-ok ws (append args '("--dry-run")) "org capture")))
        (expect (jget dry "dry_run") :to-be t)
        (expect (file-octets ws "capture.org") :to-equalp (octets before))
        (let ((write (org-ok ws args "org capture")))
          (expect (jget write "changed") :to-be t)
          (expect (jget (first (jlist (jget dry "changes"))) "diff")
                  :to-equal (jget (first (jlist (jget write "changes"))) "diff"))
          (expect (file-octets ws "capture.org") :to-equalp (octets expected))))))

  (define-org-case ("capture rejects missing and ambiguous selectors and headings in body" ws)
    (let ((source (format nil "* One~%* Two~%")))
      (put ws "errors.org" source)
      (dolist (test (list (list (capture-args "errors.org" "headline" "New" "--match" "LEVEL=4") "selection.no-match")
                          (list (capture-args "errors.org" "headline" "New" "--match" "LEVEL=1") "selection.ambiguous")
                          (list (capture-args "errors.org" "headline" "New" "--heading-path" (hp-json "Absent" 1)) "selection.no-match")
                          (list (capture-args "errors.org" "headline" "New" "--heading-path" (hp-json "One" 1) "--body" (format nil "* Child~%")) "argument.invalid")))
        (org-error ws (first test) "org capture" (second test))
        (expect (file-octets ws "errors.org") :to-equalp (octets source)))))

  (define-org-case ("capture datetree creates absent year month and day" ws)
    (dolist (initial (list "" (format nil "* 2026~%") (format nil "* 2026~%** 2026-11 November~%")))
      (put ws "date.org" initial)
      (org-ok ws (capture-args "date.org" "datetree" "New" "--body" "Body") "org capture")
      (expect (file-octets ws "date.org")
              :to-equalp (octets (format nil "* 2026~%** 2026-11 November~%*** 2026-11-21 Saturday~%**** New~%Body~%")))))

  (define-org-case ("capture datetree inserts dates before between and after existing days" ws)
    (dolist (case (list (list (format nil "*** 2026-11-22 Sunday~%existing~%")
                                   (format nil "*** 2026-11-21 Saturday~%**** New~%*** 2026-11-22 Sunday~%existing~%"))
                              (list (format nil "*** 2026-11-20 Friday~%old~%*** 2026-11-22 Sunday~%later~%")
                                    (format nil "*** 2026-11-20 Friday~%old~%*** 2026-11-21 Saturday~%**** New~%*** 2026-11-22 Sunday~%later~%"))
                              (list (format nil "*** 2026-11-20 Friday~%old~%")
                                    (format nil "*** 2026-11-20 Friday~%old~%*** 2026-11-21 Saturday~%**** New~%"))
                              (list (format nil "*** 2026-11-21 Saturday~%existing~%")
                                    (format nil "*** 2026-11-21 Saturday~%existing~%**** New~%"))))
      (let ((prefix (format nil "# preserved~%* 2026~%** 2026-11 November~%")))
        (put ws "date.org" (concatenate 'string prefix (first case)))
        (org-ok ws (capture-args "date.org" "datetree" "New") "org capture")
        (expect (file-octets ws "date.org") :to-equalp
                (octets (concatenate 'string prefix (second case))))))))

(describe "aitools e2e org capture other targets"
  (define-org-case ("capture matches one headline with an empty body" ws)
    (put ws "match.org" (format nil "* MTG~%existing~%"))
    (org-ok ws (capture-args "match.org" "headline" "Meeting" "--match" "LEVEL=1") "org capture")
    (expect (file-octets ws "match.org")
            :to-equalp (octets (format nil "* MTG~%existing~%** Meeting~%"))))
  (define-org-case ("capture sorts newly created years and months" ws)
    (dolist (case (list (list (format nil "* 2027~%future~%")
                              (format nil "* 2026~%** 2026-11 November~%*** 2026-11-21 Saturday~%**** New~%* 2027~%future~%"))
                        (list (format nil "* 2026~%** 2026-12 December~%future~%")
                              (format nil "* 2026~%** 2026-11 November~%*** 2026-11-21 Saturday~%**** New~%** 2026-12 December~%future~%"))))
      (put ws "order.org" (first case))
      (org-ok ws (capture-args "order.org" "datetree" "New") "org capture")
      (expect (file-octets ws "order.org") :to-equalp (octets (second case))))))
