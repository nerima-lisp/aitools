(in-package #:aitools.e2e.test)
(describe "aitools e2e org read results and boundaries"
  (define-org-case ("org query reports sibling indices and nullable metadata" ws)
    (put ws "siblings.org"
         (format nil "~{~A~%~}"
                 (list "* Parent"
                       "** TODO Repeated :work:"
                       "** TODO Repeated :work:"
                       "* Other"
                       "** TODO Repeated :work:")))
    (let* ((before (file-octets ws "siblings.org"))
           (arguments (list "org" "query" "siblings.org" "--match" "work/TODO"
                            "--at" "2026-10-19T09:00:00" "--tz" "UTC"))
           (envelope (org-ok ws arguments "org query"))
           (matches (jlist (jget envelope "matches"))))
      (expect (jget envelope "count") :to-be 3)
      (expect (mapcar (lambda (match) (jget match "path")) matches)
              :to-equal '("siblings.org" "siblings.org" "siblings.org"))
      (expect (mapcar (lambda (match) (jget match "title")) matches)
              :to-equal (list "Repeated" "Repeated" "Repeated"))
      (expect (mapcar (lambda (match) (jget match "line")) matches) :to-equal (list 2 3 5))
      (expect (mapcar (lambda (match) (jget match "level")) matches) :to-equal (list 2 2 2))
      (expect (mapcar (lambda (match)
                        (mapcar (lambda (part) (list (jget part "title") (jget part "index")))
                                (jlist (jget match "heading_path"))))
                      matches)
              :to-equal (list (list (list "Parent" 1) (list "Repeated" 1))
                              (list (list "Parent" 1) (list "Repeated" 2))
                              (list (list "Other" 1) (list "Repeated" 1))))
      (let* ((top-level
               (org-ok ws
                       (list "org" "query" "siblings.org" "--match" "LEVEL=1"
                             "--at" "2026-10-19T09:00:00" "--tz" "UTC") "org query"))
             (top-matches (jlist (jget top-level "matches")))
             (parent (first top-matches))
             (other (second top-matches)))
        (expect (jget top-level "count") :to-be 2)
        (expect (jget parent "title") :to-equal "Parent")
        (expect (jget other "title") :to-equal "Other")
        (expect (mapcar (lambda (part)
                          (list (jget part "title") (jget part "index")))
                        (jlist (jget other "heading_path")))
                :to-equal (list (list "Other" 1)))
        (multiple-value-bind (todo present) (gethash "todo" parent)
          (expect present :to-be t)
          (expect (null todo) :to-be-truthy))
        (multiple-value-bind (tags present) (gethash "tags" parent)
          (expect present :to-be t)
          (expect (jlist tags) :to-equal (list))))
      (let ((none (org-ok ws
                          (list "org" "query" "siblings.org" "--match" "missing/TODO"
                                "--at" "2026-10-19T09:00:00" "--tz" "UTC") "org query")))
        (expect (jget none "count") :to-be 0)
        (expect (jlist (jget none "matches")) :to-equal (list)))
      (expect (file-octets ws "siblings.org") :to-equalp before)))
  (define-org-case ("org query merges explicit files and nested directories in path and document order" ws)
    (put ws "task/z.org" (format nil "* TODO Z~%"))
    (put ws "task/sub/a.org" (format nil "* TODO Second~%* TODO First~%"))
    (put ws "task/ignored.txt" (format nil "* TODO Ignored~%"))
    (put ws "task/ignored.org.gpg" #(#xFF))
    (put ws "task/ignored-upper.org.GPG" #(#xFF))
    (put ws "inbox.org" (format nil "* TODO Inbox~%"))
    (let* ((envelope (org-ok ws
                             '("org" "query" "task/z.org" "--match" "LEVEL=1/TODO"
                               "task" "inbox.org" "task/sub" "task/z.org"
                               "task/ignored.org.gpg" "task/ignored-upper.org.GPG"
                               "--at" "2026-10-19T09:00:00" "--tz" "UTC") "org query"))
           (matches (jlist (jget envelope "matches"))))
      (expect (jget envelope "count") :to-be 4)
      (expect (mapcar (lambda (match)
                        (list (jget match "path") (jget match "line") (jget match "title")))
                      matches)
              :to-equal '(("inbox.org" 1 "Inbox")
                          ("task/sub/a.org" 1 "Second")
                          ("task/sub/a.org" 2 "First")
                          ("task/z.org" 1 "Z")))))
  (define-org-case ("org query returns an empty array and validates match syntax when no Org files are selected" ws)
    (ensure-directories-exist (ws-path ws "empty/"))
    (put ws "encrypted/secret.org.gpg" #(#xFF))
    (flet ((arguments (paths match)
             (append '("org" "query") paths
                     (list "--match" match "--at" "2026-10-19T09:00:00" "--tz" "UTC"))))
      (dolist (paths '(("empty") ("encrypted") ("encrypted/secret.org.gpg")))
        (let ((envelope (org-ok ws (arguments paths "LEVEL=1/TODO") "org query")))
          (expect (jget envelope "count") :to-be 0)
          (expect (jget envelope "matches") :to-equalp #())))
      (org-error ws (arguments '("empty") "LEVEL=") "org query" "input.syntax-error")
      (org-error ws (arguments nil "LEVEL=1/TODO") "org query" "argument.invalid")))
  (define-org-case ("org query fails the whole request for a missing or malformed file" ws)
    (put ws "task/a.org" (format nil "* TODO Valid~%"))
    (put ws "z-broken.org" #(#xFF))
    (put ws "z-binary.org" #(#x00 #xFF))
    (dolist (test '(("task/missing.org" "input.not-found")
                    ("z-broken.org" "input.not-utf8")
                    ("z-binary.org" "input.unsupported-format")))
      (destructuring-bind (path code) test
        (let* ((envelope (org-error ws
                                    (list "org" "query" "task" path "--match" "LEVEL=1/TODO"
                                          "--at" "2026-10-19T09:00:00" "--tz" "UTC")
                                    "org query" code))
               (message (jget envelope "error" "message")))
          (expect (nth-value 1 (gethash "matches" envelope)) :to-be nil)
          (expect (nth-value 1 (gethash "count" envelope)) :to-be nil)
          (expect (loop for offset = (search path message)
                          then (search path message :start2 (1+ offset))
                        while offset count offset)
                  :to-be 1)))))
  (define-org-case ("org query validates match syntax and reference time before reading files" ws)
    (put ws "broken.org" #(#xFF))
    (dolist (test '(("LEVEL=" "2026-10-19T09:00:00" "input.syntax-error")
                    ("LEVEL=1/TODO" "2026-10-19T09:00:01" "argument.invalid")))
      (destructuring-bind (match at code) test
        (dolist (path '("broken.org" "missing.org"))
          (let ((envelope (org-error ws (list "org" "query" path "--match" match
                                              "--at" at "--tz" "UTC")
                                     "org query" code)))
            (expect (search path (jget envelope "error" "message")) :to-be nil))))))
  (define-org-case ("org query skips discovered links and resolves explicit links within the workspace" ws)
    (put ws "task/list/active.org" (format nil "* TODO Active~%"))
    (put ws "task/standalone.org" (format nil "* TODO Standalone~%"))
    (put ws "outside.org" (format nil "* TODO Outside~%"))
    (sb-posix:symlink "../standalone.org" (native (ws-path ws "task/list/alias.org")))
    (sb-posix:symlink "../../outside.org" (native (ws-path ws "task/list/escape.org")))
    (flet ((arguments (&rest paths)
             (append '("--root" "task" "org" "query") paths
                     '("--match" "LEVEL=1/TODO" "--at" "2026-10-19T09:00:00" "--tz" "UTC"))))
      (let ((envelope (org-ok ws (arguments "task/list") "org query")))
        (expect (jget envelope "count") :to-be 1)
        (expect (jget envelope "matches" 0 "path") :to-equal "list/active.org"))
      (let* ((envelope (org-ok ws (arguments "task/list" "task/list/alias.org") "org query"))
             (matches (jlist (jget envelope "matches"))))
        (expect (jget envelope "count") :to-be 2)
        (expect (mapcar (lambda (match) (jget match "path")) matches)
                :to-equal '("list/active.org" "standalone.org")))
      (org-error ws (arguments "task/list" "task/list/escape.org")
                 "org query" "refusal.outside-workspace")))
  (define-org-case ("org outline names unnamed source blocks by language" ws)
    (put ws "unnamed.org"
         (format nil
                 "#+BEGIN_SRC lisp~%(+ 1 2)~%#+END_SRC~%#+BEGIN_EXAMPLE~%plain text~%#+END_EXAMPLE~%"))
    (let* ((before (file-octets ws "unnamed.org"))
           (envelope (org-ok ws '("org" "outline" "unnamed.org") "org outline"))
           (entries (jlist (jget envelope "entries"))))
      (expect (jget envelope "total") :to-be 2)
      (expect (jget envelope "truncated") :to-be nil)
      (expect (org-outline-summary entries)
              :to-equal '(("src-block" "lisp" nil 1)
                          ("example-block" "" nil 4)))
      (expect (file-octets ws "unnamed.org") :to-equalp before)))
  (define-org-case ("org outline rejects NUL and UTF-16/UTF-32 inputs" ws)
    (dolist (fixture
             '(("nul.org" . #(#x2A #x20 #x54 #x69 #x74 #x6C #x65 #x00 #x0A))
               ("utf16be.org" . #(#xFE #xFF #x00 #x2A #x00 #x20 #x00 #x54))
               ("utf32le.org" . #(#xFF #xFE #x00 #x00 #x2A #x00 #x00 #x00))
               ("utf32be.org" . #(#x00 #x00 #xFE #xFF #x00 #x00 #x00 #x2A))))
      (let ((path (car fixture)))
        (put ws path (cdr fixture))
        (let ((before (file-octets ws path))
              (envelope (org-error ws (list "org" "outline" path) "org outline" "input.unsupported-format")))
          (expect (nth-value 1 (gethash "content" envelope)) :to-be nil)
          (expect (file-octets ws path) :to-equalp before))))))
