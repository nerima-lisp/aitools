(in-package #:aitools.e2e.test)

(defun format-write-arguments (format verb path)
  (append (list "doc" verb path)
          (when format
            (list "--format" format))
          (cond ((string= verb "set") '("/key" "\"updated\""))
                ((string= verb "delete") '("/drop"))
                ((member verb '("merge" "patch") :test #'string=) '("--stdin")))))

(defun invoke-format-write (workspace format verb path &key dry-run)
  (let* ((arguments (format-write-arguments format verb path))
         (arguments (if dry-run (append arguments '("--dry-run")) arguments))
         (stdin (cond ((string= verb "merge") "{\"key\":\"updated\"}")
                      ((string= verb "patch")
                       "[{\"op\":\"replace\",\"path\":\"/key\",\"value\":\"updated\"}]"))))
    (if stdin
        (run-ok workspace arguments :stdin stdin)
        (run-ok workspace arguments))))

(defun expect-format-warnings (envelope count)
  (let* ((warnings (jget envelope "warnings"))
         (warning (and (vectorp warnings) (plusp (length warnings))
                       (aref warnings 0))))
    (expect (and (vectorp warnings) (= (length warnings) (if (zerop count) 0 1))) :to-be t)
    (when (plusp count)
      (expect (jget warning "code") :to-equal "format.comments-dropped")
      (expect (jget warning "message")
              :to-equal "Comments were dropped when the document was rewritten.")
      (expect (jget warning "count") :to-be count))))

(defun yaml-comment-fixture ()
  (format nil "# first~%# second~%key: \"# quoted\"~%drop: true # inline~%block: |~%  # block body~%  text~%"))

(defun toml-comment-fixture ()
  (format nil "# first~%# second~%key = \"# quoted\"~%drop = true # inline~%"))

(defun yaml-clean-fixture ()
  (format nil "key: \"# quoted\"~%drop: true~%block: |~%  # block body~%  text~%"))

(defun toml-clean-fixture ()
  (format nil "key = \"# quoted\"~%drop = true~%"))

(describe "YAML and TOML write commands"
  (it "sets and deletes JSON values in YAML and TOML documents"
    (aitools-binary)
    (call-with-workspace
     (lambda (ws)
       (put ws "values.yaml" (format nil "key: old~%drop: true~%"))
       (put ws "values.toml" (format nil "key = \"old\"~%drop = true~%"))
       (dolist (format '("yaml" "toml"))
         (let* ((path (format nil "values.~A" (if (string= format "yaml") "yaml" "toml")))
                (set (run-ok ws (list "doc" "set" path "/key" "42")))
                (document (jget (run-ok ws (list "doc" "get" path "")) "value")))
           (expect (jget document "key") :to-be 42)
           (expect-format-warnings set 0)
           (run-ok ws (list "doc" "set" path "/profile"
                            "{\"active\":true,\"tags\":[\"a\",\"b\"]}"))
           (let ((profile (jget (run-ok ws (list "doc" "get" path "")) "value" "profile")))
             (expect (jget profile "active") :to-be t)
             (expect (jget profile "tags" 1) :to-equal "b"))
           (let ((deleted (run-ok ws (list "doc" "delete" path "/drop"))))
             (expect-format-warnings deleted 0))
           (expect (jget (run-ok ws (list "doc" "get" path "")) "value" "drop") :to-be nil))))))
  (it "applies JSON merge and patch documents to both formats"
    (aitools-binary)
    (call-with-workspace
     (lambda (ws)
       (dolist (format '("yaml" "toml"))
         (let ((path (format nil "merge.~A" (if (string= format "yaml") "yaml" "toml")))
               (source (if (string= format "yaml")
                           (format nil "key: old~%drop: true~%nested:~%  keep: 1~%")
                           (format nil "key = \"old\"~%drop = true~%[nested]~%keep = 1~%"))))
           (put ws path source)
           (let ((merged (run-ok ws (list "doc" "merge" path "--stdin")
                                 :stdin "{\"key\":\"merged\",\"drop\":null,\"nested\":{\"extra\":2}}")))
             (expect-format-warnings merged 0))
           (let ((value (jget (run-ok ws (list "doc" "get" path "")) "value")))
             (expect (jget value "key") :to-equal "merged")
             (expect (jget value "drop") :to-be nil)
             (expect (jget value "nested" "extra") :to-be 2))
           (put ws path source)
           (let ((patched (run-ok ws (list "doc" "patch" path "--stdin")
                                  :stdin (format nil
                                                 "[{\"op\":\"replace\",\"path\":\"/key\",\"value\":\"patched\"},~% {\"op\":\"remove\",\"path\":\"/drop\"},~% {\"op\":\"add\",\"path\":\"/new\",\"value\":true}]"))))
             (expect-format-warnings patched 0)
           (let ((value (jget (run-ok ws (list "doc" "get" path "")) "value")))
             (expect (jget value "key") :to-equal "patched")
             (expect (jget value "new") :to-be t)
             (expect (jget value "drop") :to-be nil))))))))
  (it "always reports comment warnings and preserves dry-run bytes"
    (aitools-binary)
    (call-with-workspace
     (lambda (ws)
       (dolist (format '("yaml" "toml"))
         (let ((path (format nil "comments.~A" (if (string= format "yaml") "yaml" "toml")))
               (commented (if (string= format "yaml")
                              (yaml-comment-fixture)
                              (toml-comment-fixture)))
               (clean (if (string= format "yaml")
                          (yaml-clean-fixture)
                          (toml-clean-fixture))))
           (dolist (verb '("set" "delete" "merge" "patch" "fmt"))
             (put ws path commented)
             (let* ((before (file-octets ws path))
                    (write (invoke-format-write ws nil verb path))
                    (after (file-octets ws path))
                    (rewritten (utf8 after)))
               (expect-format-warnings write 3)
               (expect (equalp after before) :to-be nil)
               (expect (search "# first" rewritten) :to-be nil)
               (expect (search "# second" rewritten) :to-be nil)
               (expect (search "# inline" rewritten) :to-be nil))
             (put ws path clean)
             (expect-format-warnings (invoke-format-write ws nil verb path) 0))
           (put ws path commented)
           (let ((before (file-octets ws path))
                 (dry-run (invoke-format-write ws format "set" path :dry-run t)))
             (expect-format-warnings dry-run 3)
             (expect (jget dry-run "dry_run") :to-be t)
             (expect (file-octets ws path) :to-equalp before))))))))

(describe "JSON document diff and patch"
  (it "compares JSON files and applies a JSON Patch through doc"
    (aitools-binary)
    (call-with-workspace
     (lambda (ws)
       (put ws "before.json" (format nil "{\"a\":1,\"b\":2}~%"))
       (put ws "after.json" (format nil "{\"a\":3}~%"))
       (let ((diff (run-ok ws '("doc" "diff" "before.json" "after.json"))))
         (expect (jget diff "command") :to-equal "doc diff")
         (expect (jget diff "identical") :to-be nil)
         (expect (jget diff "total") :to-be 2))
       (let* ((limited (aitools ws '("doc" "diff" "before.json" "after.json" "--limit" "1")))
              (envelope (aitools-envelope limited)))
         (expect (aitools-exit-code limited) :to-be 3)
         (expect envelope :to-match-envelope "status" "partial" "command" "doc diff")
         (expect (and (= (jget envelope "total") 2) (plusp (length (jget envelope "next_commands")))) :to-be t))
       (put ws "patch.json" (format nil "{\"key\":\"old\"}~%"))
       (let ((patched (run-ok ws '("doc" "patch" "patch.json" "--stdin")
                              :stdin "[{\"op\":\"replace\",\"path\":\"/key\",\"value\":\"new\"}]")))
         (expect patched :to-match-envelope "status" "ok" "command" "doc patch"))
       (expect (jget (run-ok ws '("doc" "get" "patch.json" "")) "value" "key")
               :to-equal "new")))))

(describe "doc command format matrix"
  (it "gets, selects, diffs, and writes every verb for each format"
    (aitools-binary)
    (call-with-workspace
     (lambda (ws)
       (dolist (format (list "json" "yaml" "toml"))
         (let* ((path (format nil "matrix.~A" format))
                (other (format nil "other.~A" format))
                (source
                  (cond ((string= format "json")
                         "{\"key\":\"old\",\"drop\":true,\"items\":[{\"id\":1},{\"id\":2}]}")
                        ((string= format "yaml")
                         (format nil "key: old~%drop: true~%items:~%  - id: 1~%  - id: 2~%"))
                        (t (format nil "key = \"old\"~%drop = true~%items = [{id = 1}, {id = 2}]~%"))))
                (changed
                  (cond ((string= format "json")
                         "{\"key\":\"changed\",\"drop\":true,\"items\":[{\"id\":1},{\"id\":3}]}")
                        ((string= format "yaml")
                         (format nil "key: changed~%drop: true~%items:~%  - id: 1~%  - id: 3~%"))
                        (t (format nil "key = \"changed\"~%drop = true~%items = [{id = 1}, {id = 3}]~%")))))
           (put ws path source)
           (put ws other changed)
           (expect (jget (run-ok ws (list "doc" "get" path "/items/0/id"
                                          "--format" format))
                         "value")
                   :to-be 1)
           (let ((selected (run-ok ws (list "doc" "select" path "/items" "--where" "/id>1" "--pick" "/id" "--format" format))))
             (expect (jget selected "total") :to-be 1)
             (expect (jget selected "items" 0 "value" "/id") :to-be 2))
           (expect (plusp (jget (run-ok ws (list "doc" "diff" path other
                                                "--format" format))
                               "total"))
                   :to-be t)
           (dolist (verb (list "set" "delete" "merge" "patch" "fmt"))
             (expect (jget (invoke-format-write ws nil verb path) "command")
                     :to-equal (format nil "doc ~A" verb)))
           (expect (jget (run-ok ws (list "doc" "get" path "/key"
                                          "--format" format))
                         "value")
                   :to-equal "updated"))))))
  (it "doc get JSON, YAML, and TOML array continuations"
    (aitools-binary)
    (call-with-workspace
     (lambda (ws)
       (put ws "values.json" "[1, 2]")
       (put ws "values.yaml" (format nil "- one~%- two~%"))
       (put ws "values.toml" "items = [1, 2]")
       (dolist (case (list (list "json" "values.json" "" nil "/0")
                           (list "yaml" "values.yaml" "" "yaml" "/0")
                           (list "toml" "values.toml" "/items" "toml" "/items/0")))
         (let* ((path (second case))
                (pointer (third case))
                (format-override (fourth case))
                (next-pointer (fifth case))
                (arguments
                  (append (list "doc" "get" path pointer "--max-bytes" "1")
                          (when format-override
                            (list "--format" format-override))))
                (result (aitools ws arguments))
                (envelope (aitools-envelope result))
                (next (jget envelope "next_commands" 1)))
           (expect (aitools-exit-code result) :to-be 3)
           (expect envelope :to-match-envelope "status" "partial" "command" "doc get")
           (expect (length (jget envelope "next_commands")) :to-be 2)
           (expect (search "doc get" next) :to-be-truthy)
           (expect (search next-pointer next) :to-be-truthy)
           (when format-override
             (expect (search (format nil "--format ~A" format-override) next)
                     :to-be-truthy))))))))
