(in-package #:aitools.e2e.test)

(defparameter +dynamic-time-options+
  '("--at" "2026-10-15T12:00:00" "--tz" "UTC"))

(defun dynamic-args (path block &rest options)
  (append (list "org" "dynamic-block" "update" path "--block" (princ-to-string block))
          +dynamic-time-options+ options))

(describe "aitools e2e org dynamic block update"
  (define-org-case ("selects one block and dry-run matches the write" ws)
    (put ws "blocks.org"
         (format nil "* Task~%CLOCK: [2026-10-01 Thu 10:00]--[2026-10-01 Thu 11:30] =>  1:30~%#+BEGIN: clocktable :scope file~%old one~%#+END:~%#+BEGIN: clocktable :scope file :block 2026-10-01~%old two~%#+END:~%"))
    (let* ((before (file-octets ws "blocks.org"))
           (dry (org-ok ws (dynamic-args "blocks.org" 2 "--dry-run") "org dynamic-block update")))
      (expect (jget dry "changed") :to-be t)
      (expect (file-octets ws "blocks.org") :to-equalp before)
      (let ((written (org-ok ws (dynamic-args "blocks.org" 2) "org dynamic-block update")))
        (expect (jget written "changes" 0 "diff") :to-equal (jget dry "changes" 0 "diff"))
        (expect (not (null (search "old one" (file-text ws "blocks.org")))) :to-be t)
        (expect (not (null (search "1:30" (file-text ws "blocks.org")))) :to-be t))))
  (define-org-case ("agenda uses glob and excludes encrypted files" ws)
    (put ws "task/a.org" (format nil "* Work~%CLOCK: [2026-10-01 Thu 10:00]--[2026-10-01 Thu 11:00] =>  1:00~%"))
    (put ws "task/secret.org.gpg" "not an Org document")
    (put ws "report.org" (format nil "#+BEGIN: clocktable :scope agenda :tstart \"2026-10-01\" :tend \"2026-11-01\"~%old~%#+END:~%"))
    (let ((result (org-ok ws (dynamic-args "report.org" 1 "--agenda-glob" "task/*") "org dynamic-block update")))
      (expect (jget result "changed") :to-be t)
      (expect (not (null (search "1:00" (file-text ws "report.org")))) :to-be t)))
  (define-org-case ("rejects missing block, empty agenda and invalid clocktable options without writes" ws)
    (dolist (fixture (list (list "empty.org" "* Empty" 1 nil)
                           (list "agenda.org" (format nil "#+BEGIN: clocktable :scope agenda~%old~%#+END:~%") 1 '("--agenda-glob" "missing/*.org"))
                           (list "partial.org" (format nil "#+BEGIN: clocktable :tstart \"2026-10-01\"~%old~%#+END:~%") 1 nil)
                           (list "combined.org" (format nil "#+BEGIN: clocktable :block 2026-10-01 :tstart \"2026-10-01\" :tend \"2026-11-01\"~%old~%#+END:~%") 1 nil)))
      (destructuring-bind (path source block options) fixture
        (put ws path source)
        (let ((before (file-octets ws path)))
          (org-error ws (apply #'dynamic-args path block options) "org dynamic-block update" "argument.invalid")
          (expect (file-octets ws path) :to-equalp before))))))

(defparameter +unparseable-clock+ "CLOCK: [2025-01-01 Wed]--[2025-01-02 Thu]")

(defun clock-warnings (result)
  (let ((warnings (jget result "warnings")))
    (loop for index below (length warnings)
          collect (aref warnings index))))

(describe "aitools e2e unparseable CLOCK warnings"
  (define-org-case ("reports the source file and line and still updates the block" ws)
    (put ws "tasks/bad.org" (format nil "* A~%CLOCK: [2025-01-01 Wed 10:00]--[2025-01-01 Wed 11:00] => 1:00~%~A~%" +unparseable-clock+))
    (put ws "tasks/good.org" (format nil "* B~%CLOCK: [2026-10-01 Thu 10:00]--[2026-10-01 Thu 11:00] => 1:00~%"))
    (put ws "report.org" (format nil "#+BEGIN: clocktable :scope agenda :tstart \"2026-10-01\" :tend \"2026-11-01\"~%old~%#+END:~%"))
    (let* ((before-source (file-octets ws "tasks/bad.org"))
           (result (org-ok ws (dynamic-args "report.org" 1 "--agenda-glob" "tasks/*.org") "org dynamic-block update"))
           (warnings (clock-warnings result)))
      (expect (length warnings) :to-be 1)
      (expect (jget (first warnings) "code") :to-equal "org.clock-ignored")
      (expect (jget (first warnings) "path") :to-equal "tasks/bad.org")
      (expect (jget (first warnings) "line") :to-be 3)
      (expect (jget (first warnings) "source") :to-equal +unparseable-clock+)
      (expect (not (null (search "1:00" (file-text ws "report.org")))) :to-be t)
      (expect (file-octets ws "tasks/bad.org") :to-equalp before-source)))
  (define-org-case ("reports every file holding the same unparseable line" ws)
    (let ((source (format nil "* A~%~A~%" +unparseable-clock+)))
      (put ws "tasks/one.org" source)
      (put ws "tasks/two.org" source)
      (put ws "report.org" (format nil "#+BEGIN: clocktable :scope agenda~%old~%#+END:~%"))
      (let ((paths (mapcar (lambda (warning) (jget warning "path"))
                           (clock-warnings (org-ok ws (dynamic-args "report.org" 1 "--agenda-glob" "tasks/*.org")
                                                   "org dynamic-block update")))))
        (expect (sorted paths) :to-equal '("tasks/one.org" "tasks/two.org")))))
  (define-org-case ("returns an empty warnings list for dry-run and when every CLOCK parses" ws)
    (put ws "blocks.org" (format nil "* Task~%CLOCK: [2026-10-01 Thu 10:00]--[2026-10-01 Thu 11:30] =>  1:30~%#+BEGIN: clocktable :scope file~%old~%#+END:~%"))
    (let ((result (org-ok ws (dynamic-args "blocks.org" 1 "--dry-run") "org dynamic-block update")))
      (expect (vectorp (jget result "warnings")) :to-be t)
      (expect (length (jget result "warnings")) :to-be 0))))

(describe "aitools e2e dynamic block transactions"
  (define-org-case ("stages the update in a transaction and writes it on commit" ws)
    (put ws "tx.org" (format nil "* Task~%CLOCK: [2026-10-01 Thu 10:00]--[2026-10-01 Thu 11:30] =>  1:30~%#+BEGIN: clocktable :scope file~%old~%#+END:~%"))
    (let* ((before (file-octets ws "tx.org"))
           (tx (jget (run-ok ws (list "tx" "begin")) "tx"))
           (staged (org-ok ws (dynamic-args "tx.org" 1 "--tx" tx) "org dynamic-block update")))
      (expect (jget staged "tx") :to-equal tx)
      (expect (jget staged "tx_op") :to-be 1)
      (expect (file-octets ws "tx.org") :to-equalp before)
      (run-ok ws (list "tx" "commit" tx))
      (expect (not (null (search "1:30" (file-text ws "tx.org")))) :to-be t)
      (expect (null (search "old" (file-text ws "tx.org"))) :to-be t)))
  (define-org-case ("aggregates agenda files as staged in the transaction" ws)
    (put ws "task/a.org" (format nil "* Work~%CLOCK: [2026-10-01 Thu 10:00]--[2026-10-01 Thu 11:00] =>  1:00~%"))
    (put ws "report.org" (format nil "#+BEGIN: clocktable :scope agenda :tstart \"2026-10-01\" :tend \"2026-11-01\"~%old~%#+END:~%"))
    (let ((tx (jget (run-ok ws (list "tx" "begin")) "tx")))
      (run-ok ws (list "edit" "task/a.org" "--old" "11:00] =>  1:00" "--new" "13:00] =>  3:00" "--tx" tx))
      (org-ok ws (dynamic-args "report.org" 1 "--agenda-glob" "task/*.org" "--tx" tx) "org dynamic-block update")
      (let ((diff (jget (run-ok ws (list "tx" "diff" tx)) "changes" 0 "diff")))
        (expect (not (null (search "*3:00*" diff))) :to-be t)))))

(describe "aitools e2e clocktable :link"
  (define-org-case ("links agenda headings relative to the block document" ws)
    (put ws "task/a.org" (format nil "* Work~%CLOCK: [2026-10-01 Thu 10:00]--[2026-10-01 Thu 11:00] =>  1:00~%"))
    (put ws "journal/2026/2026-10.org"
         (format nil "#+BEGIN: clocktable :scope agenda :link t :tstart \"2026-10-01\" :tend \"2026-11-01\"~%old~%#+END:~%"))
    (let ((result (org-ok ws (dynamic-args "journal/2026/2026-10.org" 1 "--agenda-glob" "task/*.org")
                          "org dynamic-block update")))
      (expect (length (clock-warnings result)) :to-be 0)
      (expect (not (null (search "[[file:../../task/a.org::*Work][Work]]" (file-text ws "journal/2026/2026-10.org")))) :to-be t)))
  (define-org-case ("links headings of the same file without a file prefix" ws)
    (put ws "same.org" (format nil "* Work~%CLOCK: [2026-10-01 Thu 10:00]--[2026-10-01 Thu 11:00] =>  1:00~%#+BEGIN: clocktable :scope file :link t~%old~%#+END:~%"))
    (org-ok ws (dynamic-args "same.org" 1) "org dynamic-block update")
    (expect (not (null (search "[[*Work][Work]]" (file-text ws "same.org")))) :to-be t)))
