(in-package #:aitools.e2e.test)

(defun aitools (workspace arguments &key stdin env (directory "") expect-trace)
  "Run the executable and require one version 2 JSON envelope."
  (let* ((binary (aitools-binary))
         (result (run-process (native binary) arguments
                              :directory (ws-path workspace directory)
                              :environment (workspace-environment workspace env)
                              :input (and stdin (if (stringp stdin) (octets stdin) stdin))))
         (stdout (utf8 (result-stdout result)))
         (stderr (utf8 (result-stderr result)))
         (text (cond ((and (plusp (length stdout)) (zerop (length stderr))) stdout)
                     ((and (zerop (length stdout)) (plusp (length stderr))) stderr)
                     (t (fail "~A" (format nil "aitools ~{~A~^ ~}: expected one JSON envelope on exactly one stream, got stdout ~S and stderr ~S"
                                          arguments stdout stderr)))))
         (envelope (handler-case (json-kit:parse text :false-value nil :null-value nil)
                     (json-kit:json-kit-error (condition)
                       (fail "~A" (format nil "aitools ~{~A~^ ~}: output is not JSON (~A): ~S" arguments condition text))))))
    (unless (eql (jget envelope "schema_version") 2)
      (fail "aitools ~{~A~^ ~}: expected schema_version 2, got ~S"
            arguments (jget envelope "schema_version")))
    (if expect-trace
        (let ((meta (jget envelope "meta")))
          (unless (and (hash-table-p meta) (nth-value 1 (gethash "trace" meta)))
            (fail "aitools ~{~A~^ ~}: expected meta.trace with trace instrumentation" arguments)))
        (progn
          (when (nth-value 1 (gethash "meta" envelope))
            (fail "aitools ~{~A~^ ~}: expected meta to be absent without trace instrumentation" arguments))
          (capture-no-trace-output
           aitools/test::*current-spec-id*
           (incf aitools/test::*current-spec-no-trace-invocation*)
           result)))
    (make-aitools-result
     :exit-code (result-exit-code result)
     :envelope envelope
     :stream (if (eq text stdout) :stdout :stderr)
     :stdout stdout :stderr stderr :argv arguments)))
(defun %trace-byte-parity-whitespace-p (octet)
  (member octet '(#x20 #x09 #x0a #x0d)))

(defun %trace-byte-parity-skip-whitespace (octets index)
  (loop while (and (< index (length octets))
                   (%trace-byte-parity-whitespace-p (aref octets index)))
        do (incf index))
  index)

(defun %trace-byte-parity-string-end (octets start)
  (unless (= (aref octets start) #x22)
    (error "trace byte parity expected a JSON string"))
  (loop with index = (1+ start)
        while (< index (length octets))
        for octet = (aref octets index)
        do (cond ((= octet #x22)
                  (return-from %trace-byte-parity-string-end (1+ index)))
                 ((= octet #x5c)
                  (incf index)
                  (when (>= index (length octets))
                    (error "trace byte parity found an incomplete JSON escape"))))
        (incf index))
  (error "trace byte parity found an unterminated JSON string"))

(defun %trace-byte-parity-value-end (octets start)
  (let ((first (aref octets start)))
    (cond ((= first #x22)
           (%trace-byte-parity-string-end octets start))
          ((member first '(#x7b #x5b) :test #'eql)
           (loop with index = (1+ start)
                 with stack = (list (if (= first #x7b) #x7d #x5d))
                 while (< index (length octets))
                 for octet = (aref octets index)
                 do (cond ((= octet #x22)
                           (setf index (%trace-byte-parity-string-end octets index)))
                          ((= octet #x7b)
                           (push #x7d stack)
                           (incf index))
                          ((= octet #x5b)
                           (push #x5d stack)
                           (incf index))
                          ((member octet '(#x7d #x5d) :test #'eql)
                           (unless (= octet (first stack))
                             (error "trace byte parity found mismatched JSON delimiters"))
                           (pop stack)
                           (incf index)
                           (when (null stack)
                             (return-from %trace-byte-parity-value-end index)))
                          (t
                           (incf index)))
                 finally (error "trace byte parity found an unterminated JSON value")))
          (t
           (let ((index start))
             (loop while (and (< index (length octets))
                              (not (member (aref octets index)
                                           '(#x20 #x09 #x0a #x0d #x2c #x7d #x5d)
                                           :test #'eql)))
                   do (incf index))
             index)))))

(defun %trace-byte-parity-key-p (octets start end name)
  (equalp (subseq octets start end)
          (concatenate '(vector (unsigned-byte 8))
                       #(34) (octets name) #(34))))

(defun %trace-byte-parity-field-span (octets field-name)
  (let* ((limit (length octets))
         (cursor (%trace-byte-parity-skip-whitespace octets 0))
         (previous-comma nil)
         (field-span nil))
    (unless (and (< cursor limit) (= (aref octets cursor) #x7b))
      (error "trace byte parity expected a JSON object"))
    (incf cursor)
    (loop
     (setf cursor (%trace-byte-parity-skip-whitespace octets cursor))
     (when (or (>= cursor limit) (= (aref octets cursor) #x7d))
       (return))
     (let* ((key-start cursor)
            (key-end (%trace-byte-parity-string-end octets key-start))
            (colon (%trace-byte-parity-skip-whitespace octets key-end)))
       (unless (and (< colon limit) (= (aref octets colon) #x3a))
         (error "trace byte parity expected a JSON object member"))
       (let* ((value-start (%trace-byte-parity-skip-whitespace octets (1+ colon)))
              (value-end (%trace-byte-parity-value-end octets value-start))
              (after-value (%trace-byte-parity-skip-whitespace octets value-end)))
         (when (%trace-byte-parity-key-p octets key-start key-end field-name)
           (when field-span
             (error "trace byte parity found duplicate top-level ~A members" field-name))
           (setf field-span
                 (list key-start value-start value-end previous-comma after-value)))
         (unless (< after-value limit)
           (error "trace byte parity found an unterminated JSON object"))
         (cond ((= (aref octets after-value) #x2c)
                (setf previous-comma after-value
                      cursor (1+ after-value)))
               ((= (aref octets after-value) #x7d)
                (return))
               (t
                (error "trace byte parity expected a JSON object separator"))))))
    (unless field-span
      (error "trace byte parity could not locate top-level ~A bytes" field-name))
    (destructuring-bind (key-start value-start value-end before-comma after-value)
        field-span
      (values key-start value-start value-end before-comma after-value))))

(defun %trace-byte-parity-drop-field (octets field-name)
  (multiple-value-bind (key-start value-start value-end before-comma after-value)
      (%trace-byte-parity-field-span octets field-name)
    (declare (ignore value-start))
    (let ((start key-start)
          (end value-end))
      (cond ((and (< after-value (length octets))
                  (= (aref octets after-value) #x2c))
             (setf end (1+ after-value)))
            (before-comma
             (setf start before-comma)))
      (concatenate '(vector (unsigned-byte 8))
                   (subseq octets 0 start)
                   (subseq octets end)))))

(defun %trace-byte-parity-normalize-output (octets trace-p)
  (if (zerop (length octets))
      octets
    (let* ((envelope (json-kit:parse (utf8 octets)
                                     :false-value nil :null-value nil))
           (command (and (hash-table-p envelope)
                         (gethash "command" envelope)))
           (normalized octets))
      (unless (hash-table-p envelope)
        (error "trace byte parity expected a JSON envelope"))
      (unless (stringp command)
        (error "trace byte parity expected a command name"))
      (multiple-value-bind (meta present) (gethash "meta" envelope)
        (if trace-p
            (unless (and present
                         (hash-table-p meta)
                         (= (hash-table-count meta) 1)
                         (nth-value 1 (gethash "trace" meta))
                         (hash-table-p (gethash "trace" meta)))
              (error "trace byte parity expected only an object-valued meta.trace field"))
          (when present
            (error "trace byte parity found metadata without --trace"))))
      (when trace-p
        (setf normalized (%trace-byte-parity-drop-field normalized "meta")))
      (labels ((replace-field-value (source field-name replacement)
                                    (multiple-value-bind (key-start value-start value-end before-comma after-value)
                                        (%trace-byte-parity-field-span source field-name)
                                      (declare (ignore key-start before-comma after-value))
                                      (concatenate '(vector (unsigned-byte 8))
                                                   (subseq source 0 value-start)
                                                   replacement
                                                   (subseq source value-end)))))
        (multiple-value-bind (op-id present) (gethash "op_id" envelope)
          (cond ((string= command "write")
                 (unless (and present (stringp op-id) (plusp (length op-id)))
                   (error "trace byte parity expected a non-empty write op_id"))
                 (setf normalized
                       (replace-field-value normalized "op_id" (octets "\"normalized\""))))
                (present
                 (error "trace byte parity found op_id outside write output"))))
        (multiple-value-bind (duration-ms present) (gethash "duration_ms" envelope)
          (cond ((string= command "run")
                 (unless (and present (integerp duration-ms) (<= 0 duration-ms))
                   (error "trace byte parity expected a non-negative run duration_ms"))
                 (setf normalized
                       (replace-field-value normalized "duration_ms" #(48))))
                (present
                 (error "trace byte parity found duration_ms outside run output"))))
        normalized))))

(defun %trace-byte-parity-same-output-p (plain traced)
  (let ((plain-stdout (result-stdout plain))
        (plain-stderr (result-stderr plain))
        (traced-stdout (result-stdout traced))
        (traced-stderr (result-stderr traced)))
    (when (eq (plusp (length plain-stdout)) (plusp (length plain-stderr)))
      (error "trace byte parity expected one output stream without --trace"))
    (when (eq (plusp (length traced-stdout)) (plusp (length traced-stderr)))
      (error "trace byte parity expected one output stream with --trace"))
    (and (= (result-exit-code plain) (result-exit-code traced))
         (equalp (%trace-byte-parity-normalize-output plain-stdout nil)
                 (%trace-byte-parity-normalize-output traced-stdout t))
         (equalp (%trace-byte-parity-normalize-output plain-stderr nil)
                 (%trace-byte-parity-normalize-output traced-stderr t)))))

(defun %trace-byte-parity-mutate-output-key (result)
  (let* ((mutated (copy-process-result result))
         (stdout-p (plusp (length (result-stdout result))))
         (source (if stdout-p (result-stdout result) (result-stderr result)))
         (octets (copy-seq source))
         (quote (position #x22 octets)))
    (unless (and quote
                 (< (1+ quote) (length octets))
                 (not (member (aref octets (1+ quote)) '(#x22 #x5c) :test #'eql))
                 (< (aref octets (1+ quote)) #x80))
      (error "trace byte parity probe could not find an ASCII JSON key byte"))
    (setf (aref octets (1+ quote))
          (if (= (aref octets (1+ quote)) #x61) #x62 #x61))
    (if stdout-p
        (setf (result-stdout mutated) octets)
      (setf (result-stderr mutated) octets))
    mutated))

