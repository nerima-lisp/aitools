(in-package #:aitools.e2e.test)

(define-row-case (37 "archive extract reports corrupt gzip as input syntax error" :foreign ()) (ws)
  (put ws "broken.gz" (make-array 18 :element-type '(unsigned-byte 8)
                                      :initial-contents '(31 139 8 0 0 0 0 0 0 255 255 255 255 0 0 0 0 0)))
  (let ((before (tree-snapshot ws "out/"))
        (result (aitools ws '("archive" "extract" "broken.gz" "--to" "out"))))
    (expect (aitools-exit-code result) :to-be 1)
    (expect (aitools-envelope result) :to-match-envelope "status" "error" "command" "archive extract")
    (expect (jget (aitools-envelope result) "error" "code") :to-equal "input.syntax-error")
    (expect (tree-snapshot ws "out/") :to-equal before)))

(define-row-case (37 "archive extract enforces the gzip output limit without partial writes" :foreign ("gzip")) (ws)
  (put ws "bomb-source.bin" (make-array 1048576 :element-type '(unsigned-byte 8) :initial-element 0))
  (oracle ws '("gzip") "gzip -c bomb-source.bin > bomb.gz" nil)
  (put ws "out/keep.txt" "unchanged")
  (let ((before (tree-snapshot ws "out/"))
        (result (aitools ws '("archive" "extract" "bomb.gz" "--to" "out" "--max-bytes" "4KiB"))))
    (expect (aitools-exit-code result) :to-be 1)
    (expect (aitools-envelope result) :to-match-envelope "status" "error" "command" "archive extract")
    (expect (jget (aitools-envelope result) "error" "code") :to-equal "refusal.too-large")
    (expect (tree-snapshot ws "out/") :to-equalp before)))
